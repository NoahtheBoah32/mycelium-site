---
// Google Analytics 4 tag. Emits nothing unless PUBLIC_GA_ID is set
// (Vercel project env var, value like G-XXXXXXXXXX), so local dev and
// preview builds stay untracked.
const id = import.meta.env.PUBLIC_GA_ID;
const inline = id
  ? `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${id}');`
  : '';
---
{id && (
  <Fragment>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
    <script is:inline set:html={inline}></script>
  </Fragment>
)}
