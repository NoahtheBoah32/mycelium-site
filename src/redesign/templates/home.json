id=\"bloom-shape\"></path></clippath>\n<mask height=\"1312\" id=\"bloom-remainder\" maskunits=\"userSpaceOnUse\" width=\"1199\" x=\"0\" y=\"0\"><rect fill=\"white\" height=\"1312\" width=\"1199\"></rect><use fill=\"black\" href=\"#bloom-shape\"></use></mask><clippath id=\"botanical-leaf-0\"><path d=\"M510 775 L465 690 L260 680 L248 940 L485 920 Z\"></path></clippath><clippath id=\"botanical-leaf-1\"><path d=\"M514 670 L548 575 L720 530 L960 535 L962 856 L780 852 Z\"></path></clippath><clippath id=\"botanical-leaf-2\"><path d=\"M511 590 L477 496 L288 427 L68 443 L64 672 L322 676 Z\"></path></clippath><clippath id=\"botanical-leaf-3\"><path d=\"M507 460 L441 305 L288 154 L80 151 L72 245 L286 407 Z\"></path></clippath><clippath id=\"botanical-leaf-4\"><path d=\"M522 518 L555 385 L680 198 L966 185 L974 275 L750 453 Z\"></path></clippath><clippath id=\"botanical-leaf-5\"><path d=\"M516 375 L428 292 L410 83 L510 0 L563 66 L590 244 Z\"></path></clippath><clippath id=\"bloom-petal-0\"><path d=\"M565 735L-435.00 -997.05L1565.00 -997.05Z\"></path></clippath><clippath id=\"bloom-petal-1\"><path d=\"M565 735L1565.00 -997.05L2565.00 735.00Z\"></path></clippath><clippath id=\"bloom-petal-2\"><path d=\"M565 735L2565.00 735.00L1565.00 2467.05Z\"></path></clippath><clippath id=\"bloom-petal-3\"><path d=\"M565 735L1565.00 2467.05L-435.00 2467.05Z\"></path></clippath><clippath id=\"bloom-petal-4\"><path d=\"M565 735L-435.00 2467.05L-1435.00 735.00Z\"></path></clippath><clippath id=\"bloom-petal-5\"><path d=\"M565 735L-1435.00 735.00L-435.00 -997.05Z\"></path></clippath></defs>\n<use clip-path=\"url(#botanical-root)\" href=\"#botanical-photo\"></use>\n<g class=\"growing-stem\"><use clip-path=\"url(#botanical-stem)\" href=\"#botanical-photo\"></use></g>\n<g class=\"growing-leaf\" data-leaf=\"0\"><g class=\"leaf-unfurl\"><use clip-path=\"url(#botanical-leaf-0)\" href=\"#botanical-photo\"></use></g></g><g class=\"growing-leaf\" data-leaf=\"1\"><g class=\"leaf-unfurl\"><use clip-path=\"url(#botanical-leaf-1)\" href=\"#botanical-photo\"></use></g></g><g class=\"growing-leaf\" data-leaf=\"2\"><g class=\"leaf-unfurl\"><use clip-path=\"url(#botanical-leaf-2)\" href=\"#botanical-photo\"></use></g></g><g class=\"growing-leaf\" data-leaf=\"3\"><g class=\"leaf-unfurl\"><use clip-path=\"url(#botanical-leaf-3)\" href=\"#botanical-photo\"></use></g></g><g class=\"growing-leaf\" data-leaf=\"4\"><g class=\"leaf-unfurl\"><use clip-path=\"url(#botanical-leaf-4)\" href=\"#botanical-photo\"></use></g></g><g class=\"growing-leaf\" data-leaf=\"5\"><g class=\"leaf-unfurl\"><use clip-path=\"url(#botanical-leaf-5)\" href=\"#botanical-photo\"></use></g></g>\n<g transform=\"translate(368 133) scale(.23)\"><g class=\"growing-flower\" data-flower=\"0\"><use href=\"#plumeria-photo\" mask=\"url(#bloom-remainder)\"></use><g class=\"bloom-petal\" data-petal=\"0\"><g clip-path=\"url(#bloom-petal-0)\"><use clip-path=\"url(#bloom-outline)\" href=\"#plumeria-photo\"></use></g></g><g class=\"bloom-petal\" data-petal=\"1\"><g clip-path=\"url(#bloom-petal-1)\"><use clip-path=\"url(#bloom-outline)\" href=\"#plumeria-photo\"></use></g></g><g class=\"bloom-petal\" data-petal=\"2\"><g clip-path=\"url(#bloom-petal-2)\"><use clip-path=\"url(#bloom-outline)\" href=\"#plumeria-photo\"></use></g></g><g class=\"bloom-petal\" data-petal=\"3\"><g clip-path=\"url(#bloom-petal-3)\"><use clip-path=\"url(#bloom-outline)\" href=\"#plumeria-photo\"></use></g></g><g class=\"bloom-petal\" data-petal=\"4\"><g clip-path=\"url(#bloom-petal-4)\"><use clip-path=\"url(#bloom-outline)\" href=\"#plumeria-photo\"></use></g></g><g class=\"bloom-petal\" data-petal=\"5\"><g clip-path=\"url(#bloom-petal-5)\"><use clip-path=\"url(#bloom-outline)\" href=\"#plumeria-photo\"></use></g></g></g></g>\n</svg></div></div><div aria-hidden=\"true\" class=\"growth-ground\"></div><article class=\"growth-card card-learn\"><span aria-hidden=\"true\" class=\"card-symbol\"><svg aria-hidden=\"true\" fill=\"none\" viewbox=\"0 0 42 42\"><path d=\"M21 39V22m0 8L9 19m12 6L33 14M21 22C5 24 3 8 6 3c9 0 16 7 15 19Zm0 3C20 11 30 3 38 5c1 10-6 19-17 20Z\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"></path></svg></span><h3>Bring your <br/>questions.</h3><p>You don’t need to have it figured out to join in. Ask about something you’re trying to understand.</p></article><article class=\"growth-card card-connect\"><span aria-hidden=\"true\" class=\"card-symbol\"><svg aria-hidden=\"true\" fill=\"none\" viewbox=\"0 0 42 42\"><path d=\"M21 39V22m0 8L9 19m12 6L33 14M21 22C5 24 3 8 6 3c9 0 16 7 15 19Zm0 3C20 11 30 3 38 5c1 10-6 19-17 20Z\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"></path></svg></span><h3>Share what <br/>you discover.</h3><p>An attempt that didn’t go as planned can still be useful to someone facing a similar problem.</p></article><article class=\"growth-card card-practice\"><span aria-hidden=\"true\" class=\"card-symbol\"><svg aria-hidden=\"true\" fill=\"none\" viewbox=\"0 0 42 42\"><path d=\"M21 39V22m0 8L9 19m12 6L33 14M21 22C5 24 3 8 6 3c9 0 16 7 15 19Zm0 3C20 11 30 3 38 5c1 10-6 19-17 20Z\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\"></path></svg></span><h3>Build on each <br/>other’s experience.</h3><p>Sometimes another person’s account helps you see your own experience differently. Reply where you have something to add.</p><a class=\"text-link\" href=\"/common-ground/\"><span>Explore Common Ground</span><svg aria-hidden=\"true\" fill=\"none\" viewbox=\"0 0 24 24\"><path d=\"M4 12h16M13 5l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"1.5\"></path></svg></a></article><div class=\"growth-caption\">A little knowledge changes what can grow.</div></div></section>\n<section class=\"fauna-connections\" id=\"fauna-connections\"><div class=\"fauna-manifesto events-invite\"><div class=\"connections-intro\"><h2 data-fauna-words=\"\">Meet. Learn.<br/>Take part.</h2><p>Community meetups, talks, field workshops and courses with partners like <abbr title=\"Philippine Permaculture Association\">PPA</abbr> and the Baganihan Collective.</p><a class=\"action\" href=\"/events/\"><span>View Events</span><svg aria-hidden=\"true\" fill=\"none\" viewbox=\"0 0 24 24\"><path d=\"M4 12h16M13 5l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"1.5\"></path></svg></a></div>\n<div class=\"event-organics\">\n<a class=\"event-organic event-organic-talks\" data-image-reveal=\"\" href=\"/events/\">\n<img alt=\"Illustrative image: an open-air talk under a bamboo pavilion\" class=\"\" data-lazy-media=\"\" data-src=\"/redesign/delivery/media/event-talks-0a94f94b0658-640.webp\" data-srcset=\"/redesign/delivery/media/event-talks-0a94f94b0658-320.webp 320w, /redesign/delivery/media/event-talks-0a94f94b0658-640.webp 640w, /redesign/delivery/media/event-talks-0a94f94b0658-832.webp 832w\" decoding=\"async\" height=\"1040\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=\" width=\"832\"/><noscript><img alt=\"Illustrative image: an open-air talk under a bamboo pavilion\" class=\"\" decoding=\"async\" height=\"1040\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"/redesign/delivery/media/event-talks-0a94f94b0658-640.webp\" srcset=\"/redesign/delivery/media/event-talks-0a94f94b0658-320.webp 320w, /redesign/delivery/media/event-talks-0a94f94b0658-640.webp 640w, /redesign/delivery/media/event-talks-0a94f94b0658-832.webp 832w\" width=\"832\"/></noscript>\n<span class=\"event-organic-copy\"><small>Talks &amp; conversations</small><strong>Ideas worth<br/>gathering for.</strong><span>Explore events <svg aria-hidden=\"true\" fill=\"none\" viewbox=\"0 0 24 24\"><path d=\"M4 12h16M13 5l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"1.5\"></path></svg></span></span>\n</a>\n<a class=\"event-organic event-organic-courses\" data-image-reveal=\"\" href=\"/courses/\">\n<img alt=\"Illustrative image: a bamboo A-frame level used to mark a contour\" class=\"\" data-lazy-media=\"\" data-src=\"/redesign/delivery/media/event-course-a3aecc0c74a2-640.webp\" data-srcset=\"/redesign/delivery/media/event-course-a3aecc0c74a2-320.webp 320w, /redesign/delivery/media/event-course-a3aecc0c74a2-640.webp 640w, /redesign/delivery/media/event-course-a3aecc0c74a2-832.webp 832w\" decoding=\"async\" height=\"1040\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=\" width=\"832\"/><noscript><img alt=\"Illustrative image: a bamboo A-frame level used to mark a contour\" class=\"\" decoding=\"async\" height=\"1040\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"/redesign/delivery/media/event-course-a3aecc0c74a2-640.webp\" srcset=\"/redesign/delivery/media/event-course-a3aecc0c74a2-320.webp 320w, /redesign/delivery/media/event-course-a3aecc0c74a2-640.webp 640w, /redesign/delivery/media/event-course-a3aecc0c74a2-832.webp 832w\" width=\"832\"/></noscript>\n<span class=\"event-organic-copy\"><small>Courses &amp; field learning</small><strong>Learn it.<br/>Put it into practice.</strong><span>Find a course <svg aria-hidden=\"true\" fill=\"none\" viewbox=\"0 0 24 24\"><path d=\"M4 12h16M13 5l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"1.5\"></path></svg></span></span>\n</a>\n<p class=\"event-photos-note\">Online and on the ground · Illustrative images</p>\n</div></div><div class=\"fauna-split\" id=\"knowledge-takes-root\"><div class=\"fauna-image\"><img alt=\"Fresh garden soil and young leaves beneath a blue sky\" class=\"\" data-lazy-media=\"\" data-src=\"/redesign/delivery/media/garden-soil-supplied-a8625585204e-640.webp\" data-srcset=\"/redesign/delivery/media/garden-soil-supplied-a8625585204e-320.webp 320w, /redesign/delivery/media/garden-soil-supplied-a8625585204e-640.webp 640w, /redesign/delivery/media/garden-soil-supplied-a8625585204e-736.webp 736w\" decoding=\"async\" height=\"981\" loading=\"lazy\" sizes=\"(max-width:900px) 100vw, 65vw\" src=\"data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=\" width=\"736\"/><noscript><img alt=\"Fresh garden soil and young leaves beneath a blue sky\" class=\"\" decoding=\"async\" height=\"981\" loading=\"lazy\" sizes=\"(max-width:900px) 100vw, 65vw\" src=\"/redesign/delivery/media/garden-soil-supplied-a8625585204e-640.webp\" srcset=\"/redesign/delivery/media/garden-soil-supplied-a8625585204e-320.webp 320w, /redesign/delivery/media/garden-soil-supplied-a8625585204e-640.webp 640w, /redesign/delivery/media/garden-soil-supplied-a8625585204e-736.webp 736w\" width=\"736\"/></noscript></div><div class=\"fauna-split-copy\"><h3 data-fauna-words=\"\">Knowledge<br/>takes root.</h3><p>A research paper serves a different purpose from a practitioner’s account. Here’s how we choose what belongs in the library, so you can decide what’s useful in your situation.</p><dl class=\"source-types\"><div><dt>Research</dt><dd>Read alongside the methods and limits of the study.</dd></div><div><dt>Field reports</dt><dd>An account from a particular place. Consider how its conditions compare with yours.</dd></div><div><dt>Essays &amp; guides</dt><dd>Follow the author’s reasoning before taking advice into your own practice.</dd></div></dl><a class=\"text-link\" href=\"/about/#criteria\"><span>See how resources are chosen</span><svg aria-hidden=\"true\" fill=\"none\" viewbox=\"0 0 24 24\"><path d=\"M4 12h16M13 5l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"1.5\"></path></svg></a></div></div></section><section aria-labelledby=\"founder-title\" class=\"founder-story\"><div class=\"founder-copy\"><h2 data-fauna-words=\"\" id=\"founder-title\">Why did I build<br/>Mycelium at 16?</h2><p>I built Mycelium at 16 because I wanted uncomplicated permaculture guidance. I got exhausted finding conflicting advice and resources that didn’t apply to me. So I spent the next year building a platform I couldn’t find. With the guidance I got from the Philippine Permaculture Association and hours of curating content, Mycelium is now what I wish existed when I was searching alone at 2 am with too many tabs to count.</p><a class=\"action\" href=\"/about/\"><span>Read my full journey</span><svg aria-hidden=\"true\" fill=\"none\" viewbox=\"0 0 24 24\"><path d=\"M4 12h16M13 5l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"1.5\"></path></svg></a></div><figure class=\"founder-photo\"><img alt=\"A group photo of Joaquin with members of the permaculture community. A hand-drawn arrow and the words “That’s me!” point to him.\" data-lazy-media=\"\" data-src=\"/redesign/delivery/media/d4ae51d9-homepage-img-09-ce6b39addc81-640.webp\" data-srcset=\"/redesign/delivery/media/d4ae51d9-homepage-img-09-ce6b39addc81-320.webp 320w, /redesign/delivery/media/d4ae51d9-homepage-img-09-ce6b39addc81-640.webp 640w, /redesign/delivery/media/d4ae51d9-homepage-img-09-ce6b39addc81-823.webp 823w\" decoding=\"async\" height=\"714\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=\" width=\"823\"/><noscript><img alt=\"A group photo of Joaquin with members of the permaculture community. A hand-drawn arrow and the words “That’s me!” point to him.\" decoding=\"async\" height=\"714\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"/redesign/delivery/media/d4ae51d9-homepage-img-09-ce6b39addc81-640.webp\" srcset=\"/redesign/delivery/media/d4ae51d9-homepage-img-09-ce6b39addc81-320.webp 320w, /redesign/delivery/media/d4ae51d9-homepage-img-09-ce6b39addc81-640.webp 640w, /redesign/delivery/media/d4ae51d9-homepage-img-09-ce6b39addc81-823.webp 823w\" width=\"823\"/></noscript></figure></section>\n<section aria-labelledby=\"newsletter-title\" class=\"newsletter-notes\" id=\"newsletter\"><div class=\"new