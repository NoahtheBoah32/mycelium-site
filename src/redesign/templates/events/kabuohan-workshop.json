ading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"/redesign/delivery/media/5239bb98-logo-differtniated-be405390b89c-400.webp\" srcset=\"/redesign/delivery/media/5239bb98-logo-differtniated-be405390b89c-320.webp 320w, /redesign/delivery/media/5239bb98-logo-differtniated-be405390b89c-400.webp 400w\" width=\"400\"/><button aria-label=\"Close menu\" class=\"icon-button\" data-close-menu=\"\" type=\"button\"><svg aria-hidden=\"true\" class=\"icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"24\"><path d=\"m6 6 12 12M6 18 18 6\"></path></svg></button></div><div class=\"menu-body\"><div class=\"menu-intro\"><p class=\"display-small\">Knowledge grows.<br/>So do we.</p><p>Free learning. Shared experience.<br/>A more connected way forward.</p><img alt=\"Hands holding living soil\" class=\"\" decoding=\"async\" height=\"1738\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"/redesign/delivery/media/e6089057-a04-hands-4880be9d4b40-640.webp\" srcset=\"/redesign/delivery/media/e6089057-a04-hands-4880be9d4b40-320.webp 320w, /redesign/delivery/media/e6089057-a04-hands-4880be9d4b40-640.webp 640w, /redesign/delivery/media/e6089057-a04-hands-4880be9d4b40-960.webp 960w, /redesign/delivery/media/e6089057-a04-hands-4880be9d4b40-1400.webp 1400w\" width=\"1400\"/></div><div class=\"menu-links\"><a href=\"/videos/\">Videos<svg aria-hidden=\"true\" class=\"icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"24\"><path d=\"M5 19 19 5M5 5h14v14\"></path></svg></a><a href=\"/resources/\">Resources<svg aria-hidden=\"true\" class=\"icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"24\"><path d=\"M5 19 19 5M5 5h14v14\"></path></svg></a><a href=\"/courses/\">Courses<svg aria-hidden=\"true\" class=\"icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"24\"><path d=\"M5 19 19 5M5 5h14v14\"></path></svg></a><a href=\"/common-ground/\">Forum<svg aria-hidden=\"true\" class=\"icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"24\"><path d=\"M5 19 19 5M5 5h14v14\"></path></svg></a><a href=\"/events/\">Events<svg aria-hidden=\"true\" class=\"icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"24\"><path d=\"M5 19 19 5M5 5h14v14\"></path></svg></a><a href=\"/about/\">My story<svg aria-hidden=\"true\" class=\"icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"24\"><path d=\"M5 19 19 5M5 5h14v14\"></path></svg></a><a href=\"/newsletter/\">Newsletter<svg aria-hidden=\"true\" class=\"icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"24\"><path d=\"M5 19 19 5M5 5h14v14\"></path></svg></a><a href=\"/feedback/\">Feedback<svg aria-hidden=\"true\" class=\"icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"24\"><path d=\"M5 19 19 5M5 5h14v14\"></path></svg></a><a href=\"/privacy/\">Privacy<svg aria-hidden=\"true\" class=\"icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"24\"><path d=\"M5 19 19 5M5 5h14v14\"></path></svg></a></div></div></dialog><main id=\"main\"><div class=\"reading-page\"><article class=\"workshop-article\"><div class=\"kw-back-bar\"> <div class=\"kw-inner\"> <a class=\"kw-back\" href=\"/resources/\"> <svg fill=\"none\" height=\"14\" viewbox=\"0 0 16 16\" width=\"14\"><path d=\"M10 4L6 8l4 4\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\"></path></svg>\nResources\n</a> </div> </div><div class=\"kw-hero\"> <img alt=\"A productive community garden\" class=\"kw-hero-img\" decoding=\"async\" height=\"1152\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"/redesign/delivery/media/5882ce02-community-garden-bd27781b08d8-640.webp\" srcset=\"/redesign/delivery/media/5882ce02-community-garden-bd27781b08d8-320.webp 320w, /redesign/delivery/media/5882ce02-community-garden-bd27781b08d8-640.webp 640w, /redesign/delivery/media/5882ce02-community-garden-bd27781b08d8-928.webp 928w\" width=\"928\"/> <div class=\"kw-hero-overlay\"></div> <div class=\"kw-hero-text\"> <span class=\"kw-eyebrow\">Community Event · June 25, 2026</span> <h1 class=\"kw-title\">Kabuohan Workshop</h1> <p class=\"kw-subtitle\">Permaculture Gardening and Primitive Pottery for Homeschool Families</p> </div> </div><section class=\"kw-meta-bar\"> <div class=\"kw-inner kw-meta-row\"> <div class=\"kw-meta-item\"> <span class=\"kw-meta-label\">Hosted by</span> <span class=\"kw-meta-value\">Baganihan Collective</span> </div> <div class=\"kw-meta-divider\"></div> <div class=\"kw-meta-item\"> <span class=\"kw-meta-label\">Venue</span> <span class=\"kw-meta-value\">Rizal Art House</span> </div> <div class=\"kw-meta-divider\"></div> <div class=\"kw-meta-item\"> <span class=\"kw-meta-label\">Facilitator</span> <span class=\"kw-meta-value\">Hubert Posadas</span> </div> <div class=\"kw-meta-divider\"></div> <div class=\"kw-meta-item\"> <span class=\"kw-meta-label\">Format</span> <span class=\"kw-meta-value\">Parent-Child Learning Journey</span> </div> </div> </section><section class=\"kw-body-section\"> <div class=\"kw-inner kw-body-grid\"> <div class=\"kw-writeup\"> <p class=\"kw-lead\">Hubert gathered homeschool families at Rizal Art House last June 25. Not to lecture about permaculture. To live it for a day.</p> <p>It started with a question: \"What living thing did you notice on your way here?\" Parents and children answered equally. Then everyone took off their shoes. They walked the soil, smelled the air, touched leaves and bark. Hubert did not explain anything. Just: \"What do you notice?\" In permaculture, this has a name. Observe and interact. The garden speaks first. You listen before you act.</p> <p>Parent-child teams spread across the grounds with a simple task: find something growing well, something struggling, an insect, a moist area, a dry area, something beautiful, something surprising. They gathered, shared, and asked why. What patterns are you seeing?</p> <p>Then the families designed their own food forests. Sticks, stones, leaves, seeds, cardboard. One rule: design a place where people thrive, plants thrive, insects thrive, and soil thrives. Not one. All of them. That is permaculture design thinking held in a child's hands. Integrate rather than segregate. Every element in relationship with every other.</p> <p>In the afternoon they built a real hugelkultur bed together. Wood layered with organic matter, covered with soil, watered, planted. Hubert asked what they had used. Soil, water, wood, leaves. Then: \"Which of these did humans invent?\" None. Gardening, he said, is collaboration with nature. The wood inside the bed would decompose. The decomposition would feed the soil. The soil would feed the plants. Decomposition is transformation. The bed was already full of hidden communities: fungi, bacteria, insects, earthworms, and roots, all working together unseen.</p> <p>The afternoon moved to clay. Same earth, different form. The children held it, smelled it, squeezed it. Humans did not invent clay. Humans entered into relationship with clay. Families shaped pinch pots, seed bowls, animal figures.</p> <p>The closing circle asked one final question: \"After today, where do you think nature is?\"</p> <p>The children had spent time with the garden and the earth, learned from them, and discovered they were part of a larger living whole. Plants, soil, rain, insects, clay, people, and communities all exist through relationships. When we care for those relationships, life flourishes.</p> </div> <div class=\"kw-pedagogy\"> <h2 class=\"kw-section-label\">The Kabuohan Approach</h2> <ul class=\"kw-principles\"> <li>Experience before explanation</li> <li>Observation before instruction</li> <li>Participation before theory</li> <li>Relationship before information</li> <li>Reflection before conclusion</li> </ul> <h2 class=\"kw-section-label kw-section-label--gap\">Permaculture Principles at Work</h2> <ul class=\"kw-principles\"> <li>Observe and interact</li> <li>Integrate rather than segregate</li> <li>Use and value diversity</li> <li>Care for the earth, care for people</li> </ul> <p class=\"kw-kaginhawaan\"><em>Kaginhawaan.</em> Ease. Well-being. Right relationship with the living world. The workshop did not explain it. It let you feel it.</p> </div> </div> </section><section class=\"kw-gallery-section\"> <div class=\"kw-inner\"> <h2 class=\"kw-gallery-heading\">From the Garden</h2> <div class=\"kw-gallery\"> <div class=\"kw-photo\"> <img alt=\"Hands sharing a meal around a table\" decoding=\"async\" height=\"1738\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"/redesign/delivery/media/fba47ed8-a09-table-3d6dd53e437e-640.webp\" srcset=\"/redesign/delivery/media/fba47ed8-a09-table-3d6dd53e437e-320.webp 320w, /redesign/delivery/media/fba47ed8-a09-table-3d6dd53e437e-640.webp 640w, /redesign/delivery/media/fba47ed8-a09-table-3d6dd53e437e-960.webp 960w, /redesign/delivery/media/fba47ed8-a09-table-3d6dd53e437e-1400.webp 1400w\" width=\"1400\"/> </div><div class=\"kw-photo\"> <img alt=\"Growing plots and a greenhouse\" decoding=\"async\" height=\"1701\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"/redesign/delivery/media/c8bf32ca-newsletter-bg-scaled-e0b80848b437-640.webp\" srcset=\"/redesign/delivery/media/c8bf32ca-newsletter-bg-scaled-e0b80848b437-320.webp 320w, /redesign/delivery/media/c8bf32ca-newsletter-bg-scaled-e0b80848b437-640.webp 640w, /redesign/delivery/media/c8bf32ca-newsletter-bg-scaled-e0b80848b437-960.webp 960w, /redesign/delivery/media/c8bf32ca-newsletter-bg-scaled-e0b80848b437-1440.webp 1440w, /redesign/delivery/media/c8bf32ca-newsletter-bg-scaled-e0b80848b437-1920.webp 1920w\" width=\"2560\"/> </div><div class=\"kw-photo\"> <img alt=\"Water held in the contours of a planted landscape\" decoding=\"async\" height=\"1738\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"/redesign/delivery/media/ae7acf20-a13-swale-4617512ddac0-640.webp\" srcset=\"/redesign/delivery/media/ae7acf20-a13-swale-4617512ddac0-320.webp 320w, /redesign/delivery/media/ae7acf20-a13-swale-4617512ddac0-640.webp 640w, /redesign/delivery/media/ae7acf20-a13-swale-4617512ddac0-960.webp 960w, /redesign/delivery/media/ae7acf20-a13-swale-4617512ddac0-1400.webp 1400w\" width=\"1400\"/> </div><div class=\"kw-photo\"> <img alt=\"Diverse crops growing side by side\" decoding=\"async\" height=\"1152\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"/redesign/delivery/media/d235eb94-diverse-crops-4a6741d81785-640.webp\" srcset=\"/redesign/delivery/media/d235eb94-diverse-crops-4a6741d81785-320.webp 320w, /redesign/delivery/media/d235eb94-diverse-crops-4a6741d81785-640.webp 640w, /redesign/delivery/media/d235eb94-diverse-crops-4a6741d81785-928.webp 928w\" width=\"928\"/> </div><div class=\"kw-photo\"> <img alt=\"Hands sharing a meal around a table\" decoding=\"async\" height=\"1738\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"/redesign/delivery/media/fba47ed8-a09-table-3d6dd53e437e-640.webp\" srcset=\"/redesign/delivery/media/fba47ed8-a09-table-3d6dd53e437e-320.webp 320w, /redesign/delivery/media/fba47ed8-a09-table-3d6dd53e437e-640.webp 640w, /redesign/delivery/media/fba47ed8-a09-table-3d6dd53e437e-960.webp 960w, /redesign/delivery/media/fba47ed8-a09-table-3d6dd53e437e-1400.webp 1400w\" width=\"1400\"/> </div><div class=\"kw-photo\"> <img alt=\"A productive community garden\" decoding=\"async\" height=\"1152\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"/redesign/delivery/media/5882ce02-community-garden-bd27781b08d8-640.webp\" srcset=\"/redesign/delivery/media/5882ce02-community-garden-bd27781b08d8-320.webp 320w, /redesign/delivery/media/5882ce02-community-garden-bd27781b08d8-640.webp 640w, /redesign/delivery/media/5882ce02-community-garden-bd27781b08d8-928.webp 928w\" width=\"928\"/> </div> </div> </div> </section><section class=\"kw-video-section\"> <div class=\"kw-inner\"> <h2 class=\"kw-gallery-heading\">In Motion</h2> <div class=\"kw-video-wrap\"> <video class=\"kw-video\" controls=\"\" playsinline=\"\" poster=\"/redesign/delivery/media/fba47ed8-a09-table-3d6dd53e437e-960.webp\" preload=\"none\"> <source src=\"https://mycelium-learn.com/images/events/kabuohan/kabuohan-event.mp4\" type=\"video/mp4\"/> </video> </div> </div> </section><section class=\"kw-quote-section\"> <div class=\"kw-inner\"> <blockquote class=\"kw-quote\">\n\"We are not separate from the living world. We are participants in it. The same Earth that grows food also becomes clay, forests, homes, and eventually us. To care for the Earth is to care for ourselves and one another.\"\n</blockquote> <p class=\"kw-quote-credit\">Closing reflection, Kabuohan Workshop · June 25, 2026</p> </div> </section><section class=\"kw-credit-section\"> <div class=\"kw-inner\"> <p class=\"kw-credit-text\">Workshop by <strong>Baganihan Collective</strong> · Held at <strong>Rizal Art House</strong> · Photos by Ro.S.E.</p> </div> </section></article></div></main><footer class=\"footer\"><div class=\"footer-intro\"><p class=\"display-small\">Good things grow<br/>when we connect.</p><p>Connecting scattered permaculture knowledge into clear learning pathways. Free, verified, and built for beginners ready to grow.</p></div><div class=\"footer-links\"><div><h3>Learn</h3><a href=\"/videos/\">Videos</a><a href=\"/resources/\">Resources</a><a href=\"/courses/\">Courses</a><a href=\"/events/\">Events</a></div><div><h3>Connect</h3><a href=\"/common-ground/\">Forum</a><a href=\"/about/\">My story</a><a href=\"/newsletter/\">Newsletter</a><a href=\"/feedback/\">Send a message</a></div><div><h3>Elsewhere</h3><a href=\"https://www.instagram.com/mycelium.learn/\" rel=\"noopener\" target=\"_blank\">Instagram <svg aria-hidden=\"true\" class=\"icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"24\"><path d=\"M5 19 19 5M5 5h14v14\"></path></svg></a><a href=\"https://www.youtube.com/@JoaquinRiego\" rel=\"noopener\" target=\"_blank\">YouTube <svg aria-hidden=\"true\" class=\"icon\" fill=\"none\" height=\"24\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" viewbox=\"0 0 24 24\" width=\"24\"><path d=\"M5 19 19 5M5 5h14v14\"></path></svg></a><button class=\"plain-button\" data-d=\"moc.liamg\" data-email=\"\" data-u=\"gninraelmuilecym\" type=\"button\">Show email address</button><a href=\"/privacy/\">Privacy policy</a></div></div><div class=\"footer-signature\"><img alt=\"Mycelium\" class=\"\" decoding=\"async\" height=\"88\" loading=\"lazy\" sizes=\"(max-width: 700px) 90vw, (max-width: 1100px) 50vw, 35vw\" src=\"/redesign/delivery/media/5239bb98-logo-differtniated-be405390b89c-400.webp\" srcset=\"/redesign/delivery/media/5239bb98-logo-di