  "head": "<meta charset=\"utf-8\"/><meta content=\"width=device-width,initial-scale=1\" name=\"viewport\"/><meta content=\"Free, verified permaculture learning and a community to grow alongside.\" name=\"description\"/><meta content=\"#2f4f2f\" name=\"theme-color\"/><title>Feedback — Mycelium</title><link href=\"/redesign/assets/d6b5b92b-logo.png\" rel=\"icon\"/><link href=\"/redesign/delivery/code/css-0822484ff861d6.css\" rel=\"stylesheet\"/><script defer=\"\" src=\"/redesign/delivery/code/js-88f7fc19da055e.js\"></script><link href=\"https://mycelium-learn.com/feedback/\" rel=\"canonical\"/><link href=\"/images/wp/mycelium-favicon.svg\" rel=\"icon\"/>",
