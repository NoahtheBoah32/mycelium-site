---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import videos from '../../public/data/videos.json';

const featuredVideos = videos.slice(0, 3);
---

<BaseLayout title="Home - Mycelium">
  <SiteNav />

  <section class="hero">
    <div class="hero-inner">
      <h1 class="hero-heading">What if it&rsquo;s time we look down<br>to move forward?</h1>
      <div class="hero-images">
        <img src="https://mycelium-learn.com/wp-content/uploads/2026/02/homepage-img-01.webp" alt="" class="hi" loading="eager" />
        <img src="https://mycelium-learn.com/wp-content/uploads/2026/02/homepage-img-02.webp" alt="" class="hi" loading="eager" />
        <img src="https://mycelium-learn.com/wp-content/uploads/2026/02/homepage-img-03-2.png" alt="" class="hi" loading="eager" />
      </div>
      <a href="#start-your-journey" class="btn-primary">Start Your Journey</a>
    </div>
  </section>

  <section class="mission" id="start-your-journey">
    <div class="section-inner mission-inner">
      <span class="eyebrow-label">Our Mission</span>
      <h2 class="section-heading dark">Building food security starts with education</h2>
      <p class="mission-body">Our goals start with confronting the issue of finding clear and uncomplicated permaculture education. Mycelium strengthens permaculture education at its roots, encouraging informed action to support the overarching goal of addressing food insecurity.</p>
    </div>
  </section>

  <section class="stats">
    <div class="section-inner">
      <span class="eyebrow-label light">Mycelium Resources and Content to Date</span>
      <div class="stats-row">
        <div class="stat-item"><span class="stat-number">240</span><span class="stat-label">Resources Curated</span></div>
        <div class="stat-item"><span class="stat-number">600+</span><span class="stat-label">Hours of Organized Content</span></div>
        <div class="stat-item"><span class="stat-number">1</span><span class="stat-label">Community in Active Implementation</span></div>
      </div>
    </div>
  </section>

  <section class="founder">
    <div class="section-inner founder-inner">
      <div class="founder-img">
        <img src="https://mycelium-learn.com/wp-content/uploads/2026/03/homepage-img-09.webp" alt="Founder" loading="lazy" />
      </div>
      <div class="founder-text">
        <h2 class="section-heading light">Why did I build Mycelium at 16?</h2>
        <p class="founder-body">I built Mycelium at 16 because I wanted uncomplicated permaculture guidance. Mycelium is now what I wish existed when I was searching alone at 2 am with too many tabs to count.</p>
        <a href="/about" class="btn-underline">READ MY FULL JOURNEY</a>
      </div>
    </div>
  </section>

  <section class="how-operate">
    <div class="section-inner">
      <div class="operate-header">
        <h2 class="section-heading light center">How We Operate</h2>
        <p class="operate-sub">We prioritize transparency with all our users, we want you to know how we create resources and build this platform.</p>
      </div>
      <div class="operate-grid">
        <div class="operate-col">
          <div class="operate-icon"><img src="https://mycelium-learn.com/wp-content/uploads/2026/02/homepage-img-05.png" alt="" loading="lazy" /></div>
          <h3 class="operate-title">Zero Gatekeeping</h3>
          <p class="operate-body">100% Free, forever. No paywalls, no ads interrupting your learning. We believe permaculture knowledge should be accessible to everyone, regardless of income or location.</p>
          <a href="/about" class="btn-underline">OUR MISSION</a>
        </div>
        <div class="operate-col">
          <div class="operate-icon"><img src="https://mycelium-learn.com/wp-content/uploads/2026/02/homepage-img-06.png" alt="" loading="lazy" /></div>
          <h3 class="operate-title">We verify every resource</h3>
          <p class="operate-body">We personally review every video, course, and article before adding it to Mycelium. Each resource is checked thoroughly, prioritizing beginner-friendliness.</p>
          <a href="/about" class="btn-underline">SEE OUR CRITERIA</a>
        </div>
        <div class="operate-col">
          <div class="operate-icon"><img src="https://mycelium-learn.com/wp-content/uploads/2026/03/homepage-img-10.webp" alt="" loading="lazy" /></div>
          <h3 class="operate-title">We work with expert partners</h3>
          <p class="operate-body">Our resources are credible and field-tested — built in partnership with the Baganihan Collective and shaped by contributions from the Philippine Permaculture Association (PPA).</p>
          <a href="/about" class="btn-underline">LEARN MORE</a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-videos">
    <div class="section-inner">
      <span class="eyebrow-label">Videos</span>
      <h2 class="section-heading dark">Curated Permaculture Videos</h2>
      <p class="section-sub dark">Visual learning paths from beginner introductions to advanced techniques</p>
      <div class="home-video-grid">
        {featuredVideos.map(v => {
          const ytMatch = v.embedUrl?.match(/[?&]v=([^&]+)/);
          const ytId = v.youtubeId || (ytMatch ? ytMatch[1] : null);
          const thumb = v.thumbnail || (ytId ? `https://img.youtube.com/vi/${ytId}/mqdefault.jpg` : null);
          return (
            <div class="hvc">
              <div class="hvc-thumb"><img src={thumb || v.thumbnail} alt={v.title} loading="lazy" /></div>
              <div class="hvc-body">
                <p class="hvc-author">{v.author}</p>
                <h3 class="hvc-title">{v.title}</h3>
                <div class="hvc-actions">
                  {v.embedUrl && <a href={v.embedUrl} target="_blank" rel="noopener" class="btn-sm-outline">Watch Now</a>}
                  <a href={`/video/${v.slug}`} class="btn-sm-solid">Learn More</a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <div class="section-cta"><a href="/videos" class="btn-primary">View All Videos</a></div>
    </div>
  </section>

  <section class="home-courses">
    <div class="section-inner">
      <span class="eyebrow-label">Courses</span>
      <h2 class="section-heading dark">Learning Pathways &amp; Courses</h2>
      <p class="section-sub dark">From free introductions to full PDC certifications</p>
      <div class="home-courses-grid">
        <a href="https://permaculturevisions.com/permaculture-design-course/" target="_blank" rel="noopener" class="hcc">
          <div class="hcc-thumb"><img src="https://mycelium-learn.com/wp-content/uploads/2026/01/Permaculture-Vision-Design-Course.jpg" alt="Permaculture Vision Design Course" loading="lazy" /></div>
          <div class="hcc-body">
            <h3 class="hcc-title">Permaculture Vision Design Course</h3>
            <p class="hcc-meta">All Countries &middot; All Types</p>
          </div>
        </a>
        <a href="https://pangaiapermaculture.com/course/live-permaculture-design-certificate-pdc/" target="_blank" rel="noopener" class="hcc">
          <div class="hcc-thumb"><img src="https://mycelium-learn.com/wp-content/uploads/2026/01/Pan-Gaia-Permaculture-Online-Permaculture-Design-Course-1.png" alt="Pan Gaia Permaculture Online PDC" loading="lazy" /></div>
          <div class="hcc-body">
            <h3 class="hcc-title">Pan Gaia Permaculture Online PDC</h3>
            <p class="hcc-meta">All Countries &middot; All Types</p>
          </div>
        </a>
        <a href="https://crystalwaters.org.au/permaculture-design-course/" target="_blank" rel="noopener" class="hcc">
          <div class="hcc-thumb"><img src="https://mycelium-learn.com/wp-content/uploads/2026/01/Crystal-Waters-Permaculture-Design-Course.png" alt="Crystal Waters Permaculture Design Course" loading="lazy" /></div>
          <div class="hcc-body">
            <h3 class="hcc-title">Crystal Waters Permaculture Design Course</h3>
            <p class="hcc-meta">All Countries &middot; All Types</p>
          </div>
        </a>
      </div>
      <div class="section-cta"><a href="/courses" class="btn-primary">View All Courses</a></div>
    </div>
  </section>

  <section class="home-resources">
    <div class="section-inner">
      <span class="eyebrow-label">Blog</span>
      <h2 class="section-heading dark">Organized Blog Resources</h2>
      <p class="section-sub dark">Quality permaculture content organized by topic</p>
      <div class="home-resources-grid">
        <a href="https://mycelium-learn.com/resources/growing-resilience/" target="_blank" rel="noopener" class="hrc">
          <div class="hrc-thumb"><img src="https://mycelium-learn.com/wp-content/uploads/2025/11/RESIZED-PERMACULTURE-FOR-BEGGINERS.png" alt="What is Permaculture?" loading="lazy" /></div>
          <div class="hrc-body">
            <span class="hrc-cat">Getting Started</span>
            <h3 class="hrc-title">What is Permaculture? — Article</h3>
            <p class="hrc-desc">Permaculture is not just organic gardening. It is a design system that applies to backyards, communities, and entire ways of living.</p>
          </div>
        </a>
        <a href="https://mycelium-learn.com/resources/the-eco-blueprint/" target="_blank" rel="noopener" class="hrc">
          <div class="hrc-thumb"><img src="https://mycelium-learn.com/wp-content/uploads/2025/11/HOW-TO-START-A-PERMACULTURE-GARDEN.png" alt="First Steps" loading="lazy" /></div>
          <div class="hrc-body">
            <span class="hrc-cat">Beginner</span>
            <h3 class="hrc-title">First Steps — Article</h3>
            <p class="hrc-desc">How to read your space, what to prioritize first, and what you can realistically start in a week.</p>
          </div>
        </a>
        <a href="https://mycelium-learn.com/resources/designing-with-nature/" target="_blank" rel="noopener" class="hrc">
          <div class="hrc-thumb"><img src="https://mycelium-learn.com/wp-content/uploads/2025/11/DESIGN-PRINCIPLES.png" alt="Design Principles" loading="lazy" /></div>
          <div class="hrc-body">
            <span class="hrc-cat">Beginner</span>
            <h3 class="hrc-title">Design Principles — Article</h3>
            <p class="hrc-desc">The thinking tools behind every permaculture decision.</p>
          </div>
        </a>
        <a href="https://mycelium-learn.com/resources/sustainable-abundance/" target="_blank" rel="noopener" class="hrc">
          <div class="hrc-thumb"><img src="https://mycelium-learn.com/wp-content/uploads/2025/11/HOW-TO-CREATE-A-FOOD-FOREST.png" alt="Food Forest" loading="lazy" /></div>
          <div class="hrc-body">
            <span class="hrc-cat">Beginner</span>
            <h3 class="hrc-title">Designing a Food Forest</h3>
            <p class="hrc-desc">A food forest is a layered ecosystem that produces food and largely takes care of itself.</p>
          </div>
        </a>
      </div>
      <div class="section-cta"><a href="/resources" class="btn-primary">View All Resources</a></div>
    </div>
  </section>

  <section class="newsletter-section">
    <div class="section-inner newsletter-inner">
      <h2 class="section-heading dark">Get Monthly Permaculture Resources</h2>
      <p class="newsletter-sub">Curated resources, seasonal tips, and permaculture news delivered to your inbox. No spam, unsubscribe anytime.</p>
      <form class="newsletter-form" action="https://mycelium-learn.com/newsletter/" method="get">
        <input type="email" placeholder="Your email address" class="newsletter-input" />
        <button type="submit" class="btn-primary small">Subscribe</button>
      </form>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.section-inner { max-width: var(--max-width); margin: 0 auto; padding: 0 40px; }
.eyebrow-label { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-primary); margin-bottom: 12px; display: block; }
.eyebrow-label.light { color: #7A8B55; text-align: center; }
.section-heading { font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.8rem, 3vw, 2.5rem); line-height: 1.2; letter-spacing: -0.02em; margin-bottom: 16px; }
.section-heading.dark { color: #242424; }
.section-heading.light { color: #D2CEC8; }
.section-heading.center { text-align: center; margin-bottom: 56px; }
.section-sub { font-family: var(--font-outfit); font-size: 1rem; line-height: 1.6; margin-bottom: 40px; }
.section-sub.dark { color: #666; }
.section-cta { text-align: center; margin-top: 40px; }
.btn-primary { display: inline-flex; align-items: center; background: var(--color-brown); color: #fff; font-family: var(--font-inter); font-size: 1rem; font-weight: 500; padding: 12px 28px; border-radius: 50px; transition: background 0.2s; cursor: pointer; border: none; text-decoration: none; }
.btn-primary:hover { background: var(--color-brown-hover); }
.btn-primary.small { padding: 10px 24px; font-size: 0.875rem; }
.btn-underline { display: inline-block; font-family: var(--font-inter); font-size: 0.875rem; font-weight: 700; color: #D2CEC8; border-bottom: 3px solid #FFD53B; padding: 4px 0; letter-spacing: 0.05em; transition: color 0.2s; text-decoration: none; }
.btn-underline:hover { color: #61CE70; }
.btn-sm-outline { font-family: var(--font-inter); font-size: 0.8rem; font-weight: 500; color: #242424; border: 1px solid #ccc; padding: 7px 16px; border-radius: 50px; transition: border-color 0.2s, color 0.2s; text-decoration: none; display: inline-block; }
.btn-sm-outline:hover { border-color: var(--color-primary); color: var(--color-primary); }
.btn-sm-solid { font-family: var(--font-inter); font-size: 0.8rem; font-weight: 500; background: var(--color-brown); color: #fff; padding: 7px 16px; border-radius: 50px; transition: background 0.2s; text-decoration: none; display: inline-block; }
.btn-sm-solid:hover { background: var(--color-brown-hover); }
.hero { background: #fff; padding: 100px 40px 80px; }
.hero-inner { max-width: var(--max-width); margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 48px; }
.hero-heading { font-family: var(--font-serif); font-size: clamp(2rem, 5vw, 4.5rem); font-weight: 400; line-height: 1.05; letter-spacing: -0.02em; color: #2B2B2B; text-align: center; }
.hero-images { display: flex; gap: 20px; width: 100%; max-width: 900px; justify-content: center; }
.hi { border-radius: 12px; object-fit: cover; flex: 1; height: 260px; min-width: 0; }
.mission { background: #fff; padding: 96px 40px; }
.mission-inner { text-align: center; }
.mission-body { font-family: var(--font-outfit); font-size: 1.1rem; color: #555; line-height: 1.7; max-width: 700px; margin: 0 auto; }
.stats { background: #2B2F31; padding: 96px 40px; }
.stats .eyebrow-label { margin-bottom: 40px; }
.stats-row { display: flex; gap: 40px; justify-content: center; flex-wrap: wrap; }
.stat-item { display: flex; flex-direction: column; align-items: center; gap: 8px; min-width: 180px; }
.stat-number { font-family: var(--font-lora); font-size: clamp(2.5rem, 5vw, 3.75rem); font-weight: 500; color: #fff; line-height: 1; letter-spacing: -0.02em; }
.stat-label { font-family: var(--font-outfit); font-size: 1rem; color: #D2CEC8; text-align: center; max-width: 160px; line-height: 1.4; }
.founder { background: #2F2A1F; padding: 120px 40px; }
.founder-inner { display: flex; align-items: center; gap: 60px; }
.founder-img { flex-shrink: 0; width: 440px; }
.founder-img img { width: 100%; border-radius: 12px; }
.founder-text { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
.founder-body { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 700; color: #D2CEC8; line-height: 1.6; }
.how-operate { background: #43330B; padding: 96px 40px; }
.operate-header { text-align: center; margin-bottom: 64px; }
.operate-sub { font-family: var(--font-outfit); font-size: 1rem; color: #D2CEC8; opacity: 0.75; line-height: 1.6; max-width: 560px; margin: 0 auto; }
.operate-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; }
.operate-col { display: flex; flex-direction: column; gap: 16px; }
.operate-icon { height: 120px; display: flex; align-items: center; justify-content: flex-start; }
.operate-icon img { max-height: 110px; max-width: 100%; object-fit: contain; }
.operate-title { font-family: var(--font-lora); font-size: 1.15rem; font-weight: 600; color: #D2CEC8; line-height: 1.3; }
.operate-body { font-family: var(--font-outfit); font-size: 0.95rem; color: #D2CEC8; line-height: 1.65; opacity: 0.8; flex: 1; }
.home-videos, .home-courses { background: #fff; padding: 80px 40px; }
.home-courses { border-top: 1px solid #f0f0f0; }
.home-video-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
.home-courses-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
.hvc, .hcc { border: 1px solid #e8e8e8; border-radius: 12px; overflow: hidden; background: #fff; transition: box-shadow 0.2s; text-decoration: none; color: inherit; display: flex; flex-direction: column; }
.hvc:hover, .hcc:hover { box-shadow: 0 4px 24px rgba(0,0,0,0.08); transform: translateY(-2px); }
.hcc-thumb { aspect-ratio: 16/9; overflow: hidden; background: #f0f0f0; flex-shrink: 0; }
.hcc-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
.hcc:hover .hcc-thumb img { transform: scale(1.04); }
.hcc-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 5px; }
.hvc-thumb { aspect-ratio: 16/9; overflow: hidden; background: #f0f0f0; }
.hvc-thumb img { width: 100%; height: 100%; object-fit: cover; }
.hvc-body { padding: 20px; display: flex; flex-direction: column; gap: 8px; }
.hvc-author { font-family: var(--font-inter); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #2F4F2F; }
.hvc-title, .hcc-title { font-family: var(--font-lora); font-size: 1rem; font-weight: 600; color: #242424; line-height: 1.4; }
.hvc-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.hvc-actions, .hcc-actions { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
.hcc-meta { font-family: var(--font-inter); font-size: 0.8rem; color: #888; }
.home-resources { background: #F7F7F5; padding: 80px 40px; }
.home-resources-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 24px; }
.hrc { border: 1px solid #e8e8e8; border-radius: 12px; overflow: hidden; background: #fff; display: flex; flex-direction: column; text-decoration: none; color: inherit; transition: box-shadow 0.2s, transform 0.15s; }
.hrc:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); transform: translateY(-2px); }
.hrc-thumb { aspect-ratio: 4/3; overflow: hidden; background: #f0f0f0; flex-shrink: 0; }
.hrc-thumb img { width: 100%; height: 100%; object-fit: cover; }
.hrc-body { padding: 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
.hrc-cat { font-family: var(--font-inter); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #2F4F2F; }
.hrc-title { font-family: var(--font-inter); font-size: 0.88rem; font-weight: 700; color: #242424; line-height: 1.35; }
.hrc-desc { font-family: var(--font-inter); font-size: 0.78rem; color: #666; line-height: 1.55; }
.newsletter-section { background: #fff; padding: 80px 40px; border-top: 1px solid #f0f0f0; }
.newsletter-inner { text-align: center; max-width: 600px; margin: 0 auto; }
.newsletter-sub { font-family: var(--font-outfit); font-size: 1rem; color: #666; line-height: 1.6; margin-bottom: 32px; }
.newsletter-form { display: flex; gap: 12px; justify-content: center; }
.newsletter-input { flex: 1; max-width: 320px; padding: 12px 20px; border: 1px solid #ccc; border-radius: 50px; font-family: var(--font-inter); font-size: 0.875rem; outline: none; }
@media (max-width: 1024px) {
  .hi { height: 200px; } .founder-img { width: 320px; } .operate-grid { grid-template-columns: repeat(2,1fr); }
  .home-video-grid, .home-courses-grid { grid-template-columns: repeat(2,1fr); }
}
@media (max-width: 768px) {
  .hero { padding: 100px 20px 60px; }
  .hero-images { flex-direction: column; }
  .hi { height: 220px; width: 100%; flex: none; }
  .section-inner { padding: 0 20px; }
  .mission, .stats, .founder, .how-operate, .home-videos, .home-courses, .home-resources, .newsletter-section { padding-left: 20px; padding-right: 20px; }
  .founder-inner { flex-direction: column; } .founder-img { width: 100%; }
  .operate-grid { grid-template-columns: 1fr; gap: 40px; }
  .home-video-grid, .home-courses-grid, .home-resources-grid { grid-template-columns: 1fr; }
  .newsletter-form { flex-direction: column; align-items: center; }
  .newsletter-input { max-width: 100%; width: 100%; }
}
</style>
