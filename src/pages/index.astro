---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import videos from '../../public/data/videos.json';
import hp from '../content/data/homepage.json';

const featuredVideos = videos.slice(0, 3);
---

<BaseLayout title="Home - Mycelium">
  <SiteNav overlay={true} />

  <section class="hero">
    <div class="hero-inner">
      <h1 class="hero-heading">{hp.hero.heading}</h1>
      <div class="hero-images">
        {hp.hero.images.map((src: string, i: number) => (
          <img src={src} alt="" class="hi" loading={i === 0 ? 'eager' : 'lazy'} />
        ))}
      </div>
      <a href="#start-your-journey" class="btn-primary">Start Your Journey</a>
    </div>
  </section>

  <section class="mission" id="start-your-journey">
    <div class="section-inner mission-inner">
      <h2 class="section-heading mission-heading">{hp.mission.heading}</h2>
      <p class="mission-body">{hp.mission.body}</p>
    </div>
  </section>

  <section class="stats">
    <div class="section-inner">
      <span class="eyebrow-label light">{hp.stats.eyebrow}</span>
      <div class="stats-row">
        {hp.stats.items.map(s => (
          <div class="stat-item"><span class="stat-number">{s.number}</span><span class="stat-label">{s.label}</span></div>
        ))}
      </div>
    </div>
  </section>

  <section class="founder">
    <div class="section-inner founder-inner">
      <div class="founder-img">
        <img src={hp.founder.image} alt="Founder" loading="lazy" />
      </div>
      <div class="founder-text">
        <h2 class="section-heading light">{hp.founder.heading}</h2>
        <p class="founder-body">{hp.founder.body}</p>
        <a href="/about" class="btn-underline">READ MY FULL JOURNEY</a>
      </div>
    </div>
  </section>

  <section class="how-operate">
    <div class="section-inner">
      <div class="operate-header">
        <h2 class="section-heading light center">{hp.howOperate.heading}</h2>
        <p class="operate-sub">{hp.howOperate.sub}</p>
      </div>
      <div class="operate-grid">
        <div class="operate-col">
          <div class="operate-icon"><img src={hp.howOperate.columns[0].icon} alt="" loading="lazy" /></div>
          <h3 class="operate-title">{hp.howOperate.columns[0].title}</h3>
          <p class="operate-body">{hp.howOperate.columns[0].body}</p>
          <a href="/about" class="btn-underline">OUR MISSION</a>
        </div>
        <div class="operate-col">
          <div class="operate-icon"><img src={hp.howOperate.columns[1].icon} alt="" loading="lazy" /></div>
          <h3 class="operate-title">{hp.howOperate.columns[1].title}</h3>
          <p class="operate-body">{hp.howOperate.columns[1].body}</p>
          <a href="/about" class="btn-underline">SEE OUR CRITERIA</a>
        </div>
        <div class="operate-col">
          <div class="operate-icon">
            <div class="partners-row">
              <img src={hp.howOperate.columns[2].partnersImage} alt="Baganihan Collective and Philippine Permaculture Association" class="partners-existing" loading="lazy" />
              <span class="partner-plus">+</span>
              <img src={hp.howOperate.columns[2].sanghiblayanImage} alt="Sanghiblayan Collective" class="partner-sanghiblayan-logo" loading="lazy" />
            </div>
          </div>
          <h3 class="operate-title">{hp.howOperate.columns[2].title}</h3>
          <p class="operate-body">{hp.howOperate.columns[2].body}</p>
          <a href="/about" class="btn-underline">LEARN MORE</a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-videos">
    <div class="section-inner">
      <h2 class="section-heading dark">{hp.videos.heading}</h2>
      <p class="section-sub dark">{hp.videos.sub}</p>
      <div class="home-video-grid">
        {featuredVideos.map(v => {
          const ytMatch = v.embedUrl?.match(/[?&]v=([^&]+)/);
          const ytId = v.youtubeId || (ytMatch ? ytMatch[1] : null);
          const thumb = v.thumbnail || (ytId ? `https://img.youtube.com/vi/${ytId}/mqdefault.jpg` : null);
          return (
            <div class="hvc">
              <a href={`/video/${v.slug}`} class="hvc-thumb">
                <img src={thumb || v.thumbnail} alt={v.title} loading="lazy" />
                <div class="hvc-play-overlay"><svg width="44" height="44" viewBox="0 0 44 44" fill="none"><circle cx="22" cy="22" r="22" fill="rgba(0,0,0,0.58)"/><polygon points="17,13 35,22 17,31" fill="white"/></svg></div>
              </a>
              <div class="hvc-body">
                <p class="hvc-author">{v.author}</p>
                <h3 class="hvc-title">{v.title}</h3>
                <div class="hvc-actions">
                  <a href={`/video/${v.slug}`} class="hvc-btn hvc-btn-solid">Learn More</a>
                  {v.embedUrl && <a href={v.embedUrl} target="_blank" rel="noopener" class="hvc-btn hvc-btn-outline">Watch Now</a>}
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <div class="section-cta"><a href="/videos" class="btn-primary">View All Videos</a></div>
    </div>
  </section>

  <section class="home-courses">
    <div class="section-inner">
      <h2 class="section-heading dark">{hp.courses.heading}</h2>
      <p class="section-sub dark">{hp.courses.sub}</p>
      <div class="home-courses-grid">
        {hp.courses.items.map((c: {title: string, meta: string, url: string, image: string}) => (
          <a href={c.url} target="_blank" rel="noopener" class="hcc">
            <div class="hcc-thumb"><img src={c.image} alt={c.title} loading="lazy" /></div>
            <div class="hcc-body">
              <h3 class="hcc-title">{c.title}</h3>
              <p class="hcc-meta">{c.meta}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="section-cta"><a href="/courses" class="btn-primary">View All Courses</a></div>
    </div>
  </section>

  <section class="home-resources">
    <div class="section-inner">
      <h2 class="section-heading dark">{hp.resources.heading}</h2>
      <p class="section-sub dark">{hp.resources.sub}</p>
      <div class="home-resources-grid">
        {hp.resources.items.map((r: {title: string, category: string, description: string, url: string, image: string}) => (
          <a href={r.url} target="_blank" rel="noopener" class="hrc">
            <div class="hrc-thumb"><img src={r.image} alt={r.title} loading="lazy" /></div>
            <div class="hrc-body">
              <span class="hrc-cat">{r.category}</span>
              <h3 class="hrc-title">{r.title}</h3>
              <p class="hrc-desc">{r.description}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="section-cta"><a href="/resources" class="btn-primary">View All Resources</a></div>
    </div>
  </section>

  <section class="newsletter-section">
    <div class="section-inner">
      <div class="newsletter-card">
        <div class="newsletter-left">
          <h2 class="newsletter-heading">{hp.newsletter.heading}</h2>
          <p class="newsletter-sub">{hp.newsletter.sub}</p>
        </div>
        <div class="newsletter-right">
          <form class="newsletter-form" action="https://mycelium-learn.com/newsletter/" method="get">
            <input type="email" placeholder="Enter your email" class="newsletter-input" />
            <button type="submit" class="btn-primary small">Subscribe</button>
          </form>
          <p class="newsletter-privacy">{hp.newsletter.privacy}</p>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.section-inner { max-width: var(--max-width); margin: 0 auto; padding: 0 40px; }
.eyebrow-label { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-primary); margin-bottom: 12px; display: block; }
.eyebrow-label.light { color: #7A8B55; text-align: center; }
.section-heading { font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.8rem, 3vw, 2.5rem); line-height: 1.2; letter-spacing: -0.02em; margin-bottom: 16px; }
.section-heading.dark { color: #242424; }
.section-heading.light { color: #fff; }
.section-heading.center { text-align: center; margin-bottom: 16px; }
.section-sub { font-family: var(--font-outfit); font-size: 1rem; line-height: 1.6; margin-bottom: 40px; }
.section-sub.dark { color: #666; }
.section-cta { text-align: center; margin-top: 40px; }
.btn-primary { display: inline-flex; align-items: center; background: var(--color-brown); color: #fff; font-family: var(--font-inter); font-size: 1rem; font-weight: 500; padding: 12px 28px; border-radius: 50px; transition: background 0.2s; cursor: pointer; border: none; text-decoration: none; }
.btn-primary:hover { background: var(--color-brown-hover); }
.btn-primary.small { padding: 10px 24px; font-size: 0.875rem; }
.btn-underline:hover { color: #61CE70; }
.btn-sm-outline { font-family: var(--font-inter); font-size: 0.8rem; font-weight: 500; color: #e0e0e0; border: 1px solid rgba(255,255,255,0.35); padding: 7px 16px; border-radius: 6px; transition: border-color 0.2s, color 0.2s; text-decoration: none; display: inline-block; }
.btn-sm-outline:hover { border-color: #fff; color: #fff; }
.btn-sm-outline { font-family: var(--font-inter); font-size: 0.875rem; font-weight: 500; background: transparent; color: #242424; padding: 10px 20px; border-radius: 6px; border: 1px solid #242424; transition: background 0.2s, color 0.2s; text-decoration: none; display: inline-block; }
.btn-sm-outline:hover { background: #242424; color: #fff; }
.btn-sm-solid { font-family: var(--font-inter); font-size: 0.875rem; font-weight: 500; background: #2F4F2F; color: #fff; padding: 10px 20px; border-radius: 6px; border: none; transition: background 0.2s; text-decoration: none; display: inline-block; }
.btn-sm-solid:hover { background: #3d6b3d; }
.btn-underline { display: inline; font-family: var(--font-inter); font-size: 1rem; font-weight: 700; color: #D2CEC8; border-bottom: 2px solid #FFD53B; padding-bottom: 3px; letter-spacing: 0.05em; transition: color 0.2s; text-decoration: none; }
.hero { background: #43330B; padding: calc(160px + 64px) 40px 80px; margin-top: -64px; }
.hero-inner { max-width: var(--max-width); margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 88px; }
.hero-heading { font-family: var(--font-serif); font-size: 4.5rem; font-weight: 400; line-height: 1.0; letter-spacing: -0.02em; color: #D2CEC8; text-align: center; }
.hero-images { display: flex; gap: 24px; width: 100%; max-width: 1260px; justify-content: center; }
.hi { border-radius: 12px; object-fit: cover; flex: 1; height: 406px; min-width: 0; }
.mission { background: #43330B; padding: 16px 40px 80px; }
.mission-heading { font-size: 3.5rem; font-weight: 400; color: #D2CEC8; letter-spacing: -0.02em; line-height: 1.28; margin-bottom: 28px; }
.mission-inner { text-align: center; }
.mission-body { font-family: var(--font-lora); font-size: 1.25rem; font-weight: 500; color: #D2CEC8; line-height: 1.44; max-width: 910px; margin: 0 auto; }
.stats { background: #2B2F31; padding: 96px 40px; }
.stats .eyebrow-label { margin-bottom: 40px; }
.stats-row { display: flex; gap: 40px; justify-content: center; flex-wrap: wrap; }
.stat-item { display: flex; flex-direction: column; align-items: center; gap: 8px; min-width: 180px; }
.stat-number { font-family: var(--font-lora); font-size: clamp(2.5rem, 5vw, 3.75rem); font-weight: 500; color: #fff; line-height: 1; letter-spacing: -0.02em; }
.stat-label { font-family: var(--font-outfit); font-size: 1rem; color: #D2CEC8; text-align: center; max-width: 160px; line-height: 1.4; }
.founder { background: #2F2A1F; padding: 120px 40px; }
.founder-inner { display: flex; align-items: center; gap: 60px; }
.founder-img { flex-shrink: 0; width: 452px; }
.founder-img img { width: 100%; border-radius: 0px; }
.founder-text { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
.founder .section-heading { font-size: 2.44rem; font-weight: 500; line-height: 1.33; }
.founder-body { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 700; color: #D2CEC8; line-height: 1.2; max-width: 631px; }
.home-videos .section-heading, .home-courses .section-heading, .home-resources .section-heading { font-family: var(--font-outfit); font-size: 3rem; font-weight: 700; letter-spacing: -0.01em; }
.how-operate { background: #43330B; padding: 120px 40px; }
.operate-header { text-align: center; margin-bottom: 64px; }
.how-operate .section-heading { font-size: 4.5rem; font-weight: 500; }
.operate-sub { font-family: var(--font-outfit); font-size: 1.2rem; color: #D2CEC8; line-height: 1.6; max-width: 720px; margin: 0 auto; }
.operate-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
.operate-col { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
.operate-body { width: 100%; }
.operate-icon { height: 240px; display: flex; align-items: center; justify-content: flex-start; }
.operate-icon img { max-height: 220px; max-width: 100%; object-fit: contain; }
.partners-row { display: flex; align-items: center; gap: 12px; padding-top: 48px; }
.partners-existing { height: 120px; width: auto; opacity: 0.88; flex-shrink: 0; }
.partner-plus { font-family: var(--font-lora); font-size: 1.2rem; color: #C4973B; opacity: 0.7; flex-shrink: 0; }
.partner-sanghiblayan-logo { height: 120px; width: 120px; object-fit: contain; opacity: 0.6; flex-shrink: 0; }
.operate-title { font-family: var(--font-lora); font-size: 1.5rem; font-weight: 700; color: #fff; line-height: 1.3; }
.operate-body { font-family: var(--font-outfit); font-size: 1.1rem; color: #D2CEC8; line-height: 1.65; flex: 1; width: 100%; }
.operate-col .btn-underline { margin-top: 20px; }
.home-videos { background: #fff; padding: 96px 40px; }
.home-courses { background: #fff; padding: 80px 40px; }
.home-videos .section-heading, .home-courses .section-heading { text-align: center; }
.home-videos .section-sub, .home-courses .section-sub { text-align: center; }
.home-videos .section-heading { color: #1a1c1e; font-size: 3rem; }
.home-videos .section-sub { color: #555; }
.home-video-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 28px; }
.home-courses-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
.hvc { border-radius: 12px; overflow: hidden; background: transparent; transition: transform 0.2s; text-decoration: none; color: inherit; display: flex; flex-direction: column; }
.hvc:hover { transform: translateY(-3px); }
.hcc { border-radius: 12px; overflow: hidden; background: #fff; transition: box-shadow 0.2s; text-decoration: none; color: inherit; display: flex; flex-direction: column; }
.hcc:hover { box-shadow: 0 6px 28px rgba(0,0,0,0.1); transform: translateY(-2px); }
.hcc-thumb { aspect-ratio: 4/3; overflow: hidden; background: #f0f0f0; flex-shrink: 0; }
.hcc-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
.hcc:hover .hcc-thumb img { transform: scale(1.04); }
.hcc-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 5px; }
.hvc-thumb { aspect-ratio: 1/1; overflow: hidden; background: #e8e8e8; border-radius: 12px; display: block; position: relative; text-decoration: none; }
.hvc-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.hvc-play-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.hvc-body { padding: 14px 0 8px; display: flex; flex-direction: column; gap: 8px; }
.hvc-author { font-family: var(--font-inter); font-size: 0.78rem; font-weight: 500; color: #888; }
.hvc-title, .hcc-title { font-family: var(--font-inter); font-size: 1.1rem; font-weight: 700; color: #242424; line-height: 1.35; }
.hvc-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.hvc-actions { display: flex; gap: 8px; margin-top: 4px; }
.hvc-btn { flex: 1; font-family: var(--font-inter); font-size: 0.875rem; font-weight: 500; padding: 10px 12px; border-radius: 6px; text-decoration: none; text-align: center; transition: all 0.15s; }
.hvc-btn-solid { background: #2F4F2F; color: #fff; border: 1px solid #2F4F2F; }
.hvc-btn-solid:hover { background: #3d6b3d; }
.hvc-btn-outline { background: transparent; color: #242424; border: 1px solid #242424; }
.hvc-btn-outline:hover { background: #242424; color: #fff; }
.hcc-actions { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
.hcc-meta { font-family: var(--font-inter); font-size: 0.8rem; color: #888; }
.home-resources { background: #F7F7F5; padding: 80px 40px; }
.home-resources-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 24px; }
.hrc { border: 1px solid #e8e8e8; border-radius: 12px; overflow: hidden; background: #fff; display: flex; flex-direction: column; text-decoration: none; color: inherit; transition: box-shadow 0.2s, transform 0.15s; }
.hrc:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); transform: translateY(-2px); }
.hrc-thumb { aspect-ratio: 4/3; overflow: hidden; background: #f0f0f0; flex-shrink: 0; }
.hrc-thumb img { width: 100%; height: 100%; object-fit: cover; }
.hrc-body { padding: 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
.hrc-cat { font-family: var(--font-inter); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #2F4F2F; }
.hrc-title { font-family: var(--font-inter); font-size: 0.88rem; font-weight: 700; color: #242424; line-height: 1.35; }
.hrc-desc { font-family: var(--font-inter); font-size: 0.78rem; color: #666; line-height: 1.55; }
.newsletter-section { background: #fff; padding: 80px 40px; border-top: 1px solid #f0f0f0; }
.newsletter-card { border: 1px solid #e0e0da; border-radius: 12px; padding: 48px 48px; display: flex; gap: 64px; align-items: center; max-width: 960px; margin: 0 auto; }
.newsletter-left { flex: 1; }
.newsletter-heading { font-family: var(--font-outfit); font-size: 1.5rem; font-weight: 700; color: #242424; line-height: 1.25; margin-bottom: 12px; }
.newsletter-sub { font-family: var(--font-outfit); font-size: 0.9rem; color: #666; line-height: 1.6; }
.newsletter-right { flex-shrink: 0; display: flex; flex-direction: column; gap: 10px; min-width: 300px; }
.newsletter-form { display: flex; gap: 10px; }
.newsletter-input { flex: 1; padding: 12px 20px; border: 1px solid #ccc; border-radius: 50px; font-family: var(--font-inter); font-size: 0.875rem; outline: none; min-width: 0; }
.newsletter-privacy { font-family: var(--font-outfit); font-size: 0.78rem; color: #999; }
@media (max-width: 1024px) {
  .hi { height: 200px; } .founder-img { width: 320px; } .operate-grid { grid-template-columns: repeat(2,1fr); }
  .home-video-grid, .home-courses-grid { grid-template-columns: repeat(2,1fr); }
}
@media (max-width: 768px) {
  .hero { padding: calc(80px + 64px) 20px 80px; }
  .hero-images { flex-direction: column; }
  .hi { height: 220px; width: 100%; flex: none; }
  .section-inner { padding: 0 20px; }
  .mission, .stats, .founder, .how-operate, .home-videos, .home-courses, .home-resources, .newsletter-section { padding-left: 20px; padding-right: 20px; }
  .founder-inner { flex-direction: column; } .founder-img { width: 100%; }
  .operate-grid { grid-template-columns: 1fr; gap: 40px; }
  .home-video-grid, .home-courses-grid, .home-resources-grid { grid-template-columns: 1fr; }
  .newsletter-card { flex-direction: column; gap: 32px; padding: 32px 24px; }
  .newsletter-right { min-width: 0; width: 100%; }
  .newsletter-form { flex-direction: column; }
  .newsletter-input { width: 100%; }
}
</style>
