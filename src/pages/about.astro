---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="About - Mycelium">
  <SiteNav />

  <section class="about-hero">
    <div class="section-inner">
      <h1 class="about-title">Mycelium connects what grows beneath the surface</h1>
    </div>
  </section>

  <section class="about-story">
    <div class="section-inner story-inner">
      <div class="story-text">
        <h2 class="section-h2">How It Started</h2>
        <p>Have you ever wondered why nature wastes nothing, and wondered why we can&rsquo;t do the same?</p>
        <p>The founder discovered permaculture at Perma-Kapihan, an event by the Philippine Permaculture Association, after questioning why natural systems operate without waste while human systems create linear extraction and disposal cycles.</p>
        <p>After visiting Bert&rsquo;s home and taking a formal Permaculture Design Course in Nueva Ecija hosted by Bert, a 7-day immersive program, the foundation for Mycelium was born.</p>
        <p>A banana tree mulching area filled with layers upon layers of decomposing leaves and plant matter, where fallen plants cycled back into the soil, enriching it, became the moment that inspired Mycelium.</p>
      </div>
      <div class="story-img">
        <img src="https://mycelium-learn.com/wp-content/uploads/2026/02/about-img-02.webp" alt="Permaculture journey" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="about-stats">
    <div class="section-inner">
      <div class="about-stats-grid">
        <div class="as-item">
          <p class="as-stat">77%</p>
          <p class="as-label">Permaculture composting can divert up to 77% of organic waste from landfills</p>
        </div>
        <div class="as-item">
          <p class="as-stat">3x</p>
          <p class="as-label">Permaculture areas show three times more plant species than conventional agriculture</p>
        </div>
        <div class="as-item">
          <p class="as-stat">+</p>
          <p class="as-label">Urban permaculture supports habitat restoration, pollinators, and soil microorganisms</p>
        </div>
      </div>
    </div>
  </section>

  <section class="about-impact">
    <div class="section-inner story-inner">
      <div class="story-img">
        <img src="https://mycelium-learn.com/wp-content/uploads/2026/02/about-img-06.png" alt="Right Start Community" loading="lazy" />
      </div>
      <div class="story-text">
        <h2 class="section-h2">Measuring Impact: Right Start Development Community Center</h2>
        <p>Mycelium partners with Right Start, which supports children and families in Quezon City, Metro Manila, through education, creativity, and daily engagement.</p>
        <p>Rather than tracking participation alone, the platform observes shifts in perspective: how people begin to see waste, food, land, and responsibility as parts of a connected system.</p>
        <p>After 2 months, the community harvested the ampalaya!</p>
      </div>
    </div>
  </section>

  <section class="about-mission">
    <div class="section-inner">
      <h2 class="section-h2 center">Permaculture knowledge is scattered. So Mycelium organizes it.</h2>
      <p class="mission-body">The platform connects resources from The Baganihan Collective and Philippine Permaculture Association, keeping all its resources in real community implementation.</p>
    </div>
  </section>

  <section class="about-criteria">
    <div class="section-inner">
      <h2 class="section-h2">Selection Criteria</h2>
      <p class="criteria-intro">Resources must answer three questions:</p>
      <div class="criteria-grid">
        <div class="criteria-item">
          <span class="criteria-num">1</span>
          <div>
            <h3 class="criteria-q">Can a beginner understand it?</h3>
            <p class="criteria-a">Content organized into clear categories for accessibility</p>
          </div>
        </div>
        <div class="criteria-item">
          <span class="criteria-num">2</span>
          <div>
            <h3 class="criteria-q">Is this knowledge proven in practice?</h3>
            <p class="criteria-a">Applied in actual locations, not just theoretical</p>
          </div>
        </div>
        <div class="criteria-item">
          <span class="criteria-num">3</span>
          <div>
            <h3 class="criteria-q">Do we trust this source?</h3>
            <p class="criteria-a">Vetted through partner networks or cross-checked against field practitioners</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="about-partners">
    <div class="section-inner">
      <h2 class="section-h2 center">Partners</h2>
      <div class="partners-grid">
        <div class="partner-card">
          <img src="https://mycelium-learn.com/wp-content/uploads/2026/03/about-img-09.webp" alt="Baganihan Collective" loading="lazy" />
          <h3 class="partner-name">Baganihan Collective</h3>
          <p class="partner-desc">A network of permaculture practitioners, led by Hubert Posadas, working across six pilot communities in the Philippines with documented fieldwork and experiments.</p>
        </div>
        <div class="partner-card">
          <img src="https://mycelium-learn.com/wp-content/uploads/2026/03/about-img-10.webp" alt="Philippine Permaculture Association" loading="lazy" />
          <h3 class="partner-name">Philippine Permaculture Association</h3>
          <p class="partner-desc">The national network advancing permaculture in the Philippines through education and community projects, led by Bert Peeters.</p>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.section-inner { max-width: 1260px; margin: 0 auto; padding: 0 40px; }
.section-h2 { font-family: var(--font-serif); font-size: clamp(1.6rem, 2.5vw, 2.2rem); font-weight: 400; color: #242424; line-height: 1.25; letter-spacing: -0.015em; margin-bottom: 24px; }
.section-h2.center { text-align: center; }
.about-hero { background: #2F2A1F; padding: 96px 40px 80px; text-align: center; }
.about-title { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 400; color: #D2CEC8; line-height: 1.1; letter-spacing: -0.02em; max-width: 800px; margin: 0 auto; }
.about-story, .about-impact { padding: 96px 40px; }
.about-story { background: #fff; }
.about-impact { background: #F7F7F5; }
.story-inner { display: flex; align-items: center; gap: 64px; }
.story-text { flex: 1; display: flex; flex-direction: column; gap: 16px; }
.story-text p { font-family: var(--font-outfit); font-size: 1.05rem; color: #555; line-height: 1.7; }
.story-img { flex-shrink: 0; width: 420px; }
.story-img img { width: 100%; border-radius: 12px; }
.about-stats { background: #2B2F31; padding: 80px 40px; }
.about-stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
.as-item { text-align: center; }
.as-stat { font-family: var(--font-lora); font-size: 3rem; font-weight: 500; color: #fff; margin-bottom: 12px; }
.as-label { font-family: var(--font-outfit); font-size: 0.95rem; color: #D2CEC8; line-height: 1.5; }
.about-mission { background: #fff; padding: 80px 40px; text-align: center; }
.mission-body { font-family: var(--font-outfit); font-size: 1.05rem; color: #555; line-height: 1.7; max-width: 700px; margin: 0 auto; }
.about-criteria { background: #F7F7F5; padding: 80px 40px; }
.criteria-intro { font-family: var(--font-outfit); font-size: 1rem; color: #555; margin-bottom: 32px; }
.criteria-grid { display: flex; flex-direction: column; gap: 24px; }
.criteria-item { display: flex; align-items: flex-start; gap: 20px; padding: 24px; background: #fff; border-radius: 12px; border: 1px solid #e8e8e8; }
.criteria-num { font-family: var(--font-lora); font-size: 1.5rem; font-weight: 700; color: #5A3A1C; flex-shrink: 0; width: 36px; text-align: center; }
.criteria-q { font-family: var(--font-lora); font-size: 1rem; font-weight: 600; color: #242424; margin-bottom: 6px; }
.criteria-a { font-family: var(--font-outfit); font-size: 0.9rem; color: #666; line-height: 1.5; }
.about-partners { background: #fff; padding: 80px 40px; }
.partners-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px; margin-top: 48px; }
.partner-card img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 12px; margin-bottom: 20px; }
.partner-name { font-family: var(--font-lora); font-size: 1.2rem; font-weight: 600; color: #242424; margin-bottom: 10px; }
.partner-desc { font-family: var(--font-outfit); font-size: 0.95rem; color: #555; line-height: 1.6; }
@media (max-width: 900px) {
  .story-inner { flex-direction: column; } .story-img { width: 100%; }
  .about-stats-grid { grid-template-columns: 1fr; gap: 32px; }
  .partners-grid { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  .section-inner { padding: 0 20px; }
  .about-hero, .about-story, .about-impact, .about-stats, .about-mission, .about-criteria, .about-partners { padding-left: 20px; padding-right: 20px; }
}
</style>
