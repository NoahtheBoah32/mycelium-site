---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ab from '../content/data/about.json';
---

<BaseLayout title="About - Mycelium">
  <SiteNav overlay={true} />

  <section class="about-hero" style={`background-image: url('${ab.heroImage}')`}>
    <div class="section-inner">
      <a href="#how-it-started" class="about-hero-link">READ THE FULL JOURNEY</a>
      <h1 class="about-title">{ab.heroTitle}</h1>
    </div>
  </section>

  <section class="about-story" id="how-it-started">
    <div class="section-inner">
      <h2 class="section-h2 center">HOW IT STARTED</h2>
      <p class="story-intro">{ab.storyIntro}</p>
      <div class="story-inner">
        <div class="story-text">
          {ab.storyParagraphs.map((p: string) => <p>{p}</p>)}
        </div>
        <div class="story-img">
          <img src={ab.storyImage} alt="Permaculture journey" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="about-why">
    <div class="section-inner">
      <div class="why-inner">
        <div class="why-left">
          <div class="why-text-block">
            <h2 class="section-h2">{ab.whyHeading}</h2>
            {ab.whyParagraphs.map((p: string) => <p>{p}</p>)}
          </div>
          <div class="why-dark-box">
            <img src={ab.whyChartImage} alt="Landfill waste composition before and after permaculture" loading="lazy" class="why-chart" />
            <p class="why-chart-caption">{ab.whyChartCaption}</p>
          </div>
          <div class="why-thing-block">
            <h2 class="section-h2">{ab.heresthethingHeading}</h2>
            <p>{ab.heresthethingLeft}</p>
          </div>
        </div>
        <div class="why-right">
          <div class="why-landscape-wrap">
            <img src={ab.whyLandscapeImage} alt="Permaculture landscape" loading="lazy" class="why-landscape" />
          </div>
          <div class="why-dark-box">
            <img src={ab.whyBioImage} alt="Improves biodiversity 3x" loading="lazy" class="why-bio-card" />
            <p class="why-bio-caption">{ab.whyBioCaption}</p>
          </div>
          <div class="why-thing-block">
            <p>{ab.heresthethingRight1}</p>
            <p>{ab.heresthethingRight2}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="about-impact">
    <div class="impact-inner">
      <div class="impact-text">
        <h2 class="section-h2">{ab.impactHeading}</h2>
        {ab.impactParagraphs.map((p: string) => <p>{p}</p>)}
      </div>
      <div class="impact-imgs">
        {ab.impactImages.map((src: string) => (
          <img src={src} alt="Right Start Community" loading="lazy" />
        ))}
      </div>
    </div>
  </section>

  <section class="about-mission">
    <div class="section-inner">
      <h3 class="section-eyebrow">{ab.missionEyebrow}</h3>
      <h2 class="section-h2 center">{ab.missionHeading}</h2>
      <p class="mission-body">{ab.missionBody}</p>
      <div class="mission-pillars">
        {ab.missionPillars.map((pillar: {label: string, body: string}) => (
          <div class="pillar">
            <h3 class="pillar-label">{pillar.label}</h3>
            <p class="pillar-body">{pillar.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-criteria">
    <div class="section-inner">
      <h3 class="section-eyebrow center">{ab.criteriaEyebrow}</h3>
      <h2 class="section-h2 center">{ab.criteriaHeading}</h2>
      <div class="criteria-grid">
        {ab.criteriaItems.map((item: {number: string, question: string, answer: string}) => (
          <div class="criteria-item">
            <span class="criteria-num">{item.number}</span>
            <div>
              <h3 class="criteria-q">{item.question}</h3>
              <p class="criteria-a">{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="about-partners">
    <div class="section-inner">
      <h3 class="section-eyebrow center">{ab.partnersEyebrow}</h3>
      <h2 class="section-h2 center">{ab.partnersHeading}</h2>
      <p class="partners-intro">{ab.partnersIntro}</p>
      <div class="partners-grid">
        {ab.partners.map((p: {name: string, description: string, image: string}) => (
          <div class="partner-card">
            <img src={p.image} alt={p.name} loading="lazy" />
            <h3 class="partner-name">{p.name}</h3>
            <p class="partner-desc">{p.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.section-inner { max-width: 1260px; margin: 0 auto; }
/* Big statement headings (Mission, Criteria, Partners) */
.section-h2 { font-family: var(--font-lora); font-size: clamp(2rem, 5.76vw, 3.75rem); font-weight: 500; color: #242424; line-height: 1.1; letter-spacing: -0.01em; margin-bottom: 12px; }
.section-h2.center { text-align: center; }
/* Section label headings (HOW IT STARTED, WHY, HERE'S THE THING, MEASURING IMPACT) */
.about-story .section-h2, .about-why .section-h2, .about-impact .section-h2 { font-size: 2.44rem; font-weight: 100; letter-spacing: -0.195px; color: #fff; }
.about-mission .section-h2 { font-weight: 500; font-size: clamp(2rem, 5.76vw, 3.75rem); }
.about-criteria .section-h2, .about-partners .section-h2 { font-weight: 600; font-size: clamp(2rem, 5.76vw, 3.75rem); }

/* Hero */
.about-hero {
  background-size: cover;
  background-position: center;
  margin-top: -64px;
  background-color: #2F2A1F;
  position: relative;
  min-height: 600px;
  padding: 240px 40px 280px;
  text-align: center;
}
.about-hero::before { content: ''; position: absolute; inset: 0; background: rgba(20,16,8,0.6); }
.about-hero > * { position: relative; z-index: 1; }
.about-hero-link { display: inline-block; font-family: var(--font-outfit); font-size: 0.75rem; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; color: #D2CEC8; text-decoration: none; margin-bottom: 16px; transition: color 0.2s; }
.about-hero-link:hover { color: #FFD53B; }
.about-title { font-family: var(--font-lora); font-size: clamp(1.2rem, 1.8vw, 1.75rem); font-style: normal; font-weight: 700; color: #fff; line-height: 1.3; letter-spacing: -0.01em; text-align: center; max-width: 680px; margin: 0 auto; }

/* HOW IT STARTED */
.about-story { background: #2F2A1F; padding: 120px 40px; }
.story-intro { font-family: var(--font-lora); font-size: 1.5rem; font-style: normal; font-weight: 400; color: rgb(210,206,200); line-height: 1.5; text-align: center; max-width: 630px; margin: 0 auto 48px; }
.story-inner { display: flex; align-items: flex-start; gap: 48px; max-width: 1140px; margin: 0 auto; }
.story-text { flex: 1; display: flex; flex-direction: column; gap: 20px; }
.story-text p { font-family: var(--font-lora); font-size: 1.5rem; font-style: normal; color: rgb(210,206,200); line-height: 1.65; }
.story-img { flex-shrink: 0; width: 560px; }
.story-img img { width: 100%; border-radius: 24px; }

/* WHY THIS MATTERS TO ME */
.about-why { background: #43330B; padding: 120px 40px; }
.why-inner { display: flex; align-items: flex-start; gap: 40px; max-width: 1140px; margin: 0 auto; }
.why-left { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 40px; }
.why-right { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 40px; }
.why-text-block { display: flex; flex-direction: column; gap: 0; }
.why-text-block p { font-family: var(--font-lora); font-size: 1.5rem; font-style: normal; font-weight: 400; color: rgb(210,206,200); line-height: 1.65; margin-bottom: 16px; }
.why-dark-box { background: rgb(34,36,33); display: flex; flex-direction: column; }
.why-dark-box img { width: 100%; }
.why-chart { border-radius: 20px 20px 0 0; }
.why-chart-caption { font-family: var(--font-outfit); font-size: 0.875rem; color: #fff; line-height: 1.55; padding: 16px 20px 20px; }
.why-bio-card { border-radius: 20px 20px 0 0; }
.why-bio-caption { font-family: var(--font-lora); font-size: 0.875rem; color: rgb(212,207,168); line-height: 1.55; padding: 16px 20px 20px; }
.why-landscape-wrap { flex-shrink: 0; }
.why-landscape { width: 100%; border-radius: 24px; display: block; }
.why-thing-block { display: flex; flex-direction: column; gap: 0; }
.why-left .why-thing-block p { font-family: var(--font-lora); font-size: 1.5rem; font-style: normal; color: rgb(210,206,200); line-height: 1.65; margin-bottom: 16px; }
.why-right .why-thing-block p { font-family: var(--font-lora); font-size: 1.5rem; font-style: normal; color: rgb(210,206,200); line-height: 1.65; margin-bottom: 16px; }


/* MEASURING IMPACT */
.about-impact { background: #2F2A1F; padding: 0; }
.impact-inner { max-width: 1140px; margin: 0 auto; display: flex; align-items: stretch; gap: 40px; }
.impact-text { flex: 0 0 619px; padding: 120px 40px 0; display: flex; flex-direction: column; gap: 16px; }
.impact-text p { font-family: var(--font-lora); font-size: 1.5rem; font-style: normal; color: rgb(210,206,200); line-height: 1.65; }
.impact-imgs { flex: 1; background: rgb(217,217,217); padding: 60px 0; display: flex; flex-direction: column; gap: 24px; align-items: center; justify-content: center; }
.impact-imgs img { width: 360px; height: 360px; object-fit: cover; border-radius: 24px; }

/* MISSION */
.about-mission { background: #2E2C07; padding: 120px 40px; text-align: center; }
.about-mission .section-h2 { color: #fff; font-style: italic; }
.mission-body { font-family: var(--font-lora); font-size: 1.05rem; color: #D2CEC8; line-height: 1.65; max-width: 630px; margin: 0 auto 40px; }
.mission-pillars { display: flex; gap: 20px; max-width: 1000px; margin: 0 auto; }
.pillar { flex: 1; background: rgb(84, 76, 19); border-radius: 0; padding: 30px; text-align: left; border-top: 9.6px solid rgb(200,160,26); }
.section-eyebrow { font-family: var(--font-inter); font-size: 0.75rem; font-weight: 700; color: #C8A01A; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 16px; }
.section-eyebrow.center { text-align: center; }
.pillar-label { font-family: var(--font-lora); font-size: 1.05rem; font-weight: 700; color: #BA9518; margin-bottom: 12px; letter-spacing: 0.04em; text-transform: uppercase; }
.pillar-body { font-family: var(--font-lora); font-size: 0.95rem; color: rgb(212,207,168); line-height: 1.6; }

/* CRITERIA */
.about-criteria { background: rgb(38,36,0); padding: 120px 40px; }
.about-criteria .section-h2 { color: #fff; margin-bottom: 40px; }
.criteria-grid { display: flex; gap: 20px; }
.criteria-item { flex: 1; display: flex; flex-direction: column; padding: 30px; background: rgb(47,42,2); border-radius: 0; border: 0.8px solid rgb(202,190,150); }
.criteria-num { font-family: var(--font-lora); font-size: 5rem; font-weight: 700; color: rgb(77,65,6); line-height: 1; margin-bottom: 12px; }
.criteria-q { font-family: var(--font-lora); font-size: 1.05rem; font-style: italic; font-weight: 600; color: #fff; margin-bottom: 8px; }
.criteria-a { font-family: var(--font-lora); font-size: 0.9rem; color: rgb(212,207,168); line-height: 1.65; }

/* PARTNERS */
.about-partners { background: #2E2C07; padding: 120px 40px; }
.about-partners .section-h2 { color: #fff; }
.partners-intro { font-family: var(--font-outfit); font-size: 1rem; color: #D2CEC8; line-height: 1.65; text-align: center; max-width: 630px; margin: 0 auto 48px; }
.partners-grid { display: flex; gap: 20px; }
.partner-card { flex: 1; background: rgb(47,42,2); border: 9.6px solid rgb(92,78,12); padding: 40px; display: flex; flex-direction: column; gap: 16px; }
.partner-card > img:first-child { width: 100%; aspect-ratio: 443/189; object-fit: cover; }
.partner-name { font-family: var(--font-lora); font-size: 1.1rem; font-weight: 600; color: #fff; }
.partner-desc { font-family: var(--font-lora); font-size: 0.9rem; color: rgb(212,207,168); line-height: 1.65; }

@media (max-width: 1100px) {
  .about-story .story-img { width: 380px; }
}
@media (max-width: 900px) {
  .story-inner { flex-direction: column; } .story-img { width: 100%; }
  .why-inner { flex-direction: column; }
  .impact-inner { flex-direction: column; }
  .impact-text { padding: 60px 20px; }
  .impact-imgs { padding: 40px 20px; }
  .partners-grid { grid-template-columns: 1fr; }
  .mission-pillars { grid-template-columns: 1fr; }
  .story-text p, .why-text-block p, .why-thing-block p, .impact-text p, .story-intro, .mission-body, .partner-desc { font-size: 0.95rem; }
}
@media (max-width: 600px) {
  .about-hero, .about-story, .about-why, .about-impact, .about-mission, .about-criteria, .about-partners { padding-left: 20px; padding-right: 20px; }
  .section-h2 { font-size: 2rem; }
  .about-title { font-size: 2.5rem; }
}
</style>
