---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const courses = [
  { title: "Permaculture Vision Design Course", url: "https://permaculturevisions.com/permaculture-design-course/" },
  { title: "Pan Gaia Permaculture Online PDC", url: "https://pangaiapermaculture.com/course/live-permaculture-design-certificate-pdc/" },
  { title: "Crystal Waters Permaculture Design Course", url: "https://crystalwaters.org.au/permaculture-design-course/" },
  { title: "Permaculture Matters Design Course", url: "https://permaculturematters.com.au" },
  { title: "Eduardo Terzidis Online PDC", url: "https://eduardoterzidis.com" },
  { title: "Permaculture Rising Design Courses", url: "https://permaculturerising.com" },
  { title: "Permaculture Impact (Getting Started) PDC", url: "https://permacultureimpact.org" },
  { title: "Greening the Desert Permaculture", url: "https://greeningthedesertproject.org" },
  { title: "Aranya Permaculture India", url: "https://permacultureindia.org" },
];
---

<BaseLayout title="Courses - Mycelium">
  <SiteNav />

  <section class="courses-hero">
    <div class="section-inner">
      <span class="eyebrow">Courses</span>
      <h1 class="courses-title">Your Guide to Permaculture Training</h1>
      <p class="courses-sub">Find the perfect course to begin your permaculture journey</p>
    </div>
  </section>

  <section class="courses-grid-section">
    <div class="section-inner">
      <div class="courses-grid">
        {courses.map(c => (
          <div class="cc">
            <h3 class="cc-title">{c.title}</h3>
            <p class="cc-meta">All Countries &middot; All Types</p>
            <div class="cc-actions">
              <a href={c.url} target="_blank" rel="noopener" class="btn-view">View Course</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.section-inner { max-width: 1260px; margin: 0 auto; padding: 0 40px; }
.eyebrow { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-primary); margin-bottom: 12px; display: block; }
.courses-hero { background: #2F2A1F; padding: 96px 40px 80px; }
.courses-title { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem); font-weight: 400; color: #D2CEC8; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 16px; }
.courses-sub { font-family: var(--font-outfit); font-size: 1.1rem; color: #888; line-height: 1.6; }
.courses-grid-section { background: #fff; padding: 64px 40px 80px; }
.courses-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.cc { padding: 28px; border: 1px solid #e8e8e8; border-radius: 12px; display: flex; flex-direction: column; gap: 12px; background: #fff; transition: box-shadow 0.2s; }
.cc:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.07); }
.cc-title { font-family: var(--font-lora); font-size: 1rem; font-weight: 600; color: #242424; line-height: 1.4; }
.cc-meta { font-family: var(--font-inter); font-size: 0.8rem; color: #888; }
.cc-actions { margin-top: auto; padding-top: 8px; }
.btn-view { font-family: var(--font-inter); font-size: 0.8rem; font-weight: 500; background: #5A3A1C; color: #fff; padding: 8px 18px; border-radius: 50px; transition: background 0.2s; text-decoration: none; display: inline-block; }
.btn-view:hover { background: #947153; }
@media (max-width: 900px) { .courses-grid { grid-template-columns: repeat(2,1fr); } }
@media (max-width: 600px) { .section-inner { padding: 0 20px; } .courses-hero { padding: 64px 20px 48px; } .courses-grid-section { padding: 40px 20px; } .courses-grid { grid-template-columns: 1fr; } }
</style>
