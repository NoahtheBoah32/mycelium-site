---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const courses = [
  { title: "Permaculture Vision Design Course", meta: "All Countries · All Types", img: "https://mycelium-learn.com/wp-content/uploads/2026/01/Permaculture-Vision-Design-Course.jpg", url: "https://permaculturevisions.com/permaculture-design-course/" },
  { title: "Pan Gaia Permaculture Online PDC", meta: "All Countries · All Types", img: "https://mycelium-learn.com/wp-content/uploads/2026/01/Pan-Gaia-Permaculture-Online-Permaculture-Design-Course-1.png", url: "https://pangaiapermaculture.com/course/live-permaculture-design-certificate-pdc/" },
  { title: "Crystal Waters Permaculture Design Course", meta: "All Countries · All Types", img: "https://mycelium-learn.com/wp-content/uploads/2026/01/Crystal-Waters-Permaculture-Design-Course.png", url: "https://crystalwaters.org.au/permaculture-design-course/" },
  { title: "Permaculture Matters Design Course", meta: "All Countries · All Types", img: "https://mycelium-learn.com/wp-content/uploads/2026/01/Permaculture-Matters-Design-Course.png", url: "https://permaculturematters.com.au" },
  { title: "Eduardo Terzidis Online PDC", meta: "All Countries · All Types", img: "https://mycelium-learn.com/wp-content/uploads/2026/01/Eduardo-Terzidis-Online-Permaculture-Design-Course.png", url: "https://eduardoterzidis.com" },
  { title: "Permaculture Rising's Permaculture Design Courses", meta: "All Countries · All Types", img: "https://mycelium-learn.com/wp-content/uploads/2026/01/Permaculture-Risings-Permaculture-Design-Courses.png", url: "https://permaculturerising.com" },
  { title: "Permaculture Impact (Getting Started) PDC", meta: "All Countries · All Types", img: "https://mycelium-learn.com/wp-content/uploads/2026/01/Permaculture-Impact-Getting-Started-PDC-Courses.png", url: "https://permacultureimpact.org" },
  { title: "Greening the Desert Permaculture", meta: "All Countries · All Types", img: "https://mycelium-learn.com/wp-content/uploads/2026/01/Greening-the-Desert-Permaculture.png", url: "https://greeningthedesertproject.org" },
  { title: "Aranya Permaculture India", meta: "All Countries · All Types", img: "https://mycelium-learn.com/wp-content/uploads/2026/01/Aranya-Permaculture-India.png", url: "https://permacultureindia.org" },
];
---

<BaseLayout title="Courses - Mycelium">
  <SiteNav />

  <section class="cp-hero">
    <div class="cp-inner">
      <h1 class="cp-title">Your Guide to Permaculture Training</h1>
      <p class="cp-sub">Find the perfect course to begin your permaculture journey</p>
    </div>
  </section>

  <section class="cp-grid-section">
    <div class="cp-inner">
      <div class="cp-grid">
        {courses.map(c => (
          <a href={c.url} target="_blank" rel="noopener" class="cc">
            <div class="cc-thumb">
              <img src={c.img} alt={c.title} loading="lazy" />
            </div>
            <div class="cc-body">
              <h3 class="cc-title">{c.title}</h3>
              <p class="cc-meta">{c.meta}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.cp-hero { background: #fff; padding: 64px 40px 40px; border-bottom: 1px solid #f0f0f0; }
.cp-inner { max-width: 1260px; margin: 0 auto; }
.cp-title { font-family: var(--font-serif); font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 400; color: #242424; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 12px; text-align: center; }
.cp-sub { font-family: var(--font-outfit); font-size: 1rem; color: #666; line-height: 1.6; text-align: center; }
.cp-grid-section { background: #f9f9f7; padding: 40px 40px 80px; }
.cp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.cc { border-radius: 10px; overflow: hidden; background: #fff; border: 1px solid #e8e8e8; transition: box-shadow 0.2s, transform 0.15s; display: flex; flex-direction: column; text-decoration: none; color: inherit; }
.cc:hover { box-shadow: 0 4px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
.cc-thumb { aspect-ratio: 16/9; overflow: hidden; background: #f0f0f0; flex-shrink: 0; }
.cc-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
.cc:hover .cc-thumb img { transform: scale(1.04); }
.cc-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 5px; }
.cc-title { font-family: var(--font-inter); font-size: 0.85rem; font-weight: 600; color: #242424; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.cc-meta { font-family: var(--font-inter); font-size: 0.75rem; color: #888; }
@media (max-width: 1024px) { .cp-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .cp-hero { padding: 40px 20px 28px; } .cp-grid-section { padding: 28px 20px 60px; } .cp-grid { grid-template-columns: 1fr; } }
</style>
