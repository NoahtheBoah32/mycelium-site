---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const courses = [
  { title: "Permaculture Vision Design Course", meta: "All Countries · All Types", img: "/images/wp/Permaculture-Vision-Design-Course.jpg", url: "https://permaculturevisions.com/permaculture-design-course/" },
  { title: "Pan Gaia Permaculture Online PDC", meta: "All Countries · All Types", img: "/images/wp/Pan-Gaia-Permaculture-Online-Permaculture-Design-Course-1.png", url: "https://pangaiapermaculture.com/course/live-permaculture-design-certificate-pdc/" },
  { title: "Crystal Waters Permaculture Design Course", meta: "All Countries · All Types", img: "/images/wp/Crystal-Waters-Permaculture-Design-Course.png", url: "https://crystalwaters.org.au/permaculture-design-course/" },
  { title: "Permaculture Matters Design Course", meta: "All Countries · All Types", img: "/images/wp/Permaculture-Matters-Design-Course.png", url: "https://permaculturematters.com.au" },
  { title: "Eduardo Terzidis Online PDC", meta: "All Countries · All Types", img: "/images/wp/Eduardo-Terzidis-Online-Permaculture-Design-Course.png", url: "https://eduardoterzidis.com" },
  { title: "Permaculture Rising's Permaculture Design Courses", meta: "All Countries · All Types", img: "/images/wp/Permaculture-Risings-Permaculture-Design-Courses.png", url: "https://permaculturerising.com" },
  { title: "Permaculture Impact (Getting Started) PDC", meta: "All Countries · All Types", img: "/images/wp/Permaculture-Impact-Getting-Started-PDC-Courses.png", url: "https://permacultureimpact.org" },
  { title: "Greening the Desert Permaculture", meta: "All Countries · All Types", img: "/images/wp/Greening-the-Desert-Permaculture.png", url: "https://greeningthedesertproject.org" },
  { title: "Aranya Permaculture India", meta: "All Countries · All Types", img: "/images/wp/Aranya-Permaculture-India.png", url: "https://permacultureindia.org" },
];
---

<BaseLayout title="Courses - Mycelium">
  <SiteNav />

  <section class="cp-hero">
    <div class="cp-inner">
      <h1 class="cp-title">Your Guide to Permaculture Training</h1>
      <p class="cp-sub">Find the perfect course to begin your permaculture journey</p>
    </div>
  </section>

  <section class="cp-grid-section">
    <div class="cp-inner">
      <div class="cp-grid">
        {courses.map(c => (
          <a href={c.url} target="_blank" rel="noopener" class="cc">
            <div class="cc-thumb">
              <img src={c.img} alt={c.title} loading="lazy" />
            </div>
            <div class="cc-body">
              <h3 class="cc-title">{c.title}</h3>
              <p class="cc-meta">{c.meta}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.cp-hero { background: #F7F7F5; padding: 64px 40px 48px; border-bottom: 1px solid #ebe9e3; }
.cp-inner { max-width: 1260px; margin: 0 auto; }
.cp-title { font-family: var(--font-outfit); font-size: 3.75rem; font-weight: 700; color: #242424; line-height: 1.2; letter-spacing: -0.01em; margin-bottom: 14px; text-align: center; }
.cp-sub { font-family: var(--font-outfit); font-size: 1.5rem; color: #666; line-height: 1.5; text-align: center; }
.cp-grid-section { background: #F7F7F5; padding: 48px 40px 80px; }
.cp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
.cc { text-decoration: none; color: inherit; display: flex; flex-direction: column; gap: 14px; }
.cc:hover .cc-thumb img { transform: scale(1.04); }
.cc-thumb { aspect-ratio: 1 / 1; overflow: hidden; background: #e8e8e8; border-radius: 12px; }
.cc-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; display: block; }
.cc-body { display: flex; flex-direction: column; gap: 4px; padding: 0 4px; }
.cc-title { font-family: var(--font-inter); font-size: 1.125rem; font-weight: 700; color: #242424; line-height: 1.4; }
.cc-meta { font-family: var(--font-inter); font-size: 0.875rem; color: #888; }
@media (max-width: 1024px) { .cp-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) {
  .cp-hero { padding: 40px 20px 28px; }
  .cp-title { font-size: 2.5rem; }
  .cp-sub { font-size: 1.1rem; }
  .cp-grid-section { padding: 28px 20px 60px; }
  .cp-grid { grid-template-columns: 1fr; }
}
</style>
