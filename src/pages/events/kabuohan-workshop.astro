---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const photos = [
  { src: '/images/events/kabuohan/circle-laugh.jpg', alt: 'Families gathering in a welcome circle on the lawn' },
  { src: '/images/events/kabuohan/arrival.jpg', alt: 'Participants arriving at Rizal Art House' },
  { src: '/images/events/kabuohan/garden-walk.jpg', alt: 'Parent-child teams walking through the garden beds' },
  { src: '/images/events/kabuohan/beds-closeup.jpg', alt: 'Children and parents examining plants up close' },
  { src: '/images/events/kabuohan/learning-circle.jpg', alt: 'Families gathered around the hugelkultur bed' },
  { src: '/images/events/kabuohan/group-lawn.jpg', alt: 'Full group in the garden at Rizal Art House' },
];

const outline = [
  { num: 1, title: 'Arrival into Awareness', time: '30–45 min', desc: 'Welcome circle. Everyone shares one living thing they noticed on the way. Then footwear off, soil underfoot, air smelled, bark touched. One question asked: "What do you notice?" No explanations. Just presence.' },
  { num: 2, title: 'Meeting the Place', time: '30–45 min', desc: 'Parent-child teams explore the grounds. Find: something growing well, something struggling, an insect, a moist area, a dry area, something beautiful, something surprising. Gather and share. Permaculture principle introduced: observe before you intervene.' },
  { num: 3, title: 'Family Garden Design Play', time: '45–60 min', desc: 'Using sticks, leaves, stones, seeds, and cardboard, families design a miniature food forest. The challenge: a garden where people thrive, plants thrive, insects thrive, and soil thrives. Families present. Facilitators draw out: diversity, water, shelter, cooperation, cycles.' },
  { num: 4, title: 'Building a Hugelkultur Bed', time: '60–90 min', desc: 'Everyone works together: digging, arranging wood, adding organic matter, covering with soil, watering, planting. Participation over perfection. No lengthy explanations during the work. Learning happens through contact with materials.' },
  { num: 5, title: 'Reflection on the Garden', time: '15–20 min', desc: 'Gather around the completed bed. What did we use to build this? Which of these did humans invent? Introduce decomposition as transformation. The bed is already full of hidden communities: fungi, bacteria, earthworms, roots.' },
  { num: 6, title: 'Transition to Pottery', time: '20 min', desc: 'Bridge the two halves of the day. Story of an ancient child discovering clay as a way to carry water and store food. Key insight: humans did not invent clay. Humans entered into relationship with clay.' },
  { num: 7, title: 'Clay Exploration', time: '15 min', desc: 'Each pair receives clay. Hold it, smell it, squeeze it. How is this similar to soil? How is it different? No right answers. Experience before instruction.' },
  { num: 8, title: 'Primitive Pottery', time: '60–90 min', desc: 'Families shape pinch pots, coil pots, seed bowls, small vessels, animal figures. Facilitators support rather than direct. Parents and children create together. Discuss how pottery supported water storage, cooking, seed saving, community life.' },
  { num: 9, title: 'The Hidden Communities', time: '20–30 min', desc: 'Gather around the garden and pottery. Inside the hugelkultur bed: fungi, bacteria, insects, earthworms, roots working together. Inside our bodies: the same. Healthy soil supports healthy plants. Healthy plants support healthy people. Humans participate within nature, not outside it.' },
  { num: 10, title: 'Community Gallery', time: '20 min', desc: 'Display pottery pieces, garden designs, and observations from the day. Participants walk and appreciate each other\'s work. No judging. No competition. No prizes. Just looking.' },
  { num: 11, title: 'Closing Reflection', time: '30 min', desc: 'Circle gathering. Children asked: what surprised you, what did you enjoy, what did you discover. Parents asked: what did you learn from your child today? Final question: "When you arrived this morning, where did you think nature was? After today, where is it?"' },
];
---

<BaseLayout title="Kabuohan Workshop — Mycelium" description="A full-day permaculture gardening and primitive pottery workshop for homeschool families at Rizal Art House, hosted by Baganihan Collective.">
  <SiteNav />

  <div class="kw-back-bar">
    <div class="kw-inner">
      <a href="/resources" class="kw-back">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M10 4L6 8l4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Resources
      </a>
    </div>
  </div>

  <div class="kw-hero">
    <img src="/images/events/kabuohan/group-lawn.jpg" alt="Kabuohan Workshop at Rizal Art House" class="kw-hero-img" />
    <div class="kw-hero-overlay"></div>
    <div class="kw-hero-text">
      <span class="kw-eyebrow">Community Event · June 25, 2026</span>
      <h1 class="kw-title">Kabuohan Workshop</h1>
      <p class="kw-subtitle">Permaculture Gardening and Primitive Pottery for Homeschool Families</p>
    </div>
  </div>

  <section class="kw-meta-bar">
    <div class="kw-inner kw-meta-row">
      <div class="kw-meta-item">
        <span class="kw-meta-label">Hosted by</span>
        <span class="kw-meta-value">Baganihan Collective</span>
      </div>
      <div class="kw-meta-divider"></div>
      <div class="kw-meta-item">
        <span class="kw-meta-label">Venue</span>
        <span class="kw-meta-value">Rizal Art House</span>
      </div>
      <div class="kw-meta-divider"></div>
      <div class="kw-meta-item">
        <span class="kw-meta-label">Facilitator</span>
        <span class="kw-meta-value">Hubert Posadas</span>
      </div>
      <div class="kw-meta-divider"></div>
      <div class="kw-meta-item">
        <span class="kw-meta-label">Format</span>
        <span class="kw-meta-value">Parent-Child Learning Journey</span>
      </div>
    </div>
  </section>

  <section class="kw-body-section">
    <div class="kw-inner kw-body-grid">
      <div class="kw-writeup">
        <p class="kw-lead">Hubert gathered homeschool families at Rizal Art House last June 25. Not to lecture about permaculture. To live it for a day.</p>

        <p>It started with a question: "What living thing did you notice on your way here?" Parents and children answered equally. Then everyone took off their shoes. They walked the soil, smelled the air, touched leaves and bark. Hubert did not explain anything. Just: "What do you notice?" In permaculture, this has a name. Observe and interact. The garden speaks first. You listen before you act.</p>

        <p>Parent-child teams spread across the grounds with a simple task: find something growing well, something struggling, an insect, a moist area, a dry area, something beautiful, something surprising. They gathered, shared, and asked why. What patterns are you seeing? The first permaculture principle Hubert introduced was not on a slide. It was the garden itself.</p>

        <p>Then the families designed their own food forests. Sticks, stones, leaves, seeds, cardboard. One rule: design a place where people thrive, plants thrive, insects thrive, and soil thrives. Not one. All of them. That is permaculture design thinking held in a child's hands. Integrate rather than segregate. Every element in relationship with every other.</p>

        <p>In the afternoon they built a real hugelkultur bed together. Wood layered with organic matter, covered with soil, watered, planted. Hubert asked what they had used. Soil, water, wood, leaves. Then: "Which of these did humans invent?" None. Gardening, he said, is collaboration with nature. The wood inside the bed would decompose. The decomposition would feed the soil. The soil would feed the plants. Decomposition is transformation. The bed was already full of hidden communities: fungi, bacteria, insects, earthworms, and roots, all working together unseen.</p>

        <p>The afternoon moved to clay. Same earth, different form. The children held it, smelled it, squeezed it. Humans did not invent clay. Humans entered into relationship with clay. Families shaped pinch pots, seed bowls, animal figures. The day closed with a community gallery. No grades. No prizes. Just looking at what everyone had made.</p>

        <p>The closing circle asked one final question: "After today, where do you think nature is?"</p>

        <p>The children had spent time with the garden and the earth, learned from them, and discovered they were part of a larger living whole. Plants, soil, rain, insects, clay, people, and communities all exist through relationships. When we care for those relationships, life flourishes.</p>
      </div>

      <div class="kw-pedagogy">
        <h2 class="kw-section-label">The Kabuohan Approach</h2>
        <ul class="kw-principles">
          <li>Experience before explanation</li>
          <li>Observation before instruction</li>
          <li>Participation before theory</li>
          <li>Relationship before information</li>
          <li>Reflection before conclusion</li>
        </ul>

        <h2 class="kw-section-label kw-section-label--gap">Permaculture Principles at Work</h2>
        <ul class="kw-principles">
          <li>Observe and interact</li>
          <li>Integrate rather than segregate</li>
          <li>Use and value diversity</li>
          <li>Care for the earth, care for people</li>
        </ul>

        <p class="kw-kaginhawaan"><em>Kaginhawaan.</em> Ease. Well-being. Right relationship with the living world. The workshop did not explain it. It let you feel it.</p>
      </div>
    </div>
  </section>

  <section class="kw-outline-section">
    <div class="kw-inner">
      <div class="kw-outline-header">
        <h2 class="kw-gallery-heading">Course Outline</h2>
        <p class="kw-outline-sub">Designed by Hubert Posadas. Reproducible for educators and community groups.</p>
      </div>
      <div class="kw-outline-list">
        {outline.map(part => (
          <div class="kw-outline-item">
            <div class="kw-outline-num">{String(part.num).padStart(2, '0')}</div>
            <div class="kw-outline-content">
              <div class="kw-outline-row">
                <span class="kw-outline-title">{part.title}</span>
                <span class="kw-outline-time">{part.time}</span>
              </div>
              <p class="kw-outline-desc">{part.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="kw-gallery-section">
    <div class="kw-inner">
      <h2 class="kw-gallery-heading">From the Garden</h2>
      <div class="kw-gallery">
        {photos.map(p => (
          <div class="kw-photo">
            <img src={p.src} alt={p.alt} loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="kw-video-section">
    <div class="kw-inner">
      <h2 class="kw-gallery-heading">In Motion</h2>
      <div class="kw-video-wrap">
        <video controls playsinline preload="metadata" class="kw-video">
          <source src="/images/events/kabuohan/kabuohan-event.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>

  <section class="kw-quote-section">
    <div class="kw-inner">
      <blockquote class="kw-quote">
        "We are not separate from the living world. We are participants in it. The same Earth that grows food also becomes clay, forests, homes, and eventually us. To care for the Earth is to care for ourselves and one another."
      </blockquote>
      <p class="kw-quote-credit">Closing reflection, Kabuohan Workshop · June 25, 2026</p>
    </div>
  </section>

  <section class="kw-credit-section">
    <div class="kw-inner">
      <p class="kw-credit-text">Workshop by <strong>Baganihan Collective</strong> · Held at <strong>Rizal Art House</strong> · Photos by Ro.S.E.</p>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.kw-inner { max-width: 1100px; margin: 0 auto; padding: 0 40px; }

.kw-back-bar { padding: 14px 0; border-bottom: 1px solid #eee; background: #fff; }
.kw-back { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-inter); font-size: 0.8rem; font-weight: 600; color: #666; transition: color 0.15s; }
.kw-back:hover { color: var(--color-primary); }

.kw-hero { position: relative; height: 480px; overflow: hidden; }
.kw-hero-img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
.kw-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.1) 100%); }
.kw-hero-text { position: absolute; bottom: 40px; left: 0; right: 0; padding: 0 40px; max-width: 1100px; margin: 0 auto; }
.kw-eyebrow { display: block; font-family: var(--font-inter); font-size: 0.7rem; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: rgba(255,255,255,0.6); margin-bottom: 10px; }
.kw-title { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 500; color: #fff; line-height: 1.1; margin-bottom: 10px; }
.kw-subtitle { font-family: var(--font-lora); font-size: 1rem; font-style: italic; color: rgba(255,255,255,0.65); max-width: 540px; }

.kw-meta-bar { background: var(--color-primary); padding: 20px 0; }
.kw-meta-row { display: flex; align-items: center; gap: 0; flex-wrap: wrap; }
.kw-meta-item { display: flex; flex-direction: column; gap: 3px; padding: 8px 28px 8px 0; }
.kw-meta-label { font-family: var(--font-inter); font-size: 0.65rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.45); }
.kw-meta-value { font-family: var(--font-inter); font-size: 0.85rem; font-weight: 600; color: #fff; }
.kw-meta-divider { width: 1px; height: 32px; background: rgba(255,255,255,0.15); margin-right: 28px; flex-shrink: 0; }

.kw-body-section { padding: 64px 0; background: #fff; }
.kw-body-grid { display: grid; grid-template-columns: 1fr 340px; gap: 60px; align-items: start; }
.kw-writeup { display: flex; flex-direction: column; gap: 18px; }
.kw-lead { font-family: var(--font-lora); font-size: 1.1rem; line-height: 1.75; color: #242424; }
.kw-writeup p { font-family: var(--font-lora); font-size: 0.95rem; line-height: 1.8; color: #444; }

.kw-pedagogy { background: var(--color-light-section); border-radius: 12px; padding: 28px; border-left: 3px solid var(--color-primary); }
.kw-section-label { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--color-primary); margin-bottom: 16px; }
.kw-section-label--gap { margin-top: 24px; }
.kw-principles { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
.kw-principles li { font-family: var(--font-lora); font-size: 0.9rem; color: #333; padding-left: 16px; position: relative; }
.kw-principles li::before { content: '·'; position: absolute; left: 0; color: var(--color-primary); font-size: 1.1em; }
.kw-kaginhawaan { font-family: var(--font-lora); font-size: 0.85rem; line-height: 1.65; color: #555; border-top: 1px solid #ddd; padding-top: 16px; margin-top: 4px; }

.kw-outline-section { background: #f9f9f7; padding: 64px 0; border-top: 1px solid #eee; }
.kw-outline-header { margin-bottom: 32px; }
.kw-outline-sub { font-family: var(--font-lora); font-size: 0.9rem; font-style: italic; color: #777; margin-top: 6px; }
.kw-outline-list { border-top: 1px solid #e0e0e0; }
.kw-outline-item { display: grid; grid-template-columns: 48px 1fr; gap: 24px; padding: 22px 0; border-bottom: 1px solid #e0e0e0; align-items: start; }
.kw-outline-num { font-family: var(--font-inter); font-size: 0.72rem; font-weight: 700; color: var(--color-primary); letter-spacing: 1px; padding-top: 2px; }
.kw-outline-content { display: flex; flex-direction: column; gap: 6px; }
.kw-outline-row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.kw-outline-title { font-family: var(--font-inter); font-size: 0.88rem; font-weight: 700; color: #242424; }
.kw-outline-time { font-family: var(--font-inter); font-size: 0.72rem; font-weight: 600; color: #aaa; white-space: nowrap; }
.kw-outline-desc { font-family: var(--font-lora); font-size: 0.85rem; line-height: 1.65; color: #555; margin: 0; }

.kw-gallery-section { background: #f9f9f7; padding: 56px 0; }
.kw-gallery-heading { font-family: var(--font-serif); font-size: 1.6rem; font-weight: 500; color: #242424; margin-bottom: 28px; }
.kw-gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.kw-photo { aspect-ratio: 3/4; overflow: hidden; border-radius: 8px; background: #e8e8e8; }
.kw-photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease; }
.kw-photo:hover img { transform: scale(1.04); }

.kw-video-section { background: #fff; padding: 56px 0; }
.kw-video-wrap { border-radius: 12px; overflow: hidden; background: #000; max-width: 720px; }
.kw-video { width: 100%; display: block; }

.kw-quote-section { background: var(--color-primary); padding: 64px 0; }
.kw-quote { font-family: var(--font-serif); font-size: clamp(1.3rem, 2.5vw, 1.9rem); font-weight: 400; font-style: italic; color: #fff; line-height: 1.55; max-width: 780px; margin: 0 auto 20px; text-align: center; }
.kw-quote-credit { font-family: var(--font-inter); font-size: 0.75rem; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,255,255,0.4); text-align: center; }

.kw-credit-section { background: #f9f9f7; padding: 20px 0; border-top: 1px solid #eee; }
.kw-credit-text { font-family: var(--font-inter); font-size: 0.78rem; color: #999; text-align: center; }
.kw-credit-text strong { color: #555; }

@media (max-width: 900px) {
  .kw-body-grid { grid-template-columns: 1fr; gap: 36px; }
  .kw-gallery { grid-template-columns: repeat(2, 1fr); }
  .kw-meta-row { gap: 0; }
}
@media (max-width: 600px) {
  .kw-inner { padding: 0 20px; }
  .kw-hero { height: 340px; }
  .kw-hero-text { bottom: 24px; padding: 0 20px; }
  .kw-gallery { grid-template-columns: 1fr; }
  .kw-meta-divider { display: none; }
  .kw-meta-item { padding: 6px 0; width: 50%; }
  .kw-outline-item { grid-template-columns: 36px 1fr; gap: 16px; }
}
</style>
