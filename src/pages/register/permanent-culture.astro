---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Register — Permanent Culture in Times of Disruption</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;600;700&display=swap');

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: #080f08;
    min-height: 100vh;
    font-family: 'Inter', sans-serif;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 40px 20px 60px;
  }

  body::before {
    content: '';
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(ellipse 800px 600px at 10% 20%, rgba(16,80,20,0.18) 0%, transparent 70%),
      radial-gradient(ellipse 600px 500px at 90% 80%, rgba(200,162,74,0.08) 0%, transparent 70%);
  }

  .wrap { position: relative; z-index: 1; width: 100%; max-width: 560px; }

  .eyebrow { text-align: center; margin-bottom: 28px; }
  .eyebrow-tag {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 10px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase;
    color: #C8A24A; padding: 6px 16px;
    border: 1px solid rgba(200,162,74,0.3); border-radius: 50px;
    background: rgba(200,162,74,0.06);
  }
  .eyebrow-dot { width: 5px; height: 5px; border-radius: 50%; background: #C8A24A; flex-shrink: 0; }

  .card { background: #0e1a0e; border: 1px solid rgba(200,162,74,0.18); border-radius: 16px; overflow: hidden; box-shadow: 0 24px 80px rgba(0,0,0,0.6); }

  .card-header { padding: 36px 40px 28px; border-bottom: 1px solid rgba(255,255,255,0.06); position: relative; overflow: hidden; }
  .card-header::after { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at top right, rgba(200,162,74,0.07) 0%, transparent 60%); pointer-events: none; }

  .presented-by { font-size: 10px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: rgba(200,162,74,0.6); margin-bottom: 16px; }
  .event-title { font-family: 'Lora', serif; font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: #F5EDD8; line-height: 1.2; letter-spacing: -0.02em; margin-bottom: 8px; }
  .event-subtitle { font-family: 'Lora', serif; font-size: 0.9rem; font-style: italic; color: rgba(245,237,216,0.45); margin-bottom: 20px; }
  .event-meta { display: flex; flex-wrap: wrap; gap: 10px; }
  .meta-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; color: rgba(245,237,216,0.7); background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 50px; padding: 5px 12px; }
  .meta-pill svg { flex-shrink: 0; color: #C8A24A; }

  .speaker-strip { display: flex; align-items: center; gap: 12px; padding: 16px 40px; background: rgba(200,162,74,0.05); border-bottom: 1px solid rgba(255,255,255,0.06); }
  .speaker-avatar { width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0; background: linear-gradient(135deg, #C47A52, #C8A24A); display: flex; align-items: center; justify-content: center; font-family: 'Lora', serif; font-size: 1rem; font-weight: 700; color: #0d0d08; box-shadow: 0 0 12px rgba(200,162,74,0.3); }
  .speaker-info { display: flex; flex-direction: column; gap: 2px; }
  .speaker-label { font-size: 9px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #C8A24A; }
  .speaker-name { font-size: 13px; font-weight: 600; color: #F5EDD8; }

  .card-body { padding: 36px 40px 40px; }

  .form-group { margin-bottom: 20px; }
  label { display: block; font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(245,237,216,0.45); margin-bottom: 8px; }
  input[type="text"], input[type="email"] { width: 100%; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 13px 16px; font-family: 'Inter', sans-serif; font-size: 14px; color: #F5EDD8; transition: border-color 0.2s, background 0.2s; outline: none; -webkit-appearance: none; }
  input[type="text"]:focus, input[type="email"]:focus { border-color: rgba(200,162,74,0.5); background: rgba(200,162,74,0.04); }
  input::placeholder { color: rgba(245,237,216,0.2); }

  .checkbox-wrap { display: flex; align-items: flex-start; gap: 12px; padding: 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 10px; cursor: pointer; margin-bottom: 28px; }
  .checkbox-wrap input[type="checkbox"] { width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px; accent-color: #C8A24A; cursor: pointer; }
  .checkbox-text { font-size: 12px; line-height: 1.6; color: rgba(245,237,216,0.5); }
  .checkbox-text strong { color: rgba(245,237,216,0.75); font-weight: 600; }

  .btn-submit { width: 100%; background: linear-gradient(135deg, #C8A24A, #DDB860); color: #0d0d08; border: none; border-radius: 10px; padding: 16px 28px; font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 700; letter-spacing: 0.5px; cursor: pointer; transition: all 0.22s ease; display: flex; align-items: center; justify-content: center; gap: 8px; }
  .btn-submit:hover { transform: translateY(-1px); box-shadow: 0 6px 24px rgba(200,162,74,0.4); }
  .btn-submit:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

  .state { display: none; }
  .state.visible { display: block; }

  #loading-state { text-align: center; padding: 20px 0 8px; color: rgba(245,237,216,0.45); font-size: 13px; letter-spacing: 0.5px; }

  #success-state { text-align: center; padding: 16px 0; }
  .success-icon { width: 56px; height: 56px; border-radius: 50%; background: rgba(74,222,128,0.12); border: 1px solid rgba(74,222,128,0.3); display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 1.4rem; }
  #success-state h3 { font-family: 'Lora', serif; font-size: 1.3rem; font-weight: 700; color: #F5EDD8; margin-bottom: 10px; }
  #success-state p { font-size: 13px; color: rgba(245,237,216,0.5); line-height: 1.65; max-width: 340px; margin: 0 auto; }

  #error-msg { color: #f87171; font-size: 12px; text-align: center; padding: 10px; margin-top: 12px; background: rgba(248,113,113,0.08); border-radius: 8px; border: 1px solid rgba(248,113,113,0.2); display: none; }

  .card-footer { padding: 16px 40px; border-top: 1px solid rgba(255,255,255,0.05); text-align: center; }
  .card-footer p { font-size: 11px; color: rgba(255,255,255,0.2); letter-spacing: 0.5px; }

  @media (max-width: 500px) {
    body { padding: 20px 12px 40px; }
    .card-header, .card-body, .card-footer { padding-left: 24px; padding-right: 24px; }
    .speaker-strip { padding-left: 24px; padding-right: 24px; }
  }
</style>
</head>
<body>
<div class="wrap">
  <div class="eyebrow">
    <span class="eyebrow-tag">
      <span class="eyebrow-dot"></span>
      Baganihan Collective · Mycelium Learning
    </span>
  </div>
  <div class="card">
    <div class="card-header">
      <p class="presented-by">Upcoming Talk</p>
      <h1 class="event-title">Permanent Culture in Times of Disruption</h1>
      <p class="event-subtitle">Why Permaculturists Need to Think Beyond Food</p>
      <div class="event-meta">
        <span class="meta-pill">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5"/><path d="M8 4.5V8.5L10.5 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          8:00 PM PHT
        </span>
        <span class="meta-pill">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><rect x="2" y="3" width="12" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M5 1v3M11 1v3M2 7h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
          Friday, June 26, 2026
        </span>
        <span class="meta-pill">
          <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="7" r="3" stroke="currentColor" stroke-width="1.4"/><path d="M8 1C5 1 2.5 3.5 2.5 7c0 5 5.5 8 5.5 8s5.5-3 5.5-8C13.5 3.5 11 1 8 1z" stroke="currentColor" stroke-width="1.4"/></svg>
          Online · Free
        </span>
      </div>
    </div>
    <div class="speaker-strip">
      <div class="speaker-avatar">H</div>
      <div class="speaker-info">
        <span class="speaker-label">Speaker</span>
        <span class="speaker-name">Hubert Posadas</span>
      </div>
      <div style="margin-left:auto;font-size:11px;color:rgba(245,237,216,0.3);font-style:italic;">Permaculture Aid Specialist</div>
    </div>
    <div class="card-body">
      <div id="form-state" class="state visible">
        <form id="reg-form" onsubmit="handleSubmit(event)">
          <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" placeholder="Juan dela Cruz" required autocomplete="name" />
          </div>
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="you@email.com" required autocomplete="email" />
          </div>
          <label class="checkbox-wrap" style="cursor:pointer;">
            <input type="checkbox" id="newsletter" name="newsletter" checked />
            <span class="checkbox-text">
              <strong>Keep me in the loop.</strong> I'd like to receive updates about upcoming Mycelium Learning events and community talks.
            </span>
          </label>
          <button type="submit" class="btn-submit" id="submit-btn">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Reserve My Spot
          </button>
          <div id="error-msg"></div>
        </form>
      </div>
      <div id="loading-state" class="state">Registering you...</div>
      <div id="success-state" class="state">
        <div class="success-icon">✓</div>
        <h3>You're in!</h3>
        <p>Check your email for confirmation. The Google Meet link is included — see you there.</p>
      </div>
    </div>
    <div class="card-footer">
      <p>mycelium-learn.com &nbsp;·&nbsp; Community Sensemaking</p>
    </div>
  </div>
</div>

<script>
async function handleSubmit(e) {
  e.preventDefault();
  const name       = document.getElementById('name').value.trim();
  const email      = document.getElementById('email').value.trim();
  const newsletter = document.getElementById('newsletter').checked;
  const errEl      = document.getElementById('error-msg');
  errEl.style.display = 'none';
  if (!name || !email) return;

  document.getElementById('form-state').classList.remove('visible');
  document.getElementById('loading-state').classList.add('visible');
  document.getElementById('submit-btn').disabled = true;

  try {
    const res = await fetch('/api/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, email, newsletter }),
    });
    const data = await res.json();
    if (data.success) {
      document.getElementById('loading-state').classList.remove('visible');
      document.getElementById('success-state').classList.add('visible');
    } else {
      throw new Error(data.error || 'Unknown error');
    }
  } catch (err) {
    document.getElementById('loading-state').classList.remove('visible');
    document.getElementById('form-state').classList.add('visible');
    document.getElementById('submit-btn').disabled = false;
    errEl.textContent = 'Something went wrong. Please try again or email us at myceliumlearning@gmail.com.';
    errEl.style.display = 'block';
  }
}
</script>
</body>
</html>
