---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Feedback - Mycelium">
  <SiteNav />

  <section class="fb-hero">
    <div class="fb-inner">
      <span class="fb-badge">💬 Share Your Thoughts</span>
      <h1 class="fb-title">Your Feedback Matters to Us</h1>
      <p class="fb-sub">Tell us how we can make your permaculture journey even better</p>
    </div>
  </section>

  <section class="fb-form-section">
    <div class="fb-inner">
      <div class="fb-form-wrap">
        <form class="fb-form" name="feedback" method="POST" action="https://formspree.io/f/myceliumlearning@gmail.com">
          <div class="fb-field">
            <label class="fb-label">Name <span class="fb-required">*</span></label>
            <div class="fb-name-row">
              <div class="fb-name-col">
                <input type="text" name="first-name" class="fb-input" required />
                <span class="fb-sublabel">First</span>
              </div>
              <div class="fb-name-col">
                <input type="text" name="last-name" class="fb-input" required />
                <span class="fb-sublabel">Last</span>
              </div>
            </div>
          </div>

          <div class="fb-field">
            <label class="fb-label" for="fb-email">Email <span class="fb-required">*</span></label>
            <input type="email" id="fb-email" name="email" class="fb-input" required />
          </div>

          <div class="fb-field">
            <label class="fb-label" for="fb-message">Message <span class="fb-required">*</span></label>
            <textarea id="fb-message" name="message" class="fb-textarea" rows="5" required></textarea>
          </div>

          <button type="submit" class="fb-submit">Submit</button>
        </form>
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.fb-inner { max-width: 800px; margin: 0 auto; padding: 0 40px; }

.fb-hero { background: #F7F7F5; padding: 80px 40px 64px; text-align: center; border-bottom: 1px solid #ebe9e3; }
.fb-badge { display: inline-block; font-family: var(--font-inter); font-size: 1.25rem; color: #242424; background: #fff; border: 0.8px solid #e0e0e0; border-radius: 50px; padding: 8px 20px; margin-bottom: 28px; }
.fb-title { font-family: var(--font-outfit); font-size: 3.75rem; font-weight: 700; color: #242424; line-height: 1.2; letter-spacing: -0.01em; margin-bottom: 16px; }
.fb-sub { font-family: var(--font-outfit); font-size: 1.5rem; color: #666; line-height: 1.5; }

.fb-form-section { background: #fff; padding: 64px 40px 96px; }
.fb-form { display: flex; flex-direction: column; gap: 28px; }
.fb-field { display: flex; flex-direction: column; gap: 6px; }
.fb-label { font-family: var(--font-inter); font-size: 1rem; font-weight: 700; color: rgba(0,0,0,0.85); }
.fb-required { color: #cc2200; }
.fb-name-row { display: flex; gap: 20px; }
.fb-name-col { flex: 1; display: flex; flex-direction: column; gap: 4px; }
.fb-sublabel { font-family: var(--font-inter); font-size: 0.875rem; color: rgba(0,0,0,0.55); }
.fb-input { width: 100%; padding: 12px 14px; font-family: var(--font-inter); font-size: 1rem; color: rgba(0,0,0,0.7); background: #fff; border: 0.8px solid rgba(0,0,0,0.25); border-radius: 4px; outline: none; transition: border-color 0.15s; box-sizing: border-box; }
.fb-input:focus { border-color: #5A3A1C; }
.fb-textarea { width: 100%; padding: 14px; font-family: var(--font-inter); font-size: 1rem; color: rgba(0,0,0,0.7); background: #fff; border: 0.8px solid rgba(0,0,0,0.25); border-radius: 4px; outline: none; resize: vertical; min-height: 120px; transition: border-color 0.15s; box-sizing: border-box; }
.fb-textarea:focus { border-color: #5A3A1C; }
.fb-submit { align-self: flex-start; font-family: var(--font-inter); font-size: 1.0625rem; font-weight: 500; color: #fff; background: #5A3A1C; border: none; border-radius: 4px; padding: 14px 32px; cursor: pointer; transition: background 0.2s; }
.fb-submit:hover { background: #947153; }

@media (max-width: 600px) {
  .fb-hero { padding: 48px 20px 40px; }
  .fb-title { font-size: 2.5rem; }
  .fb-sub { font-size: 1.1rem; }
  .fb-form-section { padding: 40px 20px 64px; }
  .fb-name-row { flex-direction: column; }
  .fb-inner { padding: 0 20px; }
}
</style>
