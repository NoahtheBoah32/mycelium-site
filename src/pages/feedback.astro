---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Feedback - Mycelium">
  <SiteNav />
  <section class="fb-hero">
    <div class="fb-inner">
      <span class="eyebrow">Feedback</span>
      <h1 class="fb-title">Help Us Improve</h1>
      <p class="fb-sub">Your feedback helps Mycelium get better. Share what is working, what is not, and what you would like to see.</p>
      <a href="https://mycelium-learn.com/feedback/" target="_blank" rel="noopener" class="fb-btn">Open Feedback Form</a>
    </div>
  </section>
  <SiteFooter />
</BaseLayout>

<style>
.fb-hero { background: #F7F7F5; min-height: 60vh; display: flex; align-items: center; padding: 80px 40px; }
.fb-inner { max-width: 600px; margin: 0 auto; text-align: center; }
.eyebrow { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: #2F4F2F; margin-bottom: 12px; display: block; }
.fb-title { font-family: var(--font-serif); font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 400; color: #242424; line-height: 1.2; letter-spacing: -0.02em; margin-bottom: 16px; }
.fb-sub { font-family: var(--font-outfit); font-size: 1rem; color: #555; line-height: 1.6; margin-bottom: 32px; }
.fb-btn { display: inline-block; font-family: var(--font-inter); font-size: 1rem; font-weight: 500; background: #5A3A1C; color: #fff; padding: 12px 28px; border-radius: 50px; transition: background 0.2s; text-decoration: none; }
.fb-btn:hover { background: #947153; }
</style>
