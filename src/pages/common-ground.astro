---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Common Ground — Mycelium" description="A community sensemaking space for Mycelium. Coming soon.">
  <SiteNav />

  <div id="cg-gate">
    <!-- Floating spore particles -->
    <div class="cg-particles" aria-hidden="true">
      {Array.from({length: 18}).map((_, i) => (
        <div class="cg-spore" style={`--d:${(i*37+13)%360}deg;--s:${0.4+((i*17)%60)/100};--t:${8+(i*3.7)%14}s;--del:${(i*1.3)%7}s;left:${(i*13+7)%95}%;top:${(i*17+11)%90}%`}></div>
      ))}
    </div>

    <!-- Glassmorphic card -->
    <div class="cg-card">
      <div class="cg-badge">Community Sensemaking</div>
      <h1 class="cg-title" id="cg-title">Common Ground</h1>
      <p class="cg-sub">A space for the Mycelium community to share perspectives, surface shared values, and understand where we see things differently.</p>
      <div class="cg-divider"></div>
      <div class="cg-coming">
        <span class="cg-dot"></span>
        Coming soon
      </div>
      <p class="cg-note">We're calibrating the map before we open the floor.</p>
    </div>

    <!-- Subtle network lines SVG -->
    <svg class="cg-net" viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <g stroke="rgba(200,162,74,0.15)" stroke-width="0.8" fill="none">
        <line x1="0" y1="120" x2="200" y2="80"/><line x1="200" y1="80" x2="340" y2="180"/>
        <line x1="340" y1="180" x2="500" y2="90"/><line x1="500" y1="90" x2="680" y2="160"/>
        <line x1="680" y1="160" x2="800" y2="110"/><line x1="200" y1="80" x2="260" y2="260"/>
        <line x1="340" y1="180" x2="420" y2="340"/><line x1="500" y1="90" x2="540" y2="280"/>
        <line x1="260" y1="260" x2="420" y2="340"/><line x1="420" y1="340" x2="540" y2="280"/>
        <line x1="540" y1="280" x2="680" y2="160"/><line x1="260" y1="260" x2="140" y2="380"/>
        <line x1="140" y1="380" x2="300" y2="440"/><line x1="300" y1="440" x2="460" y2="420"/>
        <line x1="460" y1="420" x2="620" y2="460"/><line x1="620" y1="460" x2="760" y2="390"/>
      </g>
      <g fill="rgba(200,162,74,0.35)">
        <circle cx="200" cy="80" r="2.5" class="cg-node"/>
        <circle cx="340" cy="180" r="2" class="cg-node" style="animation-delay:1.2s"/>
        <circle cx="500" cy="90" r="2.5" class="cg-node" style="animation-delay:2.4s"/>
        <circle cx="680" cy="160" r="2" class="cg-node" style="animation-delay:0.8s"/>
        <circle cx="260" cy="260" r="2" class="cg-node" style="animation-delay:3.1s"/>
        <circle cx="420" cy="340" r="2.5" class="cg-node" style="animation-delay:1.8s"/>
        <circle cx="540" cy="280" r="2" class="cg-node" style="animation-delay:0.5s"/>
        <circle cx="140" cy="380" r="2" class="cg-node" style="animation-delay:2.8s"/>
        <circle cx="300" cy="440" r="2.5" class="cg-node" style="animation-delay:1.5s"/>
        <circle cx="620" cy="460" r="2" class="cg-node" style="animation-delay:3.6s"/>
      </g>
    </svg>
  </div>

  <SiteFooter />
</BaseLayout>

<script>
  // Check unlock state
  const params = new URLSearchParams(window.location.search);
  if (params.get('preview') === 'mycelium') {
    localStorage.setItem('cg_dev', '1');
    window.location.replace('/common-ground-app.html');
  } else if (localStorage.getItem('cg_dev') === '1') {
    window.location.replace('/common-ground-app.html');
  }

  // Secret unlock: click the title 5 times within 3 seconds
  const title = document.getElementById('cg-title');
  let clicks = 0;
  let timer: ReturnType<typeof setTimeout> | null = null;

  title?.addEventListener('click', () => {
    clicks++;
    if (timer) clearTimeout(timer);
    timer = setTimeout(() => { clicks = 0; }, 3000);

    if (clicks >= 5) {
      clicks = 0;
      title.style.transition = 'opacity 0.3s';
      title.style.opacity = '0.3';
      setTimeout(() => {
        localStorage.setItem('cg_dev', '1');
        window.location.replace('/common-ground-app.html');
      }, 300);
    }
  });
</script>

<style>
  @keyframes cgFloat {
    0%, 100% { transform: translate(0, 0) scale(var(--s)); opacity: 0.4; }
    50% { transform: translate(calc(sin(var(--d)) * 20px), calc(cos(var(--d)) * 20px)) scale(calc(var(--s) * 1.3)); opacity: 0.85; }
  }
  @keyframes cgNodePulse {
    0%, 100% { opacity: 0.35; r: 2; }
    50% { opacity: 1; r: 3.5; }
  }

  #cg-gate {
    position: relative;
    min-height: calc(100vh - 64px);
    background: #060504;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 24px;
    overflow: hidden;
  }

  /* Background image */
  #cg-gate::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/cg-bg.jpg') center center / cover no-repeat;
    opacity: 0.35;
    filter: saturate(0.7);
  }

  /* Gradient overlay — darker at edges, lighter in center-bottom */
  #cg-gate::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 40%, rgba(6,5,4,0.1) 0%, rgba(6,5,4,0.72) 100%),
      linear-gradient(to bottom, rgba(6,5,4,0.6) 0%, rgba(6,5,4,0.2) 40%, rgba(6,5,4,0.55) 100%);
  }

  /* Floating spore particles */
  .cg-particles { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
  .cg-spore {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: radial-gradient(circle, #C8A24A 0%, rgba(200,162,74,0) 70%);
    animation: cgFloat var(--t) ease-in-out var(--del) infinite;
  }

  /* SVG network */
  .cg-net {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .cg-node {
    animation: cgNodePulse 4s ease-in-out infinite;
  }

  /* Glassmorphic card */
  .cg-card {
    position: relative;
    z-index: 2;
    max-width: 560px;
    width: 100%;
    text-align: center;
    padding: 56px 48px 48px;
    background: rgba(10, 8, 5, 0.52);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border-radius: 20px;
    border: 1px solid rgba(200, 162, 74, 0.18);
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.04) inset,
      0 32px 80px rgba(0,0,0,0.6),
      0 0 120px rgba(200,162,74,0.06);
  }

  .cg-badge {
    font-family: var(--font-inter);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #C8A24A;
    margin-bottom: 20px;
  }

  .cg-title {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 4.8rem);
    font-weight: 400;
    color: #F6EFE1;
    line-height: 1.0;
    letter-spacing: -0.025em;
    margin-bottom: 20px;
    cursor: default;
    user-select: none;
  }

  .cg-sub {
    font-family: var(--font-inter);
    font-size: 0.94rem;
    color: rgba(210, 200, 185, 0.62);
    line-height: 1.75;
    margin-bottom: 36px;
  }

  .cg-divider {
    width: 48px;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(200,162,74,0.5), transparent);
    margin: 0 auto 32px;
  }

  .cg-coming {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-inter);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(246, 239, 225, 0.9);
    background: rgba(95, 125, 79, 0.18);
    border: 1px solid rgba(95, 125, 79, 0.35);
    padding: 9px 22px;
    border-radius: 50px;
    margin-bottom: 18px;
  }

  .cg-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #5f7d4f;
    box-shadow: 0 0 8px rgba(95,125,79,0.9);
    animation: cgNodePulse 2s ease-in-out infinite;
  }

  .cg-note {
    font-family: var(--font-inter);
    font-size: 0.78rem;
    color: rgba(210, 200, 185, 0.32);
    letter-spacing: 0.02em;
  }

  @media (max-width: 600px) {
    .cg-card { padding: 40px 28px 36px; }
  }
</style>
