---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
---

<BaseLayout title="Common Ground — Mycelium" description="A community sensemaking space for Mycelium. Coming soon.">
  <SiteNav />

  <div id="cg-gate">

    <!-- Photo background -->
    <div class="cg-photo"></div>

    <!-- Animated color blobs -->
    <div class="cg-blobs" aria-hidden="true">
      <div class="cg-blob cg-blob-1"></div>
      <div class="cg-blob cg-blob-2"></div>
      <div class="cg-blob cg-blob-3"></div>
    </div>

    <!-- Vignette -->
    <div class="cg-vignette"></div>

    <!-- Main card -->
    <div class="cg-card" id="cg-card">
      <div class="cg-badge">Community Sensemaking</div>

      <h1 class="cg-title">
        <span class="cg-word cg-word-1">Common</span>
        <span class="cg-word cg-word-2">Ground</span>
      </h1>

      <p class="cg-sub">A space for the Mycelium community to share perspectives, surface shared values, and understand where we see things differently.</p>

      <div class="cg-divider"></div>

      <div class="cg-bottom">
        <div class="cg-coming">
          <span class="cg-dot"></span>
          Coming soon
        </div>
        <p class="cg-note">We're calibrating the map before we open the floor.</p>
      </div>
    </div>

  </div>

</BaseLayout>

<!-- GSAP -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

<script>
  // ── Dev unlock ──────────────────────────────────────────────────
  function launchApp() {
    const gate = document.getElementById('cg-gate');
    const iframe = document.createElement('iframe');
    iframe.src = '/cg-shell.html';
    iframe.style.cssText = 'position:fixed;inset:0;width:100%;height:100%;border:none;z-index:9999;background:#1a1208;';
    document.body.appendChild(iframe);
    iframe.addEventListener('load', () => {
      if (gate) {
        gsap.to(gate, { opacity: 0, duration: 0.5, onComplete: () => gate.style.display = 'none' });
      }
    });
  }

  if (localStorage.getItem('cg_dev') === '1') launchApp();

  let clicks = 0, resetTimer: ReturnType<typeof setTimeout> | null = null;
  document.getElementById('cg-card')?.addEventListener('click', () => {
    clicks++;
    if (resetTimer) clearTimeout(resetTimer);
    resetTimer = setTimeout(() => { clicks = 0; }, 3000);
    if (clicks >= 5) {
      clicks = 0;
      localStorage.setItem('cg_dev', '1');
      launchApp();
    }
  });

  // ── Entrance animation ───────────────────────────────────────────
  window.addEventListener('load', () => {
    const gsap = (window as any).gsap;
    if (!gsap) return;

    // Continuous blob drift
    gsap.to('.cg-blob-1', { x: 60, y: -40, duration: 7, repeat: -1, yoyo: true, ease: 'sine.inOut' });
    gsap.to('.cg-blob-2', { x: -70, y: 50, duration: 9, repeat: -1, yoyo: true, ease: 'sine.inOut', delay: 1.5 });
    gsap.to('.cg-blob-3', { x: 50, y: 30, duration: 8, repeat: -1, yoyo: true, ease: 'sine.inOut', delay: 3 });

    // Entrance timeline
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    tl.from('.cg-photo', { opacity: 0, duration: 1.0 })
      .from('.cg-blob', { scale: 0, opacity: 0, duration: 1.2, stagger: 0.15 }, '-=0.6')
      .from('#cg-card', { y: 50, opacity: 0, duration: 0.85, scale: 0.96 }, '-=0.5')
      .from('.cg-badge', { y: 16, opacity: 0, duration: 0.55 }, '-=0.3')
      .from('.cg-word-1', { x: -50, opacity: 0, duration: 0.7, filter: 'blur(6px)' }, '-=0.25')
      .from('.cg-word-2', { x: 50, opacity: 0, duration: 0.7, filter: 'blur(6px)' }, '-=0.6')
      .from('.cg-sub', { y: 18, opacity: 0, duration: 0.6 }, '-=0.1')
      .from('.cg-divider', { scaleX: 0, duration: 0.5, transformOrigin: 'center' }, '-=0.2')
      .from('.cg-coming', { y: 16, opacity: 0, scale: 0.88, duration: 0.55, ease: 'back.out(2)' }, '-=0.1')
      .from('.cg-note', { opacity: 0, duration: 0.5 }, '-=0.05');
  });
</script>

<style>
  @keyframes dotPulse {
    0%, 100% { opacity: 0.5; transform: scale(1); box-shadow: 0 0 6px rgba(97,206,112,0.6); }
    50% { opacity: 1; transform: scale(1.3); box-shadow: 0 0 14px rgba(97,206,112,1); }
  }

  #cg-gate {
    position: relative;
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 24px;
    overflow: hidden;
    background: #060e08;
  }

  /* Aerial forest photo */
  .cg-photo {
    position: absolute;
    inset: 0;
    background: url('/images/cg-bg.jpg') center / cover no-repeat;
    opacity: 0.55;
  }

  /* Animated color blobs */
  .cg-blobs {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .cg-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    mix-blend-mode: screen;
    will-change: transform;
  }
  .cg-blob-1 {
    width: 420px; height: 420px;
    background: radial-gradient(circle, rgba(61,138,78,0.75) 0%, transparent 70%);
    top: -80px; left: 5%;
  }
  .cg-blob-2 {
    width: 380px; height: 380px;
    background: radial-gradient(circle, rgba(200,162,74,0.65) 0%, transparent 70%);
    bottom: -60px; right: 8%;
  }
  .cg-blob-3 {
    width: 340px; height: 340px;
    background: radial-gradient(circle, rgba(13,122,111,0.6) 0%, transparent 70%);
    top: 30%; right: 15%;
  }

  /* Edge vignette */
  .cg-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 110% 110% at 50% 50%, transparent 30%, rgba(4,10,6,0.85) 100%);
    pointer-events: none;
  }

  /* Glass card */
  .cg-card {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 580px;
    padding: 56px 52px 50px;
    text-align: center;
    background: rgba(5, 18, 10, 0.48);
    backdrop-filter: blur(32px);
    -webkit-backdrop-filter: blur(32px);
    border-radius: 24px;
    border: 1px solid rgba(97, 206, 112, 0.2);
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.05) inset,
      0 40px 100px rgba(0,0,0,0.55),
      0 0 80px rgba(61,138,78,0.12),
      0 0 200px rgba(200,162,74,0.06);
    cursor: default;
  }

  .cg-badge {
    display: inline-block;
    font-family: var(--font-inter);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #61CE70;
    margin-bottom: 22px;
    opacity: 0.9;
  }

  .cg-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-family: var(--font-serif);
    font-size: clamp(3.4rem, 8vw, 5.5rem);
    font-weight: 300;
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
  }
  .cg-word-1 {
    color: #F6EFE1;
  }
  .cg-word-2 {
    color: #C8A24A;
    font-style: italic;
  }

  .cg-sub {
    font-family: var(--font-inter);
    font-size: 0.93rem;
    line-height: 1.75;
    color: rgba(220, 212, 196, 0.65);
    margin-bottom: 34px;
  }

  .cg-divider {
    width: 56px;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(97,206,112,0.5), rgba(200,162,74,0.5), transparent);
    margin: 0 auto 32px;
  }

  .cg-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .cg-coming {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-inter);
    font-size: 0.71rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(246, 239, 225, 0.92);
    background: rgba(61, 138, 78, 0.14);
    border: 1px solid rgba(97, 206, 112, 0.28);
    padding: 10px 24px;
    border-radius: 50px;
  }
  .cg-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #61CE70;
    animation: dotPulse 2.2s ease-in-out infinite;
    flex-shrink: 0;
  }

  .cg-note {
    font-family: var(--font-inter);
    font-size: 0.77rem;
    color: rgba(210, 200, 185, 0.3);
    letter-spacing: 0.02em;
    margin: 0;
  }

  @media (max-width: 600px) {
    .cg-card { padding: 40px 28px 36px; }
  }
</style>
