/* ─── Card: Workshop — botanical bg + 3-col glass ───────── */
.ev-card-workshop {
  position: relative; isolation: isolate;
  min-height: 480px; border-radius: 16px; overflow: hidden;
  background: #1A1C0A;
}

/* Full-bleed botanical photo */
.ev-ws-botanical-bg {
  position: absolute; inset: 0; width: 100%; height: 100%;
  object-fit: cover; object-position: center 55%;
  display: block; pointer-events: none;
}

/* Dark scrim so glass panels read cleanly */
.ev-ws-botanical-overlay {
  position: absolute; inset: 0;
  background: rgba(10,9,3,0.62);
  pointer-events: none;
}

/* 3-col content grid */
.ev-ws-content {
  position: relative; z-index: 1;
  display: grid; grid-template-columns: 180px 248px 1fr;
  min-height: 480px; padding: 24px; gap: 20px; align-items: stretch;
}

/* ── Left glass: date + time + QR ── */
