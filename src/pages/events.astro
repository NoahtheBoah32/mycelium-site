    <div class="ev-section-inner">

      <div class="ev-label-row">
        <span class="ev-label-line"></span>
        <span class="ev-label-text">FIND AN EVENT</span>
        <span class="ev-label-line"></span>
      </div>

      <!-- Card 1: Perma-Kapihan -->
      <div class="ev-card ev-card-kapihan">
        <div class="ev-card-body">
          <div class="ev-card-badge-row">
            <span class="ev-badge ev-badge-recurring">↺ RECURRING</span>
            <span class="ev-badge ev-badge-free">FREE ENTRY</span>
            <span class="ev-badge ev-badge-location">📍 Marikina</span>
          </div>
          <p class="ev-card-schedule">Every Sunday · Except Last Sunday of Month</p>
          <h2 class="ev-card-title">Perma-Kapihan<br><em>sa Eco-house</em></h2>
          <p class="ev-card-desc">An informal Sunday gathering where permaculture enthusiasts connect over coffee, share ideas, and explore how design principles shape the way we live. Open to all — beginners welcome.</p>

          <div class="ev-card-details">
            <div class="ev-detail">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.4"/><path d="M8 4.5V8.5L10.5 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              <span>10:00 AM – 2:00 PM</span>
            </div>
            <div class="ev-detail">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1.5C5.5 1.5 3.5 3.5 3.5 6c0 3.5 4.5 8.5 4.5 8.5S12.5 9.5 12.5 6c0-2.5-2-4.5-4.5-4.5z" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="6" r="1.5" stroke="currentColor" stroke-width="1.2"/></svg>
              <span>PPA Eco-house, Hereford St., Marikina</span>
            </div>
            <div class="ev-detail">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 6h12M5 1v2M11 1v2M3 3h10a1 1 0 011 1v9a1 1 0 01-1 1H3a1 1 0 01-1-1V4a1 1 0 011-1z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              <span>Free Coffee &amp; Snacks · Bring merienda to share (optional)</span>
            </div>
          </div>

          <a href="https://mycelium-learn.com/events/" target="_blank" rel="noopener" class="ev-cta ev-cta-primary">
            Register Here
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <div class="ev-card-img-wrap">
          <img src="https://mycelium-learn.com/wp-content/uploads/2026/03/event-Perma-Kapihan-sa-Eco-house.webp" alt="Perma-Kapihan sa Eco-house" loading="lazy" />
          <div class="ev-card-img-overlay"></div>
          <div class="ev-card-img-tag">
            <span class="ev-img-tag-num">☕</span>
            <span class="ev-img-tag-label">Weekly Gathering</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Permaculture Camp 2026 -->
      <div class="ev-card ev-card-camp">
        <div class="ev-camp-bg">
          <img src="https://mycelium-learn.com/wp-content/uploads/2026/02/event-cs1.webp" alt="" loading="lazy" class="ev-camp-bg-img" />
          <div class="ev-camp-overlay"></div>
        </div>

        <div class="ev-camp-content">
          <div class="ev-camp-left">
            <div class="ev-camp-date-block">
              <span class="ev-camp-month-label">MAY 2026</span>
              <span class="ev-camp-days-big">1—3</span>
              <span class="ev-camp-dow-label">THU — SAT</span>
            </div>
            <div class="ev-camp-meta-block">
              <div class="ev-camp-meta-item">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 1.5C5.5 1.5 3.5 3.5 3.5 6c0 3.5 4.5 8.5 4.5 8.5S12.5 9.5 12.5 6c0-2.5-2-4.5-4.5-4.5z" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="6" r="1.5" stroke="currentColor" stroke-width="1.2"/></svg>
                <span>Ecodee Research Institute<br>Cabiao, Nueva Ecija</span>
              </div>
              <div class="ev-camp-meta-item">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M2 10l4-6 3 4 2-3 3 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Sliding Scale<br><strong>₱800 — ₱3,500</strong></span>
              </div>
              <div class="ev-camp-meta-item">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 2a3 3 0 100 6 3 3 0 000-6zM3 14a5 5 0 0110 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                <span>Limited Slots Available</span>
              </div>
            </div>
          </div>

          <div class="ev-camp-right">
            <div class="ev-camp-tags-row">
              <span class="ev-camp-pill">🏕 Immersive</span>
              <span class="ev-camp-pill">👥 In-Person</span>
              <span class="ev-camp-pill">🌿 Permaculture</span>
            </div>
            <h2 class="ev-camp-title">Permaculture<br><em>Camp 2026</em></h2>
            <p class="ev-camp-org">Philippine Permaculture Association</p>
            <p class="ev-camp-tagline">Swim · Camp · Connect · Grow</p>

            <div class="ev-camp-activities">
              <span class="ev-activity">🏕 Simple camping</span>
              <span class="ev-activity">🌊 Natural pool swim</span>
              <span class="ev-activity">🌲 Forest walk</span>
              <span class="ev-activity">🌿 Permaculture 101</span>
              <span class="ev-activity">🤝 Shared cooking</span>
            </div>

            <a href="https://mycelium-learn.com/events/" target="_blank" rel="noopener" class="ev-cta ev-cta-camp">
              Reserve Your Spot
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Coming Soon -->
  <section class="ev-soon">
    <div class="ev-inner">
      <p class="ev-soon-sub">GOOD THINGS GROW SLOWLY</p>
      <h2 class="ev-soon-title">—Coming Soon—</h2>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.ev-inner { max-width: 1260px; margin: 0 auto; padding: 0 40px; }

/* ─── Hero ──────────────────────────────────────────────── */
.ev-hero {
  background-image: url('https://mycelium-learn.com/wp-content/uploads/2026/02/banner-event.webp');
  background-size: cover; background-position: center;
  background-color: #1a1e1a;
  min-height: 65vh; display: flex; flex-direction: column; justify-content: center;
  padding: calc(72px + 60px) 40px 80px; margin-top: -72px; text-align: center; position: relative;
}
.ev-hero::before { content: ''; position: absolute; inset: 0; background: rgba(10,14,10,0.62); }
.ev-hero .ev-inner { position: relative; z-index: 1; }
.ev-title { font-family: var(--font-outfit); font-size: 1.875rem; font-weight: 700; letter-spacing: -0.01em; color: #D2CEC8; text-transform: none; margin-bottom: 12px; }
.ev-sub { font-family: var(--font-lora); font-size: 1.2rem; font-weight: 700; color: #fff; line-height: 1.5; max-width: 680px; margin: 0 auto; }
.ev-sub-accent { color: #C8A01A; }

/* ─── Events Section ─────────────────────────────────────── */
.ev-section { background: #F4F2EE; padding: 40px 40px 56px; position: relative; overflow: hidden; }
.ev-section-inner { max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; position: relative; z-index: 1; }

/* ─── Vines ──────────────────────────────────────────────── */
.ev-vine { position: absolute; top: 0; bottom: 0; width: 210px; pointer-events: none; z-index: 0; }
.ev-vine svg { width: 100%; height: 100%; }
.ev-vine-left { left: 0; opacity: 0.82; }
.ev-vine-right { right: 0; opacity: 0.82; transform: scaleX(-1); }

.ev-label-row { display: flex; align-items: center; gap: 16px; margin-bottom: 4px; }
.ev-label-line { flex: 1; height: 1px; background: #C8B89A; }
.ev-label-text { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: #8a7a5a; white-space: nowrap; }

/* ─── Card Shell ─────────────────────────────────────────── */
.ev-card { border-radius: 20px; overflow: hidden; box-shadow: 0 8px 40px rgba(0,0,0,0.12); }

/* ─── Card 1: Perma-Kapihan ──────────────────────────────── */
.ev-card-kapihan { display: grid; grid-template-columns: 1fr 420px; min-height: 500px; background: #1C2E18; }

.ev-card-body { padding: 52px 56px; display: flex; flex-direction: column; gap: 0; }

.ev-card-badge-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
.ev-badge { font-family: var(--font-inter); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding: 5px 12px; border-radius: 50px; }
.ev-badge-recurring { background: rgba(200,160,26,0.18); color: #C8A01A; border: 1px solid rgba(200,160,26,0.35); }
.ev-badge-free { background: rgba(97,206,112,0.15); color: #7ae886; border: 1px solid rgba(97,206,112,0.3); }
.ev-badge-location { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.7); border: 1px solid rgba(255,255,255,0.15); }

.ev-card-schedule { font-family: var(--font-inter); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; color: #C8A01A; text-transform: uppercase; margin-bottom: 12px; }

.ev-card-title { font-family: var(--font-lora); font-size: clamp(2rem, 3vw, 2.8rem); font-weight: 400; color: #fff; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 20px; }
.ev-card-title em { font-style: italic; color: #b8d4a8; }

.ev-card-desc { font-family: var(--font-outfit); font-size: 0.95rem; color: rgba(255,255,255,0.7); line-height: 1.7; margin-bottom: 32px; max-width: 480px; }

.ev-card-details { display: flex; flex-direction: column; gap: 10px; margin-bottom: 36px; padding: 20px 24px; background: rgba(255,255,255,0.05); border-radius: 10px; border: 1px solid rgba(255,255,255,0.08); }
.ev-detail { display: flex; align-items: flex-start; gap: 10px; font-family: var(--font-outfit); font-size: 0.875rem; color: rgba(255,255,255,0.75); line-height: 1.45; }
.ev-detail svg { flex-shrink: 0; margin-top: 2px; color: #8aaa7a; }

.ev-cta { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-inter); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.04em; padding: 14px 28px; border-radius: 8px; text-decoration: none; transition: all 0.2s; width: fit-content; }
.ev-cta-primary { background: #C8A01A; color: #1a1400; }
.ev-cta-primary:hover { background: #e0b520; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(200,160,26,0.35); }

.ev-card-img-wrap { position: relative; overflow: hidden; }
.ev-card-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ev-card-img-overlay { position: absolute; inset: 0; background: linear-gradient(to right, #1C2E18 0%, transparent 35%); }
.ev-card-img-tag { position: absolute; bottom: 24px; right: 24px; background: rgba(28,46,24,0.85); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 10px 16px; display: flex; flex-direction: column; align-items: center; gap: 2px; }
.ev-img-tag-num { font-size: 1.4rem; line-height: 1; }
