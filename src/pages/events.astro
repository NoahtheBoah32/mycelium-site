.ev-badge-ws-type { background: rgba(240,194,48,0.15); color: #E8B830; border: 1px solid rgba(240,194,48,0.32); }
.ev-badge-ws-paid { background: rgba(200,120,48,0.15); color: #C87838; border: 1px solid rgba(200,120,48,0.32); }
.ev-badge-ws-loc  { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.52); border: 1px solid rgba(255,255,255,0.14); }
.ev-ws-schedule {
  font-family: var(--font-inter); font-size: 0.72rem; font-weight: 800;
  letter-spacing: 0.16em; text-transform: uppercase; color: #C87838; margin-bottom: 14px;
