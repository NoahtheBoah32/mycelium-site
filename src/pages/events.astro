---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const events = allEvents.sort((a, b) => (a.data.sortOrder ?? 0) - (b.data.sortOrder ?? 0));
---

<BaseLayout title="Events - Mycelium">
  <SiteNav overlay={true} />

  <!-- Hero -->
  <section class="ev-hero">
    <div class="ev-inner">
      <h1 class="ev-title">UPCOMING EVENTS</h1>
      <p class="ev-sub">Community meetups, talks, relaxed conversations over coffee, and exploring permaculture through <span class="ev-sub-accent">ideas and actions</span></p>
    </div>
  </section>

  <!-- Events Section -->
  <section class="ev-section">

    <!-- Generated atmospheric background -->
    <div class="ev-section-bg" aria-hidden="true">
      <img src="/images/events-bg.jpg" alt="" class="ev-section-bg-img" loading="lazy" />
      <div class="ev-section-overlay"></div>
    </div>

    <!-- Vines -->
    <div class="ev-vine ev-vine-top" aria-hidden="true">
      <img src="/images/vine.png" alt="" />
    </div>
    <div class="ev-vine ev-vine-left" aria-hidden="true">
      <img src="/images/vine.png" alt="" />
    </div>
    <div class="ev-vine ev-vine-right" aria-hidden="true">
      <img src="/images/vine.png" alt="" />
    </div>

    <div class="ev-section-inner">

      <div class="ev-label-row">
        <span class="ev-label-line"></span>
        <span class="ev-label-text">FIND AN EVENT</span>
        <span class="ev-label-line"></span>
      </div>

      <!-- Partner filter tabs -->
      <div class="ev-filters" role="group" aria-label="Filter events by partner">
        <button class="ev-filter-btn active" data-filter="all">
          <span class="ev-filter-dot"></span>
          All Events
        </button>
        <button class="ev-filter-btn" data-filter="ppa">
          <img src="/images/wp/about-img-10.webp" alt="" class="ev-filter-logo" />
          Philippine Permaculture Association
        </button>
        <button class="ev-filter-btn" data-filter="baganihan">
          <img src="/images/baganihan-logo.jpg" alt="" class="ev-filter-logo" />
          Baganihan Collective
        </button>
      </div>

      {events.map(ev => {
        const d = ev.data;
        const dateDay = d.date ? d.date.getDate().toString() : '';
        const dateMo = d.date
          ? `${d.date.toLocaleString('en-US', { month: 'short' }).toUpperCase()} ${d.date.getFullYear()}`
          : '';
        const speakerInitial = d.speakerName?.charAt(0) ?? '?';

        if (d.template === 'pdc') return (
          <div class="ev-card ev-card-pdc" data-partner={d.partner || undefined}>
            {/* Left: solid content panel */}
            <div class="ev-pdc-panel">
              <div class="ev-pdc-badges">
                <span class="ev-badge ev-badge-pdc-course">7-DAY COURSE</span>
                {!d.isFree && <span class="ev-badge ev-badge-pdc-paid">PAID</span>}
                {!d.isOnline && <span class="ev-badge ev-badge-pdc-loc">IN PERSON</span>}
              </div>

              {d.schedule && <p class="ev-pdc-schedule">{d.schedule}</p>}
              <h2 class="ev-pdc-title">{d.title}</h2>
              {d.description && <p class="ev-pdc-desc">{d.description}</p>}

              {d.highlights && d.highlights.length > 0 && (
                <ul class="ev-pdc-highlights">
                  {d.highlights.map((h: string) => (
                    <li class="ev-pdc-highlight-item">
                      <span class="ev-pdc-check">✦</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              )}

              {d.notes && <p class="ev-pdc-note">{d.notes}</p>}

              <div class="ev-pdc-footer">
                <div class="ev-pdc-footer-left">
                  {d.organizerLogo && <img src={d.organizerLogo} alt={d.organizer ?? ''} class="ev-pdc-footer-logo" />}
                  <div class="ev-pdc-footer-org">
                    <span class="ev-pdc-presents">PRESENTED BY</span>
                    <span class="ev-pdc-org-name">{d.organizer}</span>
                  </div>
                  {d.location && (
                    <div class="ev-pdc-location">
                      <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M8 1.5C5.5 1.5 3.5 3.5 3.5 6c0 3.5 4.5 8.5 4.5 8.5S12.5 9.5 12.5 6c0-2.5-2-4.5-4.5-4.5z" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="6" r="1.5" stroke="currentColor" stroke-width="1.2"/></svg>
                      <span>{d.location}</span>
                    </div>
                  )}
                </div>
                {d.ctaUrl && (
                  <a href={d.ctaUrl} target="_blank" rel="noopener" class="ev-cta ev-cta-pdc">
                    {d.ctaLabel ?? 'Register Now'}
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </a>
                )}
              </div>
            </div>

            {/* Right: image-only panel */}
            <div class="ev-pdc-img-panel" aria-hidden="true">
              <img src="/images/wp/Mapping-in-Permaculture.jpg" alt="" class="ev-pdc-img" loading="lazy" />
              <div class="ev-pdc-img-fade"></div>
              <div class="ev-pdc-img-date">
                <span class="ev-pdc-img-date-num">{d.dateRange ?? dateDay}</span>
                <span class="ev-pdc-img-date-mo">{dateMo}</span>
              </div>
            </div>
          </div>
        );

        if (d.template === 'kapihan') return (
          <div class="ev-card ev-card-kapihan" data-partner={d.partner || undefined}>
            {d.image && (
              <div class="ev-card-img-wrap ev-kapihan-img">
                <img src={d.image} alt={d.title} loading="lazy" />
                <div class="ev-card-img-overlay ev-kapihan-overlay"></div>
                <div class="ev-card-img-tag">
                  <span class="ev-img-tag-num">☕</span>
                  <span class="ev-img-tag-label">Weekly Gathering</span>
                </div>
              </div>
            )}
            <div class="ev-card-body">
              <div class="ev-card-badge-row">
                {d.isRecurring && <span class="ev-badge ev-badge-recurring">↺ RECURRING</span>}
                {d.isFree && <span class="ev-badge ev-badge-free">FREE ENTRY</span>}
                {d.location && !d.isOnline && <span class="ev-badge ev-badge-location">📍 {d.location.split(',')[0]}</span>}
              </div>
              {d.schedule && <p class="ev-card-schedule">{d.schedule}</p>}
              <h2 class="ev-card-title">{d.title}</h2>
              {d.description && <p class="ev-card-desc">{d.description}</p>}

              <div class="ev-card-details">
                {d.time && (
                  <div class="ev-detail">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.4"/><path d="M8 4.5V8.5L10.5 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                    <span>{d.time}</span>
                  </div>
                )}
                {d.location && (
                  <div class="ev-detail">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1.5C5.5 1.5 3.5 3.5 3.5 6c0 3.5 4.5 8.5 4.5 8.5S12.5 9.5 12.5 6c0-2.5-2-4.5-4.5-4.5z" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="6" r="1.5" stroke="currentColor" stroke-width="1.2"/></svg>
                    <span>{d.location}</span>
                  </div>
                )}
                {d.notes && (
                  <div class="ev-detail">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 6h12M5 1v2M11 1v2M3 3h10a1 1 0 011 1v9a1 1 0 01-1 1H3a1 1 0 01-1-1V4a1 1 0 011-1z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                    <span set:html={d.notes.replace('&', '&amp;')} />
                  </div>
                )}
              </div>

              {d.ctaUrl && (
                <a href={d.ctaUrl} target="_blank" rel="noopener" class="ev-cta ev-cta-primary">
                  {d.ctaLabel ?? 'Learn More'}
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              )}
            </div>
          </div>
        );

        if (d.template === 'workshop') return (
          <div class="ev-card ev-card-workshop" data-partner={d.partner || undefined}>

            {/* Full botanical background */}
            <img src="/images/events/workshop-botanical-bg.jpg" aria-hidden="true" class="ev-ws-botanical-bg" />
            <div class="ev-ws-botanical-overlay" aria-hidden="true"></div>

            {/* 3-column: [date+QR] [poster] [details] */}
            <div class="ev-ws-content">

              {/* Left glass: date + time + QR */}
              <div class="ev-ws-left">
                <div class="ev-ws-left-datebox">
                  <span class="ev-ws-left-label">DATE</span>
                  <span class="ev-ws-left-day">{dateDay}</span>
                  <span class="ev-ws-left-mo">{dateMo}</span>
                </div>
                <div class="ev-ws-left-timebox">
                  <span class="ev-ws-left-label">TIME</span>
                  <span class="ev-ws-left-time">{d.time}</span>
                </div>
                <div class="ev-ws-qr">
                  <img src="/images/events/design-thinking-qr.png" alt="Scan to register" class="ev-ws-qr-img" />
                  <span class="ev-ws-qr-label">SCAN TO REGISTER</span>
                </div>
              </div>

              {/* Center: visible poster */}
              <div class="ev-ws-poster-col">
                <img src="/images/events/design-thinking-bg.jpg" alt="Design Thinking Bootcamp poster" class="ev-ws-poster" />
              </div>

              {/* Right glass: event details */}
              <div class="ev-ws-right">
                <div class="ev-ws-badges">
                  <span class="ev-badge ev-badge-ws-type">WORKSHOP</span>
                  {!d.isFree && <span class="ev-badge ev-badge-ws-paid">PAID</span>}
                  {!d.isOnline && <span class="ev-badge ev-badge-ws-loc">IN PERSON</span>}
                </div>
                {d.schedule && <p class="ev-ws-schedule">{d.schedule}</p>}
                <h2 class="ev-ws-title">{d.title}</h2>
                {d.description && <p class="ev-ws-desc">{d.description}</p>}
                <div class="ev-ws-footer">
                  {d.organizerLogo && <img src={d.organizerLogo} alt={d.organizer ?? ''} class="ev-ws-footer-logo" />}
                  <div class="ev-ws-footer-org">
                    <span class="ev-ws-presents">PRESENTED BY</span>
                    <span class="ev-ws-org-name">{d.organizer}</span>
                  </div>
                  {d.location && (
                    <div class="ev-ws-location">
                      <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M8 1.5C5.5 1.5 3.5 3.5 3.5 6c0 3.5 4.5 8.5 4.5 8.5S12.5 9.5 12.5 6c0-2.5-2-4.5-4.5-4.5z" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="6" r="1.5" stroke="currentColor" stroke-width="1.2"/></svg>
                      <span>{d.location}</span>
                    </div>
                  )}
                </div>
              </div>

            </div>
          </div>
        );

        return (
          <div class="ev-card ev-card-bag" data-partner={d.partner || undefined}>
            {/* Full-bleed editorial hero image */}
            <div class="ev-bag-hero" aria-hidden="true">
              <img src={d.image ?? '/images/events/bag-seed-bg.jpg'} alt="" class="ev-bag-hero-img" loading="lazy" />
              <div class="ev-bag-hero-overlay"></div>
            </div>

            {/* Content floated over image */}
            <div class="ev-bag-content">

              {/* Top row: badges only */}
              <div class="ev-bag-topbar">
                <div class="ev-card-badge-row">
                  {d.isOnline && <span class="ev-badge ev-badge-online">🌐 ONLINE</span>}
                  {d.isFree && <span class="ev-badge ev-badge-free">FREE ENTRY</span>}
                  <span class="ev-badge ev-badge-talk">TALK</span>
                </div>
              </div>

              {/* Main title area */}
              <div class="ev-bag-main">
                {d.schedule && <p class="ev-bag-dateline">{d.schedule}</p>}
                <h2 class="ev-bag-headline">{d.title}</h2>
                {d.description && <p class="ev-bag-desc">{d.description}</p>}
              </div>

              {/* Speaker block with expandable bio */}
              {d.speakerName && (
                <div class="ev-bag-speaker-block">
                  <div class="ev-bag-speaker-chip">
                    <div class="ev-bag-speaker-avatar">{speakerInitial}</div>
                    <div class="ev-bag-speaker-info">
                      <span class="ev-bag-speaker-name">{d.speakerName}</span>
                      {d.speakerRole && <span class="ev-bag-speaker-role">{d.speakerRole}</span>}
                    </div>
                  </div>
                  {d.speakerBio && (
                    <details class="ev-bag-bio">
                      <summary class="ev-bag-bio-toggle">About the Speaker</summary>
                      <p class="ev-bag-bio-text">{d.speakerBio}</p>
                    </details>
                  )}
                </div>
              )}

              {/* Footer: organizer prominent left, time + CTA right */}
              <div class="ev-bag-footer">
                {d.organizer && (
                  <div class="ev-bag-org-full">
                    {d.organizerLogo && <img src={d.organizerLogo} alt={d.organizer} class="ev-bag-org-logo-lg" />}
                    <div class="ev-bag-org-text">
                      <span class="ev-bag-org-label">PRESENTED BY</span>
                      <span class="ev-bag-org-name-lg">{d.organizer}</span>
                    </div>
                  </div>
                )}
                <div class="ev-bag-footer-right">
                  {d.time && <span class="ev-bag-time">{d.time}</span>}
                  {d.ctaUrl && (
                    <a href={d.ctaUrl} class="ev-cta ev-cta-bag">
                      {d.ctaLabel ?? 'Reserve Your Spot'}
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                  )}
                </div>
              </div>

            </div>
          </div>
        );
      })}

      <!-- Coming Soon -->
      <div class="ev-card ev-card-soon">
        <div class="ev-soon-bg">
          <img src="/images/wp/event-comingsoon-bg.webp" alt="" loading="lazy" class="ev-soon-bg-img" />
          <div class="ev-soon-overlay"></div>
        </div>

        <div class="ev-soon-content">
          <div class="ev-soon-ghost">
            <div class="ev-soon-ghost-badges">
              <span class="ev-soon-ghost-pill"></span>
              <span class="ev-soon-ghost-pill short"></span>
              <span class="ev-soon-ghost-pill"></span>
            </div>
            <div class="ev-soon-ghost-sched"></div>
            <div class="ev-soon-ghost-title"></div>
            <div class="ev-soon-ghost-title short"></div>
            <div class="ev-soon-ghost-title sub"></div>
            <div class="ev-soon-ghost-body"></div>
            <div class="ev-soon-ghost-body short"></div>
            <div class="ev-soon-ghost-body"></div>
            <div class="ev-soon-ghost-cta"></div>
          </div>

          <div class="ev-soon-glass">
            <div class="ev-soon-lock">🔒</div>
            <p class="ev-soon-eyebrow">GOOD THINGS GROW SLOWLY</p>
            <h2 class="ev-soon-heading">—Coming Soon—</h2>
            <p class="ev-soon-desc">More events are being planned. Join the newsletter to be notified first when new events go live.</p>
            <a href="/newsletter" class="ev-cta ev-cta-soon">Get Notified Early</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.ev-inner { max-width: 1260px; margin: 0 auto; padding: 0 40px; }

/* ─── Hero ──────────────────────────────────────────────── */
.ev-hero {
  background-image: url('/images/wp/banner-event.webp');
  background-size: cover; background-position: center;
  background-color: #1a1e1a;
  min-height: 65vh; display: flex; flex-direction: column; justify-content: center;
  padding: calc(72px + 60px) 40px 80px; margin-top: -72px; text-align: center; position: relative;
}
.ev-hero::before { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(10,14,10,0.62) 60%, rgba(10,14,10,0.15) 100%); }
.ev-hero .ev-inner { position: relative; z-index: 1; }
.ev-title { font-family: var(--font-outfit); font-size: 1.875rem; font-weight: 700; letter-spacing: -0.01em; color: #D2CEC8; text-transform: none; margin-bottom: 12px; }
.ev-sub { font-family: var(--font-lora); font-size: 1.2rem; font-weight: 700; color: #fff; line-height: 1.5; max-width: 680px; margin: 0 auto; }
.ev-sub-accent { color: #C8A01A; }

/* ─── Events Section ─────────────────────────────────────── */
.ev-section {
  background: #FAFAF8;
  padding: 60px 40px 80px;
  position: relative;
  overflow: hidden;
}

/* Subtle dot grid on light bg */
.ev-section::before {
  content: '';
  position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background-image: radial-gradient(circle, rgba(0,0,0,0.055) 1px, transparent 1px);
  background-size: 36px 36px;
}

/* Soft color blobs */
.ev-section::after {
  content: '';
  position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background:
    radial-gradient(ellipse 700px 500px at -8% 15%, rgba(180,215,170,0.35) 0%, transparent 65%),
    radial-gradient(ellipse 500px 400px at 108% 85%, rgba(160,200,180,0.25) 0%, transparent 65%);
}

/* Section bg image hidden on light version */
.ev-section-bg { display: none; }
.ev-section-bg-img { display: none; }
.ev-section-overlay { display: none; }

/* ─── Vines ──────────────────────────────────────────────── */
/* vine.png has a non-transparent background — hiding on light section to avoid visible PNG edges */
.ev-vine { display: none; }
/* Fade edges so the PNG rectangle boundary disappears */
.ev-vine-left img, .ev-vine-right img {
  mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.5) 12%, black 28%, black 72%, rgba(0,0,0,0.5) 88%, transparent 100%);
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.5) 12%, black 28%, black 72%, rgba(0,0,0,0.5) 88%, transparent 100%);
}
.ev-vine-top img {
  mask-image: linear-gradient(to top, black 0%, black 35%, rgba(0,0,0,0.4) 65%, transparent 90%);
  -webkit-mask-image: linear-gradient(to top, black 0%, black 35%, rgba(0,0,0,0.4) 65%, transparent 90%);
}
.ev-vine-left { width: 1000px; top: 50%; left: -560px; transform: translateY(-50%) rotate(-90deg); transform-origin: center center; }
.ev-vine-right { width: 1000px; top: 50%; right: -560px; transform: translateY(-50%) rotate(90deg); transform-origin: center center; }
.ev-vine-top { width: 100%; top: 0; left: 0; transform: translateY(-74%); }

.ev-section-inner { max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; position: relative; z-index: 2; }

.ev-label-row { display: flex; align-items: center; gap: 16px; margin-bottom: 4px; }
.ev-label-line { flex: 1; height: 1px; background: rgba(0,0,0,0.12); }
.ev-label-text { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(0,0,0,0.3); white-space: nowrap; }

/* ─── Partner Filter Tabs ────────────────────────────────── */
.ev-filters {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}
.ev-filter-btn {
  display: flex; align-items: center; gap: 9px;
  font-family: var(--font-inter);
  font-size: 0.68rem; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase;
  padding: 10px 20px; border-radius: 50px;
  background: rgba(255,255,255,0.7);
  border: 1px solid rgba(0,0,0,0.1);
  color: rgba(0,0,0,0.45);
  cursor: pointer; transition: all 0.22s ease;
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  box-shadow: 0 1px 4px rgba(0,0,0,0.07);
}
.ev-filter-btn:hover {
  background: rgba(255,255,255,0.92);
  color: rgba(0,0,0,0.75);
  border-color: rgba(0,0,0,0.18);
}
.ev-filter-btn.active {
  background: #1A2C14;
  border-color: #1A2C14;
  color: #fff;
  box-shadow: 0 2px 12px rgba(26,44,20,0.3);
}
.ev-filter-btn[data-filter="ppa"].active {
  background: #3A6228;
  border-color: #3A6228;
  color: #D4F0B8;
  box-shadow: 0 2px 12px rgba(58,98,40,0.32);
}
.ev-filter-btn[data-filter="baganihan"].active {
  background: #7A4E14;
  border-color: #7A4E14;
  color: #F8DDA8;
  box-shadow: 0 2px 12px rgba(122,78,20,0.32);
}
.ev-filter-logo {
  width: 20px; height: 20px; border-radius: 50%;
  object-fit: cover; flex-shrink: 0;
  filter: saturate(0.6) brightness(0.8);
  transition: filter 0.22s ease;
}
.ev-filter-btn.active .ev-filter-logo,
.ev-filter-btn:hover .ev-filter-logo { filter: brightness(1) saturate(1); }
.ev-filter-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: rgba(0,0,0,0.25); flex-shrink: 0;
  transition: background 0.22s ease;
}
.ev-filter-btn.active .ev-filter-dot { background: #fff; }

/* ─── Card transition for filtering ─────────────────────── */
.ev-card[data-partner] { transition: opacity 0.2s ease, transform 0.2s ease; }

/* ─── Card Shell ─────────────────────────────────────────── */
.ev-card { border-radius: 20px; overflow: hidden; box-shadow: 0 8px 40px rgba(0,0,0,0.38); }

/* ─── Card: PDC Course — Light Glass Split ───────────────── */
.ev-card-pdc {
  display: grid;
  grid-template-columns: 1fr 42%;
  min-height: 520px;
  overflow: hidden;
  background: linear-gradient(135deg, #D8E8E0 0%, #E8F0EC 40%, #D4E2EC 100%);
}

/* Left: dark terracotta-rust — distinct from kapihan (green) and bag card (amber) */
.ev-pdc-panel {
  background: linear-gradient(160deg, #180C08 0%, #140A06 60%, #160E08 100%);
  padding: 48px 52px;
  display: flex; flex-direction: column;
  border-right: 1px solid rgba(180,80,50,0.15);
}

