---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Events - Mycelium">
  <SiteNav overlay={true} />

  <!-- Hero -->
  <section class="ev-hero">
    <div class="ev-inner">
      <h1 class="ev-title">UPCOMING EVENTS</h1>
      <p class="ev-sub">Community meetups, talks, relaxed conversations over coffee, and exploring permaculture through <span class="ev-sub-accent">ideas and actions</span></p>
    </div>
  </section>

  <!-- Events Section -->
  <section class="ev-section">

    <!-- Top vine -->
    <div class="ev-vine ev-vine-top" aria-hidden="true">
      <img src="/images/vine.png" alt="" />
    </div>

    <!-- Left vine -->
    <div class="ev-vine ev-vine-left" aria-hidden="true">
      <img src="/images/vine.png" alt="" />
    </div>

    <!-- Right vine -->
    <div class="ev-vine ev-vine-right" aria-hidden="true">
      <img src="/images/vine.png" alt="" />
    </div>
    <div class="ev-section-inner">

      <div class="ev-label-row">
        <span class="ev-label-line"></span>
        <span class="ev-label-text">FIND AN EVENT</span>
        <span class="ev-label-line"></span>
      </div>

      <!-- Card 1: Perma-Kapihan -->
      <div class="ev-card ev-card-kapihan">
        <div class="ev-card-body">
          <div class="ev-card-badge-row">
            <span class="ev-badge ev-badge-recurring">↺ RECURRING</span>
            <span class="ev-badge ev-badge-free">FREE ENTRY</span>
            <span class="ev-badge ev-badge-location">📍 Marikina</span>
          </div>
          <p class="ev-card-schedule">Every Sunday · Except Last Sunday of Month</p>
          <h2 class="ev-card-title">Perma-Kapihan<br><em>sa Eco-house</em></h2>
          <p class="ev-card-desc">An informal Sunday gathering where permaculture enthusiasts connect over coffee, share ideas, and explore how design principles shape the way we live. Open to all — beginners welcome.</p>

          <div class="ev-card-details">
            <div class="ev-detail">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.4"/><path d="M8 4.5V8.5L10.5 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              <span>10:00 AM – 2:00 PM</span>
            </div>
            <div class="ev-detail">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1.5C5.5 1.5 3.5 3.5 3.5 6c0 3.5 4.5 8.5 4.5 8.5S12.5 9.5 12.5 6c0-2.5-2-4.5-4.5-4.5z" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="6" r="1.5" stroke="currentColor" stroke-width="1.2"/></svg>
              <span>PPA Eco-house, Hereford St., Marikina</span>
            </div>
            <div class="ev-detail">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 6h12M5 1v2M11 1v2M3 3h10a1 1 0 011 1v9a1 1 0 01-1 1H3a1 1 0 01-1-1V4a1 1 0 011-1z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              <span>Free Coffee &amp; Snacks · Bring merienda to share (optional)</span>
            </div>
          </div>

          <a href="https://mycelium-learn.com/events/" target="_blank" rel="noopener" class="ev-cta ev-cta-primary">
            Register Here
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
        <div class="ev-card-img-wrap">
          <img src="/images/wp/event-Perma-Kapihan-sa-Eco-house.webp" alt="Perma-Kapihan sa Eco-house" loading="lazy" />
          <div class="ev-card-img-overlay"></div>
          <div class="ev-card-img-tag">
            <span class="ev-img-tag-num">☕</span>
            <span class="ev-img-tag-label">Weekly Gathering</span>
          </div>
        </div>
      </div>

<!-- Card 2: Baganihan Collective — Seed Sovereignty Talk -->
      <div class="ev-card ev-card-bag">
        <!-- Background blobs (needed for glass to read) -->
        <div class="ev-bag-bg" aria-hidden="true">
          <div class="ev-bag-blob ev-bag-blob-1"></div>
          <div class="ev-bag-blob ev-bag-blob-2"></div>
          <div class="ev-bag-blob ev-bag-blob-3"></div>
        </div>
        <div class="ev-card-body ev-bag-body">
          <div class="ev-card-badge-row">
            <span class="ev-badge ev-badge-online">🌐 ONLINE</span>
            <span class="ev-badge ev-badge-free">FREE ENTRY</span>
            <span class="ev-badge ev-badge-talk">TALK</span>
          </div>
          <p class="ev-card-schedule ev-bag-schedule">Friday, May 23, 2026 · 8:00 PM PHT</p>
          <h2 class="ev-card-title ev-bag-title">A Talk on the Importance<br>and Need for<br><em>Seed Sovereignty</em></h2>

          <div class="ev-card-details ev-bag-details">
            <div class="ev-detail">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.4"/><path d="M8 4.5V8.5L10.5 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              <span>8:00 PM · Philippine Standard Time</span>
            </div>
            <div class="ev-detail">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="3" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M1 6h14" stroke="currentColor" stroke-width="1.2"/><circle cx="8" cy="9.5" r="1" fill="currentColor"/></svg>
              <span>Online — link sent upon registration</span>
            </div>
          </div>

          <!-- Speaker block -->
          <div class="ev-speaker-block">
            <div class="ev-speaker-header">
              <div class="ev-speaker-avatar">K</div>
              <div class="ev-speaker-meta">
                <span class="ev-speaker-name">K Lee Hizola</span>
                <span class="ev-speaker-role">Featured Speaker</span>
              </div>
            </div>
            <details class="ev-bio-details">
              <summary class="ev-bio-toggle">About the Speaker</summary>
              <p class="ev-bio-text">K Lee Hizola is a seed-saving practitioner and food sovereignty advocate based in the Philippines. With years of hands-on experience working alongside farming communities, he bridges traditional seed-keeping practices with contemporary food systems thinking — making the case for seeds as living commons rather than commodities.</p>
            </details>
          </div>

          <a href="#" class="ev-cta ev-cta-bag">
            Reserve Your Spot
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>

        <!-- Right: Logo panel -->
        <div class="ev-bag-logo-panel">
          <div class="ev-bag-logo-wrap">
            <img src="/images/baganihan-logo.jpg" alt="Baganihan Collective" class="ev-bag-logo" />
          </div>
          <div class="ev-bag-org-info">
            <span class="ev-bag-presents">PRESENTED BY</span>
            <span class="ev-bag-org-name">Baganihan Collective</span>
          </div>
          <div class="ev-bag-date-block">
            <span class="ev-bag-date-num">23</span>
            <span class="ev-bag-date-mo">MAY 2026</span>
          </div>
        </div>
      </div>

<!-- Card 3: Coming Soon -->
      <div class="ev-card ev-card-soon">
        <div class="ev-soon-bg">
          <img src="/images/wp/event-comingsoon-bg.webp" alt="" loading="lazy" class="ev-soon-bg-img" />
          <div class="ev-soon-overlay"></div>
        </div>

        <div class="ev-soon-content">
          <!-- Left: ghosted fake event details to sell "locked" feel -->
          <div class="ev-soon-ghost">
            <div class="ev-soon-ghost-badges">
              <span class="ev-soon-ghost-pill"></span>
              <span class="ev-soon-ghost-pill short"></span>
              <span class="ev-soon-ghost-pill"></span>
            </div>
            <div class="ev-soon-ghost-sched"></div>
            <div class="ev-soon-ghost-title"></div>
            <div class="ev-soon-ghost-title short"></div>
            <div class="ev-soon-ghost-title sub"></div>
            <div class="ev-soon-ghost-body"></div>
            <div class="ev-soon-ghost-body short"></div>
            <div class="ev-soon-ghost-body"></div>
            <div class="ev-soon-ghost-cta"></div>
          </div>

          <!-- Right: glassmorphism lock panel -->
          <div class="ev-soon-glass">
            <div class="ev-soon-lock">🔒</div>
            <p class="ev-soon-eyebrow">GOOD THINGS GROW SLOWLY</p>
            <h2 class="ev-soon-heading">—Coming Soon—</h2>
            <p class="ev-soon-desc">More events are being planned. Join the newsletter to be notified first when new events go live.</p>
            <a href="/newsletter" class="ev-cta ev-cta-soon">Get Notified Early</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.ev-inner { max-width: 1260px; margin: 0 auto; padding: 0 40px; }

/* ─── Hero ──────────────────────────────────────────────── */
.ev-hero {
  background-image: url('/images/wp/banner-event.webp');
  background-size: cover; background-position: center;
  background-color: #1a1e1a;
  min-height: 65vh; display: flex; flex-direction: column; justify-content: center;
  padding: calc(72px + 60px) 40px 80px; margin-top: -72px; text-align: center; position: relative;
}
.ev-hero::before { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(10,14,10,0.62) 60%, rgba(10,14,10,0.15) 100%); }
.ev-hero .ev-inner { position: relative; z-index: 1; }
.ev-title { font-family: var(--font-outfit); font-size: 1.875rem; font-weight: 700; letter-spacing: -0.01em; color: #D2CEC8; text-transform: none; margin-bottom: 12px; }
.ev-sub { font-family: var(--font-lora); font-size: 1.2rem; font-weight: 700; color: #fff; line-height: 1.5; max-width: 680px; margin: 0 auto; }
.ev-sub-accent { color: #C8A01A; }

/* ─── Events Section ─────────────────────────────────────── */
.ev-section { background: #ffffff; padding: 40px 40px 56px; position: relative; overflow: hidden; }
.ev-section-inner { max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; position: relative; z-index: 1; }

/* ─── Vines ──────────────────────────────────────────────── */
/* vine image is 1024×512 horizontal. rotating 90° makes it run vertically.
   width here = how tall the vine appears; after rotation visual width = width * 512/1024 = width/2.
   we push it almost fully off-screen so only ~55px of leaf tips graze the card edge. */
.ev-vine { position: absolute; pointer-events: none; z-index: 0; }
.ev-vine img { width: 100%; mix-blend-mode: multiply; opacity: 0.88; display: block; }
.ev-vine-left { width: 1000px; top: 50%; left: -560px; transform: translateY(-50%) rotate(-90deg); transform-origin: center center; }
.ev-vine-right { width: 1000px; top: 50%; right: -560px; transform: translateY(-50%) rotate(90deg); transform-origin: center center; }
.ev-vine-top { width: 100%; top: 0; left: 0; transform: translateY(-74%); }

.ev-label-row { display: flex; align-items: center; gap: 16px; margin-bottom: 4px; }
.ev-label-line { flex: 1; height: 1px; background: #C8B89A; }
.ev-label-text { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: #8a7a5a; white-space: nowrap; }

/* ─── Card Shell ─────────────────────────────────────────── */
.ev-card { border-radius: 20px; overflow: hidden; box-shadow: 0 8px 40px rgba(0,0,0,0.12); }

/* ─── Card 1: Perma-Kapihan ──────────────────────────────── */
.ev-card-kapihan { display: grid; grid-template-columns: 1fr 420px; min-height: 500px; background: #1C2E18; }

.ev-card-body { padding: 52px 56px; display: flex; flex-direction: column; gap: 0; }

.ev-card-badge-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
.ev-badge { font-family: var(--font-inter); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding: 5px 12px; border-radius: 50px; }
.ev-badge-recurring { background: rgba(200,160,26,0.18); color: #C8A01A; border: 1px solid rgba(200,160,26,0.35); }
.ev-badge-free { background: rgba(97,206,112,0.15); color: #7ae886; border: 1px solid rgba(97,206,112,0.3); }
.ev-badge-location { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.7); border: 1px solid rgba(255,255,255,0.15); }

.ev-card-schedule { font-family: var(--font-inter); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; color: #C8A01A; text-transform: uppercase; margin-bottom: 12px; }

.ev-card-title { font-family: var(--font-lora); font-size: clamp(2rem, 3vw, 2.8rem); font-weight: 400; color: #fff; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 20px; }
.ev-card-title em { font-style: italic; color: #b8d4a8; }

.ev-card-desc { font-family: var(--font-outfit); font-size: 0.95rem; color: rgba(255,255,255,0.7); line-height: 1.7; margin-bottom: 32px; max-width: 480px; }

.ev-card-details { display: flex; flex-direction: column; gap: 10px; margin-bottom: 36px; padding: 20px 24px; background: rgba(255,255,255,0.05); border-radius: 10px; border: 1px solid rgba(255,255,255,0.08); }
.ev-detail { display: flex; align-items: flex-start; gap: 10px; font-family: var(--font-outfit); font-size: 0.875rem; color: rgba(255,255,255,0.75); line-height: 1.45; }
.ev-detail svg { flex-shrink: 0; margin-top: 2px; color: #8aaa7a; }

.ev-cta { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-inter); font-size: 0.875rem; font-weight: 600; letter-spacing: 0.04em; padding: 14px 28px; border-radius: 8px; text-decoration: none; transition: all 0.2s; width: fit-content; }
.ev-cta-primary { background: #C8A01A; color: #1a1400; }
.ev-cta-primary:hover { background: #e0b520; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(200,160,26,0.35); }

.ev-card-img-wrap { position: relative; overflow: hidden; }
.ev-card-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ev-card-img-overlay { position: absolute; inset: 0; background: linear-gradient(to right, #1C2E18 0%, transparent 35%); }
.ev-card-img-tag { position: absolute; bottom: 24px; right: 24px; background: rgba(28,46,24,0.85); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 10px 16px; display: flex; flex-direction: column; align-items: center; gap: 2px; }
.ev-img-tag-num { font-size: 1.4rem; line-height: 1; }
.ev-img-tag-label { font-family: var(--font-inter); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.7); }

/* ─── Card 2: Baganihan Seed Sovereignty Talk ────────────── */
.ev-card-bag {
  position: relative; isolation: isolate;
  display: grid; grid-template-columns: 1fr 320px;
  background: #0F0D08; overflow: hidden;
}

/* Gradient blobs behind the glass */
.ev-bag-bg { position: absolute; inset: 0; pointer-events: none; }
.ev-bag-blob { position: absolute; border-radius: 50%; filter: blur(72px); opacity: 0.55; }
.ev-bag-blob-1 { width: 420px; height: 420px; background: radial-gradient(circle, #C47A52 0%, transparent 70%); top: -80px; left: -60px; }
.ev-bag-blob-2 { width: 380px; height: 380px; background: radial-gradient(circle, #E8A84A 0%, transparent 70%); bottom: -100px; right: 200px; opacity: 0.4; }
.ev-bag-blob-3 { width: 300px; height: 300px; background: radial-gradient(circle, #3D5C30 0%, transparent 70%); top: 40px; right: 60px; opacity: 0.5; }

/* Glass body panel */
.ev-bag-body {
  position: relative; z-index: 1;
  padding: 40px 44px; display: flex; flex-direction: column; gap: 0;
  background: rgba(15,12,6,0.45);
  backdrop-filter: blur(28px); -webkit-backdrop-filter: blur(28px);
  border-right: 1px solid rgba(255,255,255,0.07);
}

.ev-badge-online { background: rgba(232,168,74,0.12); color: #E8A84A; border: 1px solid rgba(232,168,74,0.25); backdrop-filter: blur(8px); }
.ev-badge-talk { background: rgba(196,122,82,0.12); color: #C47A52; border: 1px solid rgba(196,122,82,0.25); backdrop-filter: blur(8px); }

.ev-bag-schedule { font-family: var(--font-inter); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; color: #E8A84A; text-transform: uppercase; margin-bottom: 10px; }

.ev-bag-title { font-family: var(--font-lora); font-size: clamp(1.7rem, 2.5vw, 2.4rem); font-weight: 400; color: #F5EDD8; line-height: 1.2; letter-spacing: -0.02em; margin-bottom: 16px; }
.ev-bag-title em { font-style: italic; color: #F0C97A; }

/* Glass detail block */
.ev-bag-details {
  background: rgba(255,255,255,0.05);
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.1);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
}
.ev-bag-details .ev-detail { color: rgba(255,255,255,0.72); }
.ev-bag-details .ev-detail svg { color: #C47A52; }

/* Speaker glass card */
.ev-speaker-block {
  margin-top: 14px; margin-bottom: 16px;
  background: rgba(255,255,255,0.04);
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.09);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
  border-radius: 12px; padding: 14px 16px;
}
.ev-speaker-header { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
.ev-speaker-avatar {
  width: 44px; height: 44px; border-radius: 50%;
  background: linear-gradient(135deg, #C47A52, #E8A84A);
  color: #0F0D08; display: flex; align-items: center; justify-content: center;
  font-family: var(--font-lora); font-size: 1.2rem; font-weight: 700; flex-shrink: 0;
  box-shadow: 0 0 16px rgba(232,168,74,0.4);
}
.ev-speaker-meta { display: flex; flex-direction: column; gap: 2px; }
.ev-speaker-name { font-family: var(--font-inter); font-size: 0.9rem; font-weight: 700; color: #F5EDD8; }
.ev-speaker-role { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #E8A84A; }

.ev-bio-details summary { list-style: none; }
.ev-bio-details summary::-webkit-details-marker { display: none; }
.ev-bio-toggle { font-family: var(--font-inter); font-size: 0.78rem; font-weight: 600; color: #C47A52; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; letter-spacing: 0.04em; user-select: none; }
.ev-bio-toggle::after { content: '+'; font-size: 1rem; line-height: 1; }
details[open] .ev-bio-toggle::after { content: '−'; }
.ev-bio-text { font-family: var(--font-outfit); font-size: 0.875rem; color: rgba(255,255,255,0.65); line-height: 1.7; margin-top: 10px; max-width: 460px; }

.ev-cta-bag {
  background: linear-gradient(135deg, #E8A84A, #F0C97A);
  color: #1A1200;
  box-shadow: 0 4px 20px rgba(232,168,74,0.3), inset 0 1px 0 rgba(255,255,255,0.25);
}
.ev-cta-bag:hover { background: linear-gradient(135deg, #F0C97A, #F8DD98); transform: translateY(-1px); box-shadow: 0 6px 28px rgba(232,168,74,0.45); }

/* Right glass logo panel */
.ev-bag-logo-panel {
  position: relative; z-index: 1;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20px;
  padding: 40px 28px;
  background: rgba(255,255,255,0.05);
  backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px);
  border-left: 1px solid rgba(255,255,255,0.1);
  box-shadow: inset 1px 0 0 rgba(255,255,255,0.06);
}
.ev-bag-logo-wrap {
  width: 152px; height: 152px; border-radius: 20px; overflow: hidden;
  box-shadow: 0 8px 32px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.1);
  flex-shrink: 0;
}
.ev-bag-logo { width: 100%; height: 100%; object-fit: cover; display: block; }
.ev-bag-org-info { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; }
.ev-bag-presents { font-family: var(--font-inter); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(232,168,74,0.65); }
.ev-bag-org-name { font-family: var(--font-lora); font-size: 1rem; font-weight: 700; color: #F5EDD8; text-align: center; }
.ev-bag-date-block {
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  background: rgba(232,168,74,0.08);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(232,168,74,0.2);
  box-shadow: inset 0 1px 0 rgba(232,168,74,0.15), 0 4px 16px rgba(0,0,0,0.2);
  border-radius: 12px; padding: 14px 24px;
}
.ev-bag-date-num { font-family: var(--font-lora); font-size: 2.4rem; font-weight: 400; color: #E8A84A; line-height: 1; text-shadow: 0 0 20px rgba(232,168,74,0.5); }
.ev-bag-date-mo { font-family: var(--font-inter); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(232,168,74,0.7); }

/* ─── Card 2: Camp 2026 ──────────────────────────────────── */
.ev-card-camp { position: relative; min-height: 520px; display: flex; align-items: flex-end; overflow: hidden; isolation: isolate; }

.ev-camp-bg { position: absolute; inset: 0; }
.ev-camp-bg-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ev-camp-overlay { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(42,18,4,0.97) 0%, rgba(62,30,6,0.88) 38%, rgba(30,12,2,0.65) 100%); }

.ev-camp-content { position: relative; z-index: 1; display: grid; grid-template-columns: 260px 1fr; gap: 0; width: 100%; }

.ev-camp-left { padding: 52px 40px 52px 52px; border-right: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: column; gap: 32px; justify-content: center; }

