---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';

const allEvents = await getCollection('events');
const events = allEvents.sort((a, b) => (a.data.sortOrder ?? 0) - (b.data.sortOrder ?? 0));
---

<BaseLayout title="Events - Mycelium">
  <SiteNav overlay={true} />

  <!-- Hero -->
  <section class="ev-hero">
    <div class="ev-inner">
      <h1 class="ev-title">UPCOMING EVENTS</h1>
      <p class="ev-sub">Community meetups, talks, relaxed conversations over coffee, and exploring permaculture through <span class="ev-sub-accent">ideas and actions</span></p>
    </div>
  </section>

  <!-- Events Section -->
  <section class="ev-section">

    <!-- Generated atmospheric background -->
    <div class="ev-section-bg" aria-hidden="true">
      <img src="/images/events-bg.jpg" alt="" class="ev-section-bg-img" loading="lazy" />
      <div class="ev-section-overlay"></div>
    </div>

    <div class="ev-section-inner">

      <div class="ev-label-row">
        <span class="ev-label-line"></span>
        <span class="ev-label-text">FIND AN EVENT</span>
        <span class="ev-label-line"></span>
      </div>

      <!-- Partner filter tabs -->
      <div class="ev-filters" role="group" aria-label="Filter events by partner">
        <button class="ev-filter-btn active" data-filter="all">
          <span class="ev-filter-dot"></span>
          All Events
        </button>
        <button class="ev-filter-btn" data-filter="ppa">
          <img src="/images/wp/about-img-10.webp" alt="" class="ev-filter-logo" />
          Philippine Permaculture Association
        </button>
        <button class="ev-filter-btn" data-filter="baganihan">
          <img src="/images/baganihan-logo.jpg" alt="" class="ev-filter-logo" />
          Baganihan Collective
        </button>
      </div>

      {events.map(ev => {
        const d = ev.data;
        const dateDay = d.date ? d.date.getDate().toString() : '';
        const dateMo = d.date
          ? `${d.date.toLocaleString('en-US', { month: 'short' }).toUpperCase()} ${d.date.getFullYear()}`
          : '';
        const speakerInitial = d.speakerName?.charAt(0) ?? '?';

        if (d.template === 'pdc') return (
          <div class="ev-card ev-card-pdc" data-partner={d.partner || undefined}>
            <div class="ev-pdc-left">
              <div class="ev-card-badge-row">
                <span class="ev-badge ev-badge-pdc-course">7-DAY COURSE</span>
                {!d.isFree && <span class="ev-badge ev-badge-pdc-paid">PAID</span>}
                {!d.isOnline && <span class="ev-badge ev-badge-pdc-loc">📍 IN PERSON</span>}
              </div>
              <p class="ev-pdc-schedule">{d.schedule}</p>
              <h2 class="ev-pdc-title">{d.title}</h2>
              {d.description && <p class="ev-pdc-desc">{d.description}</p>}
              {d.highlights && d.highlights.length > 0 && (
                <ul class="ev-pdc-highlights">
                  {d.highlights.map((h: string) => (
                    <li class="ev-pdc-highlight-item">
                      <span class="ev-pdc-check">✦</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              )}
              {d.notes && <p class="ev-pdc-note">{d.notes}</p>}
              {d.ctaUrl && (
                <a href={d.ctaUrl} target="_blank" rel="noopener" class="ev-cta ev-cta-pdc">
                  {d.ctaLabel ?? 'Register Now'}
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              )}
            </div>

            <div class="ev-pdc-right">
              <div class="ev-pdc-date-block">
                <span class="ev-pdc-date-range">{d.dateRange ?? dateDay}</span>
                <span class="ev-pdc-date-mo">{dateMo}</span>
              </div>
              {d.location && (
                <div class="ev-pdc-location">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 1.5C5.5 1.5 3.5 3.5 3.5 6c0 3.5 4.5 8.5 4.5 8.5S12.5 9.5 12.5 6c0-2.5-2-4.5-4.5-4.5z" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="6" r="1.5" stroke="currentColor" stroke-width="1.2"/></svg>
                  <span>{d.location}</span>
                </div>
              )}
              {d.organizerLogo && (
                <div class="ev-pdc-logo-wrap">
                  <img src={d.organizerLogo} alt={d.organizer ?? ''} class="ev-pdc-logo" />
                </div>
              )}
              {d.organizer && (
                <div class="ev-pdc-org">
                  <span class="ev-pdc-presents">PRESENTED BY</span>
                  <span class="ev-pdc-org-name">{d.organizer}</span>
                </div>
              )}
            </div>
          </div>
        );

        if (d.template === 'kapihan') return (
          <div class="ev-card ev-card-kapihan" data-partner={d.partner || undefined}>
            <div class="ev-card-body">
              <div class="ev-card-badge-row">
                {d.isRecurring && <span class="ev-badge ev-badge-recurring">↺ RECURRING</span>}
                {d.isFree && <span class="ev-badge ev-badge-free">FREE ENTRY</span>}
                {d.location && !d.isOnline && <span class="ev-badge ev-badge-location">📍 {d.location.split(',')[0]}</span>}
              </div>
              {d.schedule && <p class="ev-card-schedule">{d.schedule}</p>}
              <h2 class="ev-card-title">{d.title}</h2>
              {d.description && <p class="ev-card-desc">{d.description}</p>}

              <div class="ev-card-details">
                {d.time && (
                  <div class="ev-detail">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.4"/><path d="M8 4.5V8.5L10.5 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                    <span>{d.time}</span>
                  </div>
                )}
                {d.location && (
                  <div class="ev-detail">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1.5C5.5 1.5 3.5 3.5 3.5 6c0 3.5 4.5 8.5 4.5 8.5S12.5 9.5 12.5 6c0-2.5-2-4.5-4.5-4.5z" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="6" r="1.5" stroke="currentColor" stroke-width="1.2"/></svg>
                    <span>{d.location}</span>
                  </div>
                )}
                {d.notes && (
                  <div class="ev-detail">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 6h12M5 1v2M11 1v2M3 3h10a1 1 0 011 1v9a1 1 0 01-1 1H3a1 1 0 01-1-1V4a1 1 0 011-1z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                    <span set:html={d.notes.replace('&', '&amp;')} />
                  </div>
                )}
              </div>

              {d.ctaUrl && (
                <a href={d.ctaUrl} target="_blank" rel="noopener" class="ev-cta ev-cta-primary">
                  {d.ctaLabel ?? 'Learn More'}
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              )}
            </div>
            {d.image && (
              <div class="ev-card-img-wrap">
                <img src={d.image} alt={d.title} loading="lazy" />
                <div class="ev-card-img-overlay"></div>
                <div class="ev-card-img-tag">
                  <span class="ev-img-tag-num">☕</span>
                  <span class="ev-img-tag-label">Weekly Gathering</span>
                </div>
              </div>
            )}
          </div>
        );

        return (
          <div class="ev-card ev-card-bag" data-partner={d.partner || undefined}>
            <div class="ev-bag-bg" aria-hidden="true">
              <div class="ev-bag-blob ev-bag-blob-1"></div>
              <div class="ev-bag-blob ev-bag-blob-2"></div>
              <div class="ev-bag-blob ev-bag-blob-3"></div>
            </div>
            <div class="ev-card-body ev-bag-body">
              <div class="ev-card-badge-row">
                {d.isOnline && <span class="ev-badge ev-badge-online">🌐 ONLINE</span>}
                {d.isFree && <span class="ev-badge ev-badge-free">FREE ENTRY</span>}
                <span class="ev-badge ev-badge-talk">TALK</span>
              </div>
              {d.schedule && <p class="ev-card-schedule ev-bag-schedule">{d.schedule}</p>}
              <h2 class="ev-card-title ev-bag-title">{d.title}</h2>

              <div class="ev-card-details ev-bag-details">
                {d.time && (
                  <div class="ev-detail">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.4"/><path d="M8 4.5V8.5L10.5 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                    <span>{d.time}</span>
                  </div>
                )}
                {d.location && (
                  <div class="ev-detail">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="3" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M1 6h14" stroke="currentColor" stroke-width="1.2"/><circle cx="8" cy="9.5" r="1" fill="currentColor"/></svg>
                    <span>{d.location}</span>
                  </div>
                )}
              </div>

              {d.speakerName && (
                <div class="ev-speaker-block">
                  <div class="ev-speaker-header">
                    <div class="ev-speaker-avatar">{speakerInitial}</div>
                    <div class="ev-speaker-meta">
                      <span class="ev-speaker-name">{d.speakerName}</span>
                      {d.speakerRole && <span class="ev-speaker-role">{d.speakerRole}</span>}
                    </div>
                  </div>
                  {d.speakerBio && (
                    <details class="ev-bio-details">
                      <summary class="ev-bio-toggle">About the Speaker</summary>
                      <p class="ev-bio-text">{d.speakerBio}</p>
                    </details>
                  )}
                </div>
              )}

              {d.ctaUrl && (
                <a href={d.ctaUrl} class="ev-cta ev-cta-bag">
                  {d.ctaLabel ?? 'Reserve Your Spot'}
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              )}
            </div>

            <div class="ev-bag-logo-panel">
              {d.organizerLogo && (
                <div class="ev-bag-logo-wrap">
                  <img src={d.organizerLogo} alt={d.organizer ?? ''} class="ev-bag-logo" />
                </div>
              )}
              {d.organizer && (
                <div class="ev-bag-org-info">
                  <span class="ev-bag-presents">PRESENTED BY</span>
                  <span class="ev-bag-org-name">{d.organizer}</span>
                </div>
              )}
              {dateDay && (
                <div class="ev-bag-date-block">
                  <span class="ev-bag-date-num">{dateDay}</span>
                  <span class="ev-bag-date-mo">{dateMo}</span>
                </div>
              )}
            </div>
          </div>
        );
      })}

      <!-- Coming Soon -->
      <div class="ev-card ev-card-soon">
        <div class="ev-soon-bg">
          <img src="/images/wp/event-comingsoon-bg.webp" alt="" loading="lazy" class="ev-soon-bg-img" />
          <div class="ev-soon-overlay"></div>
        </div>

        <div class="ev-soon-content">
          <div class="ev-soon-ghost">
            <div class="ev-soon-ghost-badges">
              <span class="ev-soon-ghost-pill"></span>
              <span class="ev-soon-ghost-pill short"></span>
              <span class="ev-soon-ghost-pill"></span>
            </div>
            <div class="ev-soon-ghost-sched"></div>
            <div class="ev-soon-ghost-title"></div>
            <div class="ev-soon-ghost-title short"></div>
            <div class="ev-soon-ghost-title sub"></div>
            <div class="ev-soon-ghost-body"></div>
            <div class="ev-soon-ghost-body short"></div>
            <div class="ev-soon-ghost-body"></div>
            <div class="ev-soon-ghost-cta"></div>
          </div>

          <div class="ev-soon-glass">
            <div class="ev-soon-lock">🔒</div>
            <p class="ev-soon-eyebrow">GOOD THINGS GROW SLOWLY</p>
            <h2 class="ev-soon-heading">—Coming Soon—</h2>
            <p class="ev-soon-desc">More events are being planned. Join the newsletter to be notified first when new events go live.</p>
            <a href="/newsletter" class="ev-cta ev-cta-soon">Get Notified Early</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.ev-inner { max-width: 1260px; margin: 0 auto; padding: 0 40px; }

/* ─── Hero ──────────────────────────────────────────────── */
.ev-hero {
  background-image: url('/images/wp/banner-event.webp');
  background-size: cover; background-position: center;
  background-color: #1a1e1a;
  min-height: 65vh; display: flex; flex-direction: column; justify-content: center;
  padding: calc(72px + 60px) 40px 80px; margin-top: -72px; text-align: center; position: relative;
}
.ev-hero::before { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(10,14,10,0.62) 60%, rgba(10,14,10,0.15) 100%); }
.ev-hero .ev-inner { position: relative; z-index: 1; }
.ev-title { font-family: var(--font-outfit); font-size: 1.875rem; font-weight: 700; letter-spacing: -0.01em; color: #D2CEC8; text-transform: none; margin-bottom: 12px; }
.ev-sub { font-family: var(--font-lora); font-size: 1.2rem; font-weight: 700; color: #fff; line-height: 1.5; max-width: 680px; margin: 0 auto; }
.ev-sub-accent { color: #C8A01A; }

/* ─── Events Section ─────────────────────────────────────── */
.ev-section {
  background: #0A1408;
  padding: 60px 40px 80px;
  position: relative;
  overflow: hidden;
}

/* Dot grid texture */
.ev-section::before {
  content: '';
  position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background-image: radial-gradient(circle, rgba(255,255,255,0.028) 1px, transparent 1px);
  background-size: 36px 36px;
}

/* Atmospheric gradient blobs */
.ev-section::after {
  content: '';
  position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background:
    radial-gradient(ellipse 700px 500px at -8% 15%, rgba(45,90,25,0.22) 0%, transparent 65%),
    radial-gradient(ellipse 500px 400px at 108% 85%, rgba(30,65,15,0.16) 0%, transparent 65%);
}

/* Generated background image */
.ev-section-bg {
  position: absolute; inset: 0; z-index: 0; pointer-events: none;
}
.ev-section-bg-img {
  width: 100%; height: 100%;
  object-fit: cover;
  filter: blur(28px) brightness(0.14) saturate(0.65);
  transform: scale(1.06);
  display: block;
}
.ev-section-overlay {
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 90% 50% at 5% 0%, rgba(28,55,16,0.45) 0%, transparent 60%),
    radial-gradient(ellipse 70% 60% at 95% 100%, rgba(18,42,10,0.35) 0%, transparent 60%),
    linear-gradient(180deg, rgba(10,20,8,0.55) 0%, rgba(10,20,8,0.25) 50%, rgba(10,20,8,0.65) 100%);
}

.ev-section-inner { max-width: 1160px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; position: relative; z-index: 1; }

.ev-label-row { display: flex; align-items: center; gap: 16px; margin-bottom: 4px; }
.ev-label-line { flex: 1; height: 1px; background: rgba(255,255,255,0.1); }
.ev-label-text { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.28); white-space: nowrap; }

/* ─── Partner Filter Tabs ────────────────────────────────── */
.ev-filters {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 12px;
}
.ev-filter-btn {
  display: flex; align-items: center; gap: 9px;
  font-family: var(--font-inter);
  font-size: 0.68rem; font-weight: 700;
  letter-spacing: 0.1em; text-transform: uppercase;
  padding: 10px 20px; border-radius: 50px;
  background: rgba(255,255,255,0.055);
  border: 1px solid rgba(255,255,255,0.09);
  color: rgba(255,255,255,0.42);
  cursor: pointer; transition: all 0.22s ease;
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
}
.ev-filter-btn:hover {
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.82);
  border-color: rgba(255,255,255,0.18);
}
.ev-filter-btn.active {
  background: rgba(255,255,255,0.12);
  border-color: rgba(255,255,255,0.28);
  color: #fff;
  box-shadow: 0 0 24px rgba(255,255,255,0.06), 0 2px 10px rgba(0,0,0,0.35);
}
.ev-filter-btn[data-filter="ppa"].active {
  background: rgba(107,127,74,0.2);
  border-color: rgba(140,170,90,0.42);
  color: #c8e09a;
  box-shadow: 0 0 24px rgba(107,127,74,0.2), 0 2px 10px rgba(0,0,0,0.35);
}
.ev-filter-btn[data-filter="baganihan"].active {
  background: rgba(232,168,74,0.14);
  border-color: rgba(232,168,74,0.38);
  color: #f0c97a;
  box-shadow: 0 0 24px rgba(232,168,74,0.14), 0 2px 10px rgba(0,0,0,0.35);
}
.ev-filter-logo {
  width: 20px; height: 20px; border-radius: 50%;
  object-fit: cover; flex-shrink: 0;
  filter: brightness(0.65) saturate(0.5);
  transition: filter 0.22s ease;
}
.ev-filter-btn.active .ev-filter-logo,
.ev-filter-btn:hover .ev-filter-logo { filter: brightness(1) saturate(1); }
.ev-filter-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: rgba(255,255,255,0.4); flex-shrink: 0;
  transition: background 0.22s ease;
}
.ev-filter-btn.active .ev-filter-dot { background: #fff; box-shadow: 0 0 6px rgba(255,255,255,0.6); }

/* ─── Card transition for filtering ─────────────────────── */
.ev-card[data-partner] { transition: opacity 0.2s ease, transform 0.2s ease; }

/* ─── Card Shell ─────────────────────────────────────────── */
.ev-card { border-radius: 20px; overflow: hidden; box-shadow: 0 8px 40px rgba(0,0,0,0.38); }

/* ─── Card: PDC Course ───────────────────────────────────── */
.ev-card-pdc {
  display: grid;
  grid-template-columns: 1fr 300px;
  min-height: 480px;
  background: #FBF0E6;
  position: relative;
  overflow: hidden;
}
.ev-card-pdc::before {
  content: '';
  position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 600px 400px at -10% 120%, rgba(197,106,88,0.18) 0%, transparent 70%),
    radial-gradient(ellipse 400px 300px at 110% -10%, rgba(107,127,74,0.15) 0%, transparent 70%);
  pointer-events: none;
}

.ev-pdc-left {
  position: relative; z-index: 1;
  padding: 48px 52px;
  display: flex; flex-direction: column; gap: 0;
  border-right: 1px solid rgba(197,106,88,0.15);
}

.ev-badge-pdc-course { background: rgba(197,106,88,0.12); color: #C56A58; border: 1px solid rgba(197,106,88,0.3); }
.ev-badge-pdc-paid   { background: rgba(107,127,74,0.1);  color: #5A6E3A; border: 1px solid rgba(107,127,74,0.28); }
.ev-badge-pdc-loc    { background: rgba(245,168,48,0.1);  color: #9A6A10; border: 1px solid rgba(245,168,48,0.25); }

.ev-pdc-schedule {
  font-family: var(--font-inter);
  font-size: 0.72rem; font-weight: 700; letter-spacing: 0.14em;
  text-transform: uppercase; color: #C56A58; margin-bottom: 10px; margin-top: 20px;
}

.ev-pdc-title {
  font-family: var(--font-outfit);
  font-size: clamp(2rem, 3.2vw, 2.9rem);
  font-weight: 800; color: #2A1A0E;
  line-height: 1.05; letter-spacing: -0.03em;
  margin-bottom: 14px;
}

.ev-pdc-desc {
  font-family: var(--font-lora);
  font-size: 1rem; color: #6B4A34;
  line-height: 1.7; margin-bottom: 24px; max-width: 480px;
}

.ev-pdc-highlights {
  list-style: none; padding: 0; margin: 0 0 24px;
  display: flex; flex-direction: column; gap: 10px;
}
.ev-pdc-highlight-item {
  display: flex; align-items: flex-start; gap: 10px;
  font-family: var(--font-outfit); font-size: 0.95rem; color: #3A2210; line-height: 1.4;
}
.ev-pdc-check { color: #6B7F4A; font-size: 0.7rem; flex-shrink: 0; margin-top: 3px; opacity: 0.85; }

.ev-pdc-note {
  font-family: var(--font-inter);
  font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em;
  color: #C56A58; text-transform: uppercase;
  margin-bottom: 28px;
  padding: 10px 16px;
  background: rgba(197,106,88,0.08);
  border-left: 3px solid #C56A58;
  border-radius: 0 6px 6px 0;
}

.ev-cta-pdc { background: #C56A58; color: #FBF0E6; box-shadow: 0 4px 20px rgba(197,106,88,0.35); }
.ev-cta-pdc:hover { background: #AD5644; transform: translateY(-1px); box-shadow: 0 6px 28px rgba(197,106,88,0.45); }

.ev-pdc-right {
  position: relative; z-index: 1;
  background: #C56A58;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 20px; padding: 40px 28px;
}

.ev-pdc-date-block {
  display: flex; flex-direction: column; align-items: center; gap: 4px;
  background: rgba(255,255,255,0.15);
  border: 1px solid rgba(255,255,255,0.25);
  border-radius: 16px; padding: 20px 32px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.2);
}
.ev-pdc-date-range {
  font-family: var(--font-lora);
  font-size: 3.2rem; font-weight: 700; color: #fff;
  line-height: 1; letter-spacing: -0.03em;
  text-shadow: 0 2px 12px rgba(0,0,0,0.15);
}
.ev-pdc-date-mo {
  font-family: var(--font-inter);
