}
.ev-ws-org-name { font-family: var(--font-lora); font-size: 1.1rem; font-weight: 700; color: rgba(248,237,216,0.92); }
.ev-ws-location {
  display: flex; align-items: flex-start; gap: 5px;
  font-family: var(--font-outfit); font-size: 0.74rem; color: rgba(248,237,216,0.4);
}
.ev-ws-location svg { flex-shrink: 0; margin-top: 2px; color: rgba(200,120,48,0.72); }

/* ─── Coming Soon ────────────────────────────────────────── */
.ev-card-soon { position: relative; min-height: 480px; display: flex; align-items: stretch; overflow: hidden; isolation: isolate; }

.ev-soon-bg { position: absolute; inset: 0; }
.ev-soon-bg-img { width: 100%; height: 100%; object-fit: cover; display: block; }
