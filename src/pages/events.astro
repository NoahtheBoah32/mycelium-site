---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Events - Mycelium">
  <SiteNav overlay={true} />


  <!-- Hero -->
  <section class="ev-hero">
    <div class="ev-inner">
      <h1 class="ev-title">UPCOMING EVENTS</h1>
      <p class="ev-sub">Community meetups, talks, relaxed conversations over coffee, and exploring permaculture through <span class="ev-sub-accent">ideas and actions</span></p>
    </div>
  </section>

  <!-- Perma-Kapihan -->
  <section class="ev-find">
    <div class="ev-inner">
      <h2 class="ev-find-heading">FIND AN EVENT</h2>
      <p class="ev-find-sub">Discover and attend community events focused on permaculture and regenerative living. These community gatherings offer a place for learning, connection, and growth.</p>
    </div>
  </section>

  <section class="ev-kapihan">
    <div class="ev-inner ev-two-col">
      <div class="ev-col-text">
        <p class="ev-sunday-label">Every Sunday of The Month Except for The Last Sunday</p>
        <h2 class="ev-kapihan-title">Perma-Kapihan sa Eco-house</h2>
        <p class="ev-kapihan-desc">Perma-Kapihan is a monthly Sunday event organized by the Philippine Permaculture Association, serving as an informal space for conversation and learning. Past Perma-Kapihan gatherings have touched on many aspects of permaculture, showing how it can build systems that shape our values when guided by clear principles and actions. Sessions have also explored natural ponds and the idea of permaculture as an expanded art, lived as a practice rather than treated as something purely theoretical.</p>
        <div class="ev-coffee-block">
          <h3 class="ev-coffee-title">CONNECT OVER COFFEE &amp; PERMACULTURE</h3>
          <p class="ev-coffee-time">SUNDAY | 10 AM - 2 PM</p>
          <p class="ev-coffee-detail">Free Coffee &amp; Snacks &nbsp;·&nbsp; Bring Merienda to Share (optional) &nbsp;·&nbsp; To RSVP click the link in bio.</p>
          <p class="ev-coffee-loc">📍 The Philippine Permaculture Association, Hereford St., Marikina</p>
        </div>
      </div>
      <div class="ev-col-img">
        <img src="https://mycelium-learn.com/wp-content/uploads/2026/03/event-Perma-Kapihan-sa-Eco-house.webp" alt="Perma-Kapihan sa Eco-house" loading="lazy" />
        <a href="https://mycelium-learn.com/events/" target="_blank" rel="noopener" class="btn-register btn-register-img">REGISTER HERE →</a>
      </div>
    </div>
  </section>

  <!-- Permaculture Camp 2026 -->
  <section class="ev-camp">
    <div class="ev-inner ev-camp-inner">
      <div class="ev-camp-date">
        <span class="ev-camp-month">MAY</span>
        <span class="ev-camp-days">1—3</span>
        <span class="ev-camp-dow">THU – SAT</span>
        <span class="ev-camp-loc-label">LOCATION</span>
        <span class="ev-camp-loc-name">Ecodee Research Institute Cabiao, Nueva Ecija</span>
        <span class="ev-camp-price-label">SLIDING SCALE</span>
        <span class="ev-camp-price">₱800—<br>₱3,500</span>
        <span class="ev-camp-slots">LIMITED SLOTS</span>
      </div>
      <div class="ev-camp-card">
        <div class="ev-camp-tags">
          <span class="ev-camp-tag">🏕 IMMERSIVE CAMP</span>
          <span class="ev-camp-tag">👥 IN-PERSON</span>
          <span class="ev-camp-tag">📍 NUEVA ECIJA</span>
        </div>
        <h2 class="ev-camp-title">Permaculture<br><em>Camp 2026</em></h2>
        <p class="ev-camp-org-bold">Philippine Permaculture Association</p>
        <p class="ev-camp-tagline">🌱 Swim · Camp · Connect · Grow</p>
        <p class="ev-camp-desc">Step away from the noise and into nature. Join the Philippine Permaculture Association for a camping experience rooted in shared living, mutual support, and learning from the land.</p>
        <ul class="ev-camp-list">
          <li>🏕 Simple, intentional camping</li>
          <li>🌊 Swimming in a natural pool</li>
          <li>🌲 Forest walk &amp; land learning</li>
          <li>🌿 Permaculture 101 — customized to your group</li>
          <li>🤝 Shared stewardship, cooking &amp; community</li>
        </ul>
        <a href="https://mycelium-learn.com/events/" target="_blank" rel="noopener" class="btn-register btn-register-camp">REGISTER HERE →</a>
      </div>
    </div>
  </section>

  <!-- Coming Soon -->
  <section class="ev-soon">
    <div class="ev-inner">
      <p class="ev-soon-sub">GOOD THINGS GROW SLOWLY</p>
      <h2 class="ev-soon-title">—Coming Soon—</h2>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.ev-inner { max-width: 1260px; margin: 0 auto; padding: 0 40px; }

/* Hero */
.ev-hero {
  background-image: url('https://mycelium-learn.com/wp-content/uploads/2026/02/banner-event.webp');
  background-size: cover; background-position: center;
  background-color: #1a1e1a;
  padding: calc(120px + 72px) 40px 120px; margin-top: -72px; text-align: center; position: relative;
}
.ev-hero::before { content: ''; position: absolute; inset: 0; background: rgba(10,14,10,0.62); }
.ev-hero .ev-inner { position: relative; z-index: 1; }
.ev-title { font-family: var(--font-inter); font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 700; letter-spacing: 0.08em; color: #fff; text-transform: uppercase; margin-bottom: 20px; }
.ev-sub { font-family: var(--font-outfit); font-size: 1rem; color: #c8d0c8; line-height: 1.7; max-width: 680px; margin: 0 auto; }
.ev-sub-accent { color: #C8A01A; }

/* Find an Event */
.ev-find { background: #2B2F31; padding: 48px 40px 40px; text-align: center; }
.ev-find-heading { font-family: var(--font-inter); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #8aaa7a; margin-bottom: 16px; }
.ev-find-sub { font-family: var(--font-outfit); font-size: 1rem; color: #9aaa9a; line-height: 1.7; max-width: 640px; margin: 0 auto; }

/* Perma-Kapihan */
.ev-kapihan {
  background-image: url('https://mycelium-learn.com/wp-content/uploads/2026/03/event-Perma-Kapihan-sa-Eco-house.webp');
  background-size: cover; background-position: center;
  background-color: #2a3a20; padding: 60px 40px; position: relative;
}
.ev-kapihan::before { content: ''; position: absolute; inset: 0; background: rgba(20,28,14,0.72); }
.ev-kapihan .ev-inner { position: relative; z-index: 1; }
.ev-two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start; }
.ev-sunday-label { font-family: var(--font-inter); font-size: 0.78rem; font-weight: 600; color: #b8d4a8; letter-spacing: 0.04em; margin-bottom: 12px; }
.ev-kapihan-title { font-family: var(--font-serif); font-size: clamp(1.6rem, 2.5vw, 2.2rem); font-weight: 400; color: #fff; line-height: 1.2; letter-spacing: -0.01em; margin-bottom: 20px; }
.ev-kapihan-desc { font-family: var(--font-outfit); font-size: 0.95rem; color: #c8d8c0; line-height: 1.7; margin-bottom: 32px; }
.ev-coffee-block { margin-top: 8px; }
.ev-coffee-title { font-family: var(--font-inter); font-size: clamp(1rem, 1.6vw, 1.4rem); font-weight: 700; letter-spacing: 0.08em; color: #fff; text-transform: uppercase; margin-bottom: 10px; }
.ev-coffee-time { font-family: var(--font-inter); font-size: 1rem; font-weight: 600; color: #b8d4a8; letter-spacing: 0.1em; margin-bottom: 10px; }
.ev-coffee-detail { font-family: var(--font-outfit); font-size: 0.88rem; color: #c5d5c5; line-height: 1.6; margin-bottom: 6px; }
.ev-coffee-loc { font-family: var(--font-outfit); font-size: 0.88rem; color: #c5d5c5; }
.ev-col-img { position: relative; border-radius: 10px; overflow: hidden; background: #3a4a2a; min-height: 480px; }
.ev-col-img img { width: 100%; height: 100%; object-fit: cover; display: block; min-height: 480px; }
.btn-register-img { position: absolute; bottom: 20px; right: 20px; }

/* Camp */
.ev-camp { background: #fff; padding: 80px 40px; }
.ev-camp-inner { display: grid; grid-template-columns: auto 1fr; gap: 64px; align-items: start; max-width: 1000px; }
.ev-camp-date { display: flex; flex-direction: column; align-items: flex-start; min-width: 160px; }
.ev-camp-month { font-family: var(--font-inter); font-size: 1rem; font-weight: 700; letter-spacing: 0.2em; color: #7a6a30; text-transform: uppercase; margin-bottom: 4px; }
.ev-camp-days { font-family: var(--font-serif); font-style: italic; font-size: clamp(3.5rem, 7vw, 6rem); font-weight: 400; color: #8a7830; line-height: 1; letter-spacing: -0.02em; margin-bottom: 8px; }
.ev-camp-dow { font-family: var(--font-inter); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; color: #7a6a30; text-transform: uppercase; margin-bottom: 12px; }
.ev-camp-loc-label { font-family: var(--font-inter); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.14em; color: #7a6a30; text-transform: uppercase; margin-bottom: 4px; }
.ev-camp-loc-name { font-family: var(--font-inter); font-size: 0.82rem; color: #2F4F2F; font-weight: 600; line-height: 1.4; margin-bottom: 16px; }
.ev-camp-price-label { font-family: var(--font-inter); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.14em; color: #7a6a30; text-transform: uppercase; margin-bottom: 4px; }
.ev-camp-price { font-family: var(--font-inter); font-size: 1.3rem; font-weight: 700; color: #2F4F2F; line-height: 1.2; margin-bottom: 8px; }
.ev-camp-slots { font-family: var(--font-inter); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; color: #7a6a30; text-transform: uppercase; }
.ev-camp-card { background: #fff; border: 1px solid #e0e0d8; border-radius: 12px; padding: 32px; }
.ev-camp-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
.ev-camp-tag { font-family: var(--font-inter); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em; color: #5a6a40; background: #f0f4e8; border-radius: 4px; padding: 4px 10px; text-transform: uppercase; }
.ev-camp-title { font-family: var(--font-serif); font-size: clamp(1.8rem, 2.5vw, 2.4rem); font-weight: 400; color: #242424; line-height: 1.15; margin-bottom: 6px; }
.ev-camp-title em { font-style: italic; color: #5a6a30; }
.ev-camp-org-bold { font-family: var(--font-inter); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; color: #2F4F2F; text-transform: uppercase; margin-bottom: 16px; }
.ev-camp-tagline { font-family: var(--font-outfit); font-size: 0.9rem; color: #555; margin-bottom: 12px; }
.ev-camp-desc { font-family: var(--font-outfit); font-size: 0.9rem; color: #555; line-height: 1.6; margin-bottom: 16px; }
.ev-camp-list { list-style: none; padding: 0; margin: 0 0 24px; display: flex; flex-direction: column; gap: 6px; }
.ev-camp-list li { font-family: var(--font-outfit); font-size: 0.88rem; color: #444; }

/* Register button */
.btn-register { font-family: var(--font-inter); font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em; background: #5A3A1C; color: #fff; padding: 10px 22px; border-radius: 4px; transition: background 0.2s; text-decoration: none; display: inline-block; }
.btn-register:hover { background: #7a5030; }
.btn-register-camp { background: #2F4F2F; color: #fff; display: block; text-align: center; padding: 14px 24px; border-radius: 6px; }
.btn-register-camp:hover { background: #3d6b3d; }

/* Coming Soon */
.ev-soon { background: #1a1a1a; padding: 80px 40px; text-align: center;
  background-image: url('https://mycelium-learn.com/wp-content/uploads/2026/02/event-comingsoon-bg.webp');
  background-size: cover; background-position: center; position: relative; }
.ev-soon::before { content: ''; position: absolute; inset: 0; background: rgba(10,12,8,0.72); }
.ev-soon > * { position: relative; z-index: 1; }
.ev-soon-sub { font-family: var(--font-inter); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #d0d8c8; margin-bottom: 16px; }
.ev-soon-title { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 400; color: #e8e0d0; letter-spacing: -0.01em; }

@media (max-width: 900px) {
  .ev-two-col { grid-template-columns: 1fr; gap: 32px; }
  .ev-col-img { order: -1; }
  .ev-camp-inner { grid-template-columns: 1fr; gap: 24px; }
  .ev-camp-days { font-size: 4rem; }
}
@media (max-width: 600px) {
  .ev-inner { padding: 0 20px; }
  .ev-hero { padding: 56px 20px 48px; }
  .ev-find { padding: 32px 20px 24px; }
  .ev-kapihan { padding: 40px 20px; }
  .ev-camp { padding: 48px 20px; }
  .ev-soon { padding: 56px 20px; }
}
</style>
