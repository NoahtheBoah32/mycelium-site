.ev-ws-desc {
  font-family: var(--font-outfit); font-size: 0.95rem;
  color: rgba(248,237,216,0.65); line-height: 1.65; margin-bottom: 0;
}
.ev-ws-footer {
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  margin-top: 28px; padding-top: 20px; border-top: 1px solid rgba(240,194,48,0.13);
