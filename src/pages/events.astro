---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Events - Mycelium">
  <SiteNav />

  <section class="ev-hero">
    <div class="section-inner">
      <span class="eyebrow">Events</span>
      <h1 class="ev-title">Upcoming Events</h1>
      <p class="ev-sub">Live permaculture workshops, camps, and community gatherings across the Philippines</p>
    </div>
  </section>

  <section class="ev-section">
    <div class="section-inner">
      <div class="ev-grid">

        <article class="ev-card">
          <div class="ev-card-header">
            <span class="ev-tag">Monthly</span>
            <h2 class="ev-name">Perma-Kapihan sa Eco-house</h2>
            <p class="ev-tagline">CONNECT OVER COFFEE &amp; PERMACULTURE</p>
          </div>
          <div class="ev-card-body">
            <div class="ev-detail-row">
              <span class="ev-detail-label">When</span>
              <span class="ev-detail-value">Every Sunday (except last), 10 AM &ndash; 2 PM</span>
            </div>
            <div class="ev-detail-row">
              <span class="ev-detail-label">Where</span>
              <span class="ev-detail-value">The Philippine Permaculture Association, Hereford St., Marikina</span>
            </div>
            <div class="ev-detail-row">
              <span class="ev-detail-label">Cost</span>
              <span class="ev-detail-value">Free &mdash; coffee and snacks provided</span>
            </div>
            <p class="ev-desc">A recurring monthly Sunday gathering for community conversation and permaculture knowledge sharing.</p>
            <a href="https://mycelium-learn.com/events/" target="_blank" rel="noopener" class="btn-register">Register</a>
          </div>
        </article>

        <article class="ev-card">
          <div class="ev-card-header">
            <span class="ev-tag">May 2026</span>
            <h2 class="ev-name">Permaculture Camp 2026</h2>
            <p class="ev-tagline">GOOD THINGS GROW SLOWLY</p>
          </div>
          <div class="ev-card-body">
            <div class="ev-detail-row">
              <span class="ev-detail-label">When</span>
              <span class="ev-detail-value">May 1&ndash;3, 2026 (Thursday &ndash; Saturday)</span>
            </div>
            <div class="ev-detail-row">
              <span class="ev-detail-label">Where</span>
              <span class="ev-detail-value">Ecodee Research Institute, Cabiao, Nueva Ecija</span>
            </div>
            <div class="ev-detail-row">
              <span class="ev-detail-label">Cost</span>
              <span class="ev-detail-value">Sliding scale &#8369;800&ndash;&#8369;3,500</span>
            </div>
            <div class="ev-detail-row">
              <span class="ev-detail-label">Organizer</span>
              <span class="ev-detail-value">Philippine Permaculture Association</span>
            </div>
            <p class="ev-desc">Camping, swimming, forest walks, permaculture introduction, and communal cooking at Ecodee Research Institute.</p>
            <a href="https://mycelium-learn.com/events/" target="_blank" rel="noopener" class="btn-register">Register</a>
          </div>
        </article>

      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.section-inner { max-width: 1260px; margin: 0 auto; padding: 0 40px; }
.eyebrow { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-primary); margin-bottom: 12px; display: block; }
.ev-hero { background: #43330B; padding: 96px 40px 80px; }
.ev-title { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem); font-weight: 400; color: #D2CEC8; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 16px; }
.ev-sub { font-family: var(--font-outfit); font-size: 1.1rem; color: #888; }
.ev-section { background: #F7F7F5; padding: 64px 40px 80px; }
.ev-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px; }
.ev-card { background: #fff; border-radius: 16px; overflow: hidden; border: 1px solid #e8e8e8; transition: box-shadow 0.2s; }
.ev-card:hover { box-shadow: 0 4px 24px rgba(0,0,0,0.08); }
.ev-card-header { background: #2F2A1F; padding: 28px 28px 24px; }
.ev-tag { font-family: var(--font-inter); font-size: 0.65rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #FFD53B; background: rgba(255,213,59,0.12); padding: 4px 10px; border-radius: 50px; display: inline-block; margin-bottom: 12px; }
.ev-name { font-family: var(--font-lora); font-size: 1.4rem; font-weight: 600; color: #D2CEC8; line-height: 1.3; margin-bottom: 6px; }
.ev-tagline { font-family: var(--font-inter); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #7A8B55; }
.ev-card-body { padding: 28px; display: flex; flex-direction: column; gap: 12px; }
.ev-detail-row { display: flex; flex-direction: column; gap: 2px; }
.ev-detail-label { font-family: var(--font-inter); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #999; }
.ev-detail-value { font-family: var(--font-inter); font-size: 0.9rem; color: #333; }
.ev-desc { font-family: var(--font-outfit); font-size: 0.95rem; color: #555; line-height: 1.6; margin-top: 4px; }
.btn-register { font-family: var(--font-inter); font-size: 0.875rem; font-weight: 500; background: #5A3A1C; color: #fff; padding: 10px 24px; border-radius: 50px; transition: background 0.2s; text-decoration: none; display: inline-block; margin-top: 8px; }
.btn-register:hover { background: #947153; }
@media (max-width: 768px) { .ev-grid { grid-template-columns: 1fr; } }
@media (max-width: 600px) { .section-inner { padding: 0 20px; } .ev-hero { padding: 64px 20px 48px; } .ev-section { padding: 40px 20px; } }
</style>
