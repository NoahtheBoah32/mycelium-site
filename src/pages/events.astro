/* ── Right glass: event details ── */
.ev-ws-right {
  background: rgba(10,8,2,0.58);
  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(240,194,48,0.16);
