---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

const articles = [
  {
    cat: "Getting Started",
    title: "What is Permaculture? Article",
    desc: "Permaculture gets thrown around a lot, but rarely explained well. It is not just organic gardening. It is a design system that applies to backyards, communities, and entire ways of living.",
    url: "https://mycelium-learn.com/resources/growing-resilience/",
    ext: "https://homefortheharvest.com/permaculture-for-beginners/",
  },
  {
    cat: "Beginner",
    title: "First Steps Article",
    desc: "Understanding permaculture and knowing what to do with that knowledge is equally important. This guide gets straight to the practical side: how to read your space, what to prioritize first.",
    url: "https://mycelium-learn.com/resources/the-eco-blueprint/",
    ext: "https://masterclass.com/articles/how-to-start-a-permaculture-garden",
  },
  {
    cat: "Beginner",
    title: "Design Principles Article",
    desc: "These are the thinking tools behind every permaculture decision.",
    url: "https://mycelium-learn.com/resources/designing-with-nature/",
    ext: "https://permacultureprinciples.com/permaculture-principles/",
  },
  {
    cat: "Beginner",
    title: "Designing a Food Forest",
    desc: "A food forest is a working, layered ecosystem that produces food and largely takes care of itself over time.",
    url: "https://mycelium-learn.com/resources/sustainable-abundance/",
    ext: "https://permacultureapprentice.com/creating-a-food-forest-step-by-step-guide/",
  },
  {
    cat: "Intermediate",
    title: "Regenerative Living",
    desc: "Overview of ecosystem restoration through water capture, soil health, and biodiversity enhancement.",
    url: "https://mycelium-learn.com/resources/reources/",
    ext: null,
  },
];
---

<BaseLayout title="Resources - Mycelium">
  <SiteNav />

  <section class="res-hero">
    <div class="section-inner">
      <span class="eyebrow">Resources</span>
      <h1 class="res-title">Organized Blog Resources</h1>
      <p class="res-sub">Quality permaculture content organized by topic</p>
    </div>
  </section>

  <section class="res-grid-section">
    <div class="section-inner">
      <div class="res-grid">
        {articles.map(a => (
          <div class="rc">
            <span class="rc-cat">{a.cat}</span>
            <h3 class="rc-title">{a.title}</h3>
            <p class="rc-desc">{a.desc}</p>
            <div class="rc-actions">
              <a href={a.url} target="_blank" rel="noopener" class="btn-more">Learn More</a>
              {a.ext && <a href={a.ext} target="_blank" rel="noopener" class="btn-view">View Resource</a>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.section-inner { max-width: 1260px; margin: 0 auto; padding: 0 40px; }
.eyebrow { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-primary); margin-bottom: 12px; display: block; }
.res-hero { background: #2B2F31; padding: 96px 40px 80px; }
.res-title { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem); font-weight: 400; color: #D2CEC8; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 16px; }
.res-sub { font-family: var(--font-outfit); font-size: 1.1rem; color: #888; }
.res-grid-section { background: #F7F7F5; padding: 64px 40px 80px; }
.res-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
.rc { padding: 28px; background: #fff; border-radius: 12px; border: 1px solid #e8e8e8; display: flex; flex-direction: column; gap: 10px; transition: box-shadow 0.2s; }
.rc:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.07); }
.rc-cat { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #2F4F2F; }
.rc-title { font-family: var(--font-lora); font-size: 1.05rem; font-weight: 600; color: #242424; line-height: 1.4; }
.rc-desc { font-family: var(--font-inter); font-size: 0.875rem; color: #666; line-height: 1.6; flex: 1; }
.rc-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px; }
.btn-more { font-family: var(--font-inter); font-size: 0.8rem; font-weight: 500; color: #242424; border: 1px solid #ccc; padding: 7px 16px; border-radius: 50px; transition: border-color 0.2s; text-decoration: none; display: inline-block; }
.btn-more:hover { border-color: #2F4F2F; color: #2F4F2F; }
.btn-view { font-family: var(--font-inter); font-size: 0.8rem; font-weight: 500; background: #5A3A1C; color: #fff; padding: 7px 16px; border-radius: 50px; transition: background 0.2s; text-decoration: none; display: inline-block; }
.btn-view:hover { background: #947153; }
@media (max-width: 768px) { .res-grid { grid-template-columns: 1fr; } }
@media (max-width: 600px) { .section-inner { padding: 0 20px; } .res-hero { padding: 64px 20px 48px; } .res-grid-section { padding: 40px 20px; } }
</style>
