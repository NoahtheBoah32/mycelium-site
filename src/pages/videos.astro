---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import videos from '../../public/data/videos.json';
---

<BaseLayout title="Videos - Mycelium">
  <SiteNav />

  <section class="vp-hero">
    <div class="vp-hero-inner">
      <span class="eyebrow-label">Video Library</span>
      <h1 class="vp-title">Learn Through Permaculture Videos</h1>
      <p class="vp-sub">Explore practical tips, techniques, and inspiration for your permaculture journey</p>
    </div>
  </section>

  <section class="vp-grid-section">
    <div class="vp-inner">
      <div class="vp-grid">
        {videos.map(v => {
          const ytMatch = v.embedUrl?.match(/[?&]v=([^&]+)/);
          const ytId = v.youtubeId || (ytMatch ? ytMatch[1] : null);
          const thumb = ytId ? `https://img.youtube.com/vi/${ytId}/mqdefault.jpg` : v.thumbnail;
          return (
            <div class="vc">
              <div class="vc-thumb">
                <img src={thumb || v.thumbnail} alt={v.title} loading="lazy" />
                <div class="vc-play-overlay">
                  <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                    <circle cx="20" cy="20" r="20" fill="rgba(0,0,0,0.5)" />
                    <polygon points="16,13 30,20 16,27" fill="white" />
                  </svg>
                </div>
                {v.videoType === 'webinar' && <span class="vc-badge">WEBINAR</span>}
              </div>
              <div class="vc-body">
                <p class="vc-author">{v.author || 'Mycelium'}</p>
                <h3 class="vc-title">{v.title}</h3>
                {v.description && <p class="vc-desc">{v.description.substring(0, 100)}&hellip;</p>}
                <div class="vc-actions">
                  {v.embedUrl && (
                    <a href={v.embedUrl} target="_blank" rel="noopener" class="btn-watch">Watch Now</a>
                  )}
                  <a href={`/video/${v.slug}`} class="btn-learn">Learn More</a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
.eyebrow-label { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-primary); margin-bottom: 12px; display: block; }
.vp-hero { background: #2F2A1F; padding: 96px 40px 80px; }
.vp-hero-inner { max-width: 760px; margin: 0 auto; text-align: center; }
.vp-title { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem); font-weight: 400; color: #D2CEC8; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 16px; }
.vp-sub { font-family: var(--font-outfit); font-size: 1.1rem; color: #888; line-height: 1.6; }
.vp-grid-section { background: #fff; padding: 64px 40px 80px; }
.vp-inner { max-width: 1260px; margin: 0 auto; }
.vp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
.vc { border: 1px solid #e8e8e8; border-radius: 12px; overflow: hidden; background: #fff; transition: box-shadow 0.2s, transform 0.2s; display: flex; flex-direction: column; }
.vc:hover { box-shadow: 0 6px 32px rgba(0,0,0,0.1); transform: translateY(-2px); }
.vc-thumb { position: relative; aspect-ratio: 16/9; overflow: hidden; background: #f0f0f0; flex-shrink: 0; }
.vc-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
.vc:hover .vc-thumb img { transform: scale(1.03); }
.vc-play-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.2s; }
.vc:hover .vc-play-overlay { opacity: 1; }
.vc-badge { position: absolute; top: 8px; left: 8px; background: #5A3A1C; color: #fff; font-family: var(--font-inter); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.1em; padding: 3px 8px; border-radius: 3px; text-transform: uppercase; }
.vc-body { padding: 20px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
.vc-author { font-family: var(--font-inter); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #2F4F2F; }
.vc-title { font-family: var(--font-lora); font-size: 0.95rem; font-weight: 600; color: #242424; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.vc-desc { font-family: var(--font-inter); font-size: 0.8rem; color: #888; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.vc-actions { display: flex; gap: 8px; margin-top: auto; padding-top: 12px; flex-wrap: wrap; }
.btn-watch { font-family: var(--font-inter); font-size: 0.78rem; font-weight: 500; color: #242424; border: 1px solid #ccc; padding: 6px 14px; border-radius: 50px; transition: border-color 0.2s, color 0.2s; text-decoration: none; display: inline-block; }
.btn-watch:hover { border-color: #2F4F2F; color: #2F4F2F; }
.btn-learn { font-family: var(--font-inter); font-size: 0.78rem; font-weight: 500; background: #5A3A1C; color: #fff; padding: 6px 14px; border-radius: 50px; transition: background 0.2s; text-decoration: none; display: inline-block; }
.btn-learn:hover { background: #947153; }
@media (max-width: 1024px) { .vp-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px) { .vp-hero { padding: 64px 20px 48px; } .vp-grid-section { padding: 40px 20px; } .vp-grid { grid-template-columns: 1fr; } }
</style>
