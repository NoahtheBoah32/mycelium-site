---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import videos from '../../public/data/videos.json';
---

<BaseLayout title="Videos - Mycelium">
  <SiteNav />

  <section class="vp-hero">
    <div class="vp-inner">
      <h1 class="vp-title">Learn Through Permaculture Videos</h1>
      <p class="vp-sub">Explore practical tips, techniques, and inspiration for your permaculture journey</p>
    </div>
  </section>

  <section class="vp-grid-section">
    <div class="vp-inner">
      <div class="vp-filters" id="vp-filters">
        <button class="vp-filter active" data-filter="all">All</button>
        <button class="vp-filter" data-filter="podcast">Podcast</button>
      </div>
      <div class="vp-grid" id="vp-grid">
        {videos.map((v, i) => {
          const isPodcast = v.title?.toLowerCase().includes('podcast') || v.tags?.some((t: string) => t.toLowerCase().includes('podcast'));
          const thumb = v.thumbnail || (v.youtubeId ? `https://img.youtube.com/vi/${v.youtubeId}/mqdefault.jpg` : null);
          return (
            <a
              href={`/video/${v.slug}`}
              class="vc"
              data-type={isPodcast ? 'podcast' : 'all'}
              data-index={i}
              style={i >= 9 ? 'display:none' : ''}
            >
              <div class="vc-thumb">
                {thumb && <img src={thumb} alt={v.title} loading="lazy" />}
                <div class="vc-play">
                  <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
                    <circle cx="18" cy="18" r="18" fill="rgba(0,0,0,0.6)" />
                    <polygon points="14,11 28,18 14,25" fill="white" />
                  </svg>
                </div>
                {v.videoType === 'webinar' && <span class="vc-badge">WEBINAR</span>}
              </div>
              <div class="vc-body">
                <h3 class="vc-title">{v.title}</h3>
                <p class="vc-author">By {v.author || 'Mycelium'}</p>
              </div>
            </a>
          );
        })}
      </div>
      <div class="vp-load-wrap" id="vp-load-wrap">
        <button class="vp-load-more" id="vp-load-more">Load More</button>
      </div>
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<script>
  const BATCH = 9;
  let shown = 9;
  let currentFilter = 'all';

  const grid = document.getElementById('vp-grid')!;
  const loadMore = document.getElementById('vp-load-more')!;
  const loadWrap = document.getElementById('vp-load-wrap')!;
  const filterBtns = document.querySelectorAll('.vp-filter');

  function getCards() {
    return Array.from(grid.querySelectorAll<HTMLElement>('.vc'));
  }

  function applyFilter() {
    shown = BATCH;
    const cards = getCards();
    let visible = 0;
    cards.forEach(c => {
      const type = c.dataset.type!;
      const match = currentFilter === 'all' || type === currentFilter;
      c.style.display = match && visible < shown ? '' : 'none';
      if (match) visible++;
    });
    const total = cards.filter(c => currentFilter === 'all' || c.dataset.type === currentFilter).length;
    loadWrap.style.display = total > shown ? '' : 'none';
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = (btn as HTMLElement).dataset.filter!;
      applyFilter();
    });
  });

  loadMore.addEventListener('click', () => {
    const cards = getCards();
    const matching = cards.filter(c => currentFilter === 'all' || c.dataset.type === currentFilter);
    const next = matching.slice(shown, shown + BATCH);
    next.forEach(c => c.style.display = '');
    shown += BATCH;
    if (shown >= matching.length) loadWrap.style.display = 'none';
  });

  // Init
  applyFilter();
</script>

<style>
/* Hero */
.vp-hero { background: #fff; padding: 64px 40px 40px; border-bottom: 1px solid #f0f0f0; }
.vp-inner { max-width: 1260px; margin: 0 auto; }
.vp-title { font-family: var(--font-serif); font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 400; color: #242424; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 12px; text-align: center; }
.vp-sub { font-family: var(--font-outfit); font-size: 1rem; color: #666; line-height: 1.6; text-align: center; }

/* Grid section */
.vp-grid-section { background: #f9f9f7; padding: 40px 40px 80px; }

/* Filter tabs */
.vp-filters { display: flex; gap: 8px; margin-bottom: 32px; }
.vp-filter { font-family: var(--font-inter); font-size: 0.8rem; font-weight: 600; padding: 6px 18px; border-radius: 50px; border: 1px solid #ddd; background: #fff; color: #555; cursor: pointer; transition: all 0.15s; }
.vp-filter.active { background: #2F4F2F; color: #fff; border-color: #2F4F2F; }
.vp-filter:hover:not(.active) { border-color: #2F4F2F; color: #2F4F2F; }

/* Grid */
.vp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

/* Card */
.vc { border-radius: 10px; overflow: hidden; background: #fff; border: 1px solid #e8e8e8; transition: box-shadow 0.2s, transform 0.15s; display: flex; flex-direction: column; text-decoration: none; color: inherit; }
.vc:hover { box-shadow: 0 4px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
.vc-thumb { position: relative; aspect-ratio: 16/9; overflow: hidden; background: #1a1a1a; flex-shrink: 0; }
.vc-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
.vc:hover .vc-thumb img { transform: scale(1.04); }
.vc-play { position: absolute; bottom: 8px; left: 8px; opacity: 0; transition: opacity 0.2s; }
.vc:hover .vc-play { opacity: 1; }
.vc-badge { position: absolute; top: 8px; left: 8px; background: #5A3A1C; color: #fff; font-family: var(--font-inter); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.1em; padding: 3px 7px; border-radius: 3px; text-transform: uppercase; }
.vc-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 5px; }
.vc-title { font-family: var(--font-inter); font-size: 0.85rem; font-weight: 600; color: #242424; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.vc-author { font-family: var(--font-inter); font-size: 0.75rem; color: #888; }

/* Load more */
.vp-load-wrap { text-align: center; margin-top: 40px; }
.vp-load-more { font-family: var(--font-inter); font-size: 0.875rem; font-weight: 500; background: #5A3A1C; color: #fff; padding: 10px 32px; border-radius: 50px; border: none; cursor: pointer; transition: background 0.2s; }
.vp-load-more:hover { background: #947153; }

@media (max-width: 1024px) { .vp-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) {
  .vp-hero { padding: 40px 20px 28px; }
  .vp-grid-section { padding: 28px 20px 60px; }
  .vp-grid { grid-template-columns: 1fr; }
}
</style>
