---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import videos from '../../public/data/videos.json';

const youtubeVideos = videos.filter(v => v.youtubeId);
const otherVideos   = videos.filter(v => !v.youtubeId);
---

<BaseLayout title="Videos — Mycelium">
  <SiteNav />

  <main class="videos-page">
    <header class="vp-hero">
      <p class="vp-eyebrow">VIDEO LIBRARY</p>
      <h1 class="vp-title">Permaculture, Taught by Practitioners</h1>
      <p class="vp-sub">Free videos on soil, water, food forests, design, and regenerative living — from farmers and educators across the Philippines and the world.</p>
    </header>

    <section class="vp-grid-wrap">
      <div class="vp-grid">
        {videos.map(v => (
          <a
            class="vc"
            href={v.embedUrl || v.wpLink}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="vc-thumb">
              {v.youtubeId ? (
                <img
                  src={`https://img.youtube.com/vi/${v.youtubeId}/mqdefault.jpg`}
                  alt={v.title}
                  loading="lazy"
                  width="320"
                  height="180"
                  onerror={`this.src='${v.thumbnail}';this.onerror=null;`}
                />
              ) : v.thumbnail ? (
                <img src={v.thumbnail} alt={v.title} loading="lazy" width="320" height="180" />
              ) : (
                <div class="vc-thumb-placeholder">▶</div>
              )}
              <div class="vc-play">▶</div>
              {v.videoType === 'webinar' && <span class="vc-badge">WEBINAR</span>}
            </div>
            <div class="vc-body">
              <p class="vc-author">{v.author || 'Mycelium'}</p>
              <h3 class="vc-title">{v.title}</h3>
              {v.description && <p class="vc-desc">{v.description.substring(0, 120)}…</p>}
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .videos-page {
    background: #111209;
    min-height: 100vh;
    color: #E8E3DC;
    font-family: 'DM Sans', 'Inter', sans-serif;
  }

  /* Hero */
  .vp-hero {
    max-width: 760px;
    margin: 0 auto;
    padding: 72px 24px 48px;
    text-align: center;
  }
  .vp-eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: #7dae85;
    margin: 0 0 16px;
  }
  .vp-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    color: #F0EBE1;
    margin: 0 0 16px;
    line-height: 1.2;
  }
  .vp-sub {
    font-size: 1rem;
    color: #9E9A94;
    line-height: 1.65;
    margin: 0;
    max-width: 560px;
    margin: 0 auto;
  }

  /* Grid */
  .vp-grid-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }
  .vp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  /* Card */
  .vc {
    display: flex;
    flex-direction: column;
    background: #1a1a10;
    border: 1px solid rgba(125, 174, 133, 0.12);
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
    cursor: pointer;
  }
  .vc:hover {
    border-color: rgba(125, 174, 133, 0.35);
    transform: translateY(-2px);
  }

  .vc-thumb {
    position: relative;
    aspect-ratio: 16/9;
    background: #0f0f08;
    overflow: hidden;
    flex-shrink: 0;
  }
  .vc-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s;
  }
  .vc:hover .vc-thumb img { transform: scale(1.03); }

  .vc-thumb-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: rgba(255,255,255,0.15);
    background: #141410;
  }

  .vc-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    color: white;
    background: rgba(0,0,0,0.35);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .vc:hover .vc-play { opacity: 1; }

  .vc-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: #7dae85;
    color: #0f1a10;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 3px 8px;
    border-radius: 3px;
  }

  .vc-body {
    padding: 14px 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }
  .vc-author {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #7dae85;
    margin: 0;
    text-transform: uppercase;
  }
  .vc-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #F0EBE1;
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .vc-desc {
    font-size: 0.78rem;
    color: #7a766f;
    line-height: 1.55;
    margin: 4px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .vp-hero { padding: 48px 16px 32px; }
    .vp-grid-wrap { padding: 0 16px 48px; }
    .vp-grid { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
