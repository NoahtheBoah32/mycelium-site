---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
import videos from '../../public/data/videos.json';

const allReels = await getCollection('reels', r => !r.data.hidden);
const reels = allReels.sort((a, b) =>
  new Date(b.data.postedAt).getTime() - new Date(a.data.postedAt).getTime()
);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' });
}

const reelData = reels.map(r => ({
  videoUrl: r.data.r2VideoUrl,
  thumbUrl: r.data.r2ThumbUrl || '',
  caption: r.data.caption || '',
  date: formatDate(r.data.postedAt),
  permalink: r.data.permalink,
}));
---

<BaseLayout title="Videos - Mycelium">
  <SiteNav />

  <section class="vp-hero">
    <div class="vp-inner">
      <h1 class="vp-title" id="vp-hero-title">Learn Through Permaculture Videos</h1>
      <p class="vp-sub" id="vp-hero-sub">Explore practical tips, techniques, and inspiration for your permaculture journey</p>
    </div>
  </section>

  <section class="vp-grid-section">
    <div class="vp-inner">

      <!-- Search (videos only) -->
      <div class="vp-search-wrap" id="vp-search-wrap">
        <svg class="vp-search-icon" width="18" height="18" viewBox="0 0 18 18" fill="none">
          <circle cx="7.5" cy="7.5" r="5.5" stroke="#888" stroke-width="1.5"/>
          <line x1="11.5" y1="11.5" x2="16" y2="16" stroke="#888" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <input id="vp-search" class="vp-search" type="text" placeholder="Search videos, topics, creators..." autocomplete="off" />
      </div>

      <!-- Filter tabs -->
      <div class="vp-filters" id="vp-filters">
        <button class="vp-filter active" data-filter="all">All</button>
        <button class="vp-filter" data-filter="podcast">Podcast</button>
        <button class="vp-filter vp-filter-reels" data-filter="reels" id="reels-tab">Roots & Reels</button>
      </div>

      <!-- ─── VIDEO GRID ──────────────────────────────────── -->
      <div class="vp-grid" id="vp-grid">
        {videos.map((v, i) => {
          const isPodcast = v.title?.toLowerCase().includes('podcast') || v.tags?.some((t: string) => t.toLowerCase().includes('podcast'));
          const thumb = v.thumbnail || (v.youtubeId ? `https://img.youtube.com/vi/${v.youtubeId}/mqdefault.jpg` : null);
          const ytUrl = v.youtubeId ? `https://www.youtube.com/watch?v=${v.youtubeId}` : v.embedUrl;
          return (
            <div
              class="vc"
              data-type={isPodcast ? 'podcast' : 'all'}
              data-index={i}
              data-title={v.title?.toLowerCase()}
              data-author={(v.author || '').toLowerCase()}
              style={i >= 9 ? 'display:none' : ''}
            >
              <a href={`/video/${v.slug}`} class="vc-thumb-link">
                <div class="vc-thumb">
                  {thumb && <img src={thumb} alt={v.title} loading="lazy" />}
                  <div class="vc-play">
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
                      <circle cx="18" cy="18" r="18" fill="rgba(0,0,0,0.6)" />
                      <polygon points="14,11 28,18 14,25" fill="white" />
                    </svg>
                  </div>
                  {v.videoType === 'webinar' && <span class="vc-badge">WEBINAR</span>}
                </div>
              </a>
              <div class="vc-body">
                <h3 class="vc-title">{v.title}</h3>
                <p class="vc-author">By {v.author || 'Mycelium'}</p>
                <div class="vc-hover-actions">
                  <a href={`/video/${v.slug}`} class="vc-btn-outline">Learn More</a>
                  {ytUrl && <a href={ytUrl} target="_blank" rel="noopener" class="vc-btn-solid">Watch Now</a>}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <div class="vp-load-wrap" id="vp-load-wrap">
        <button class="vp-load-more" id="vp-load-more">Load More</button>
      </div>

      <!-- ─── REELS GRID ─────────────────────────────────── -->
      <div class="vr-grid" id="vr-grid">
        {reels.map((r, i) => (
          <button
            class="rc"
            data-index={String(i)}
            style={i >= 8 ? 'display:none' : ''}
            aria-label={r.data.caption || 'Play reel'}
          >
            <div class="rc-thumb">
              <video
                src={r.data.r2VideoUrl}
                poster={r.data.r2ThumbUrl || undefined}
                preload="metadata"
                muted
                playsinline
              />
              <div class="rc-play-overlay">
                <div class="rc-play-icon">
                  <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                    <circle cx="24" cy="24" r="24" fill="rgba(0,0,0,0.45)"/>
                    <polygon points="19,14 37,24 19,34" fill="white"/>
                  </svg>
                </div>
              </div>
            </div>
            <div class="rc-info">
              <p class="rc-title">{r.data.caption || 'Reel'}</p>
              <p class="rc-meta">Mycelium Learning · {formatDate(r.data.postedAt)}</p>
            </div>
          </button>
        ))}

        {reels.length === 0 && (
          <p class="vr-empty">No reels yet — check back soon.</p>
        )}
      </div>

      <div class="vp-load-wrap" id="vr-load-wrap" style="display:none">
        <button class="vp-load-more" id="vr-load-more">Load More</button>
      </div>

    </div>
  </section>

  <!-- ─── REEL MODAL ──────────────────────────────────────── -->
  <div class="reel-modal" id="reel-modal" role="dialog" aria-modal="true">

    <button class="reel-back" id="reel-back">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Reels
    </button>

    <div class="reel-layout">
      <button class="reel-arrow" id="reel-prev" aria-label="Previous reel">
        <svg viewBox="0 0 20 20" fill="none"><path d="M13 4L7 10l6 6" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>

      <div class="reel-player-wrap">
        <div class="reel-player">
          <video id="reel-video" playsinline preload="metadata" loop></video>

          <div class="reel-caption-overlay">
            <p class="reel-caption-text" id="reel-caption-text"></p>
            <p class="reel-caption-date" id="reel-caption-date"></p>
          </div>

          <button class="reel-play-btn" id="reel-play-btn" aria-label="Play / Pause">
            <svg id="reel-play-icon" width="26" height="26" viewBox="0 0 26 26">
              <polygon points="7,3 23,13 7,23" fill="white"/>
            </svg>
          </button>

          <div class="reel-progress">
            <div class="reel-progress-fill" id="reel-progress-fill"></div>
          </div>
        </div>

        <div class="reel-actions">
          <a id="reel-ig-link" href="#" target="_blank" rel="noopener" class="reel-action-btn" title="View on Instagram">
            <div class="reel-action-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
              </svg>
            </div>
            <span>Instagram</span>
          </a>
          <button class="reel-action-btn" id="reel-share-btn" title="Share">
            <div class="reel-action-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span>Share</span>
          </button>
        </div>
      </div>

      <button class="reel-arrow" id="reel-next" aria-label="Next reel">
        <svg viewBox="0 0 20 20" fill="none"><path d="M7 4l6 6-6 6" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>

  </div>

  <SiteFooter />
</BaseLayout>

<script define:vars={{ reelData }}>
  // ─── video filter logic ──────────────────────────────────
  const BATCH = 9;
  let shown = 9;
  let currentFilter = 'all';
  let searchQuery = '';
  let reelMode = false;

  const vpGrid    = document.getElementById('vp-grid');
  const vrGrid    = document.getElementById('vr-grid');
  const loadWrap  = document.getElementById('vp-load-wrap');
  const loadMore  = document.getElementById('vp-load-more');
  const vrLoadWrap= document.getElementById('vr-load-wrap');
  const vrLoadMore= document.getElementById('vr-load-more');
  const filterBtns= document.querySelectorAll('.vp-filter');
  const searchWrap= document.getElementById('vp-search-wrap');
  const searchInput=document.getElementById('vp-search');
  const heroTitle = document.getElementById('vp-hero-title');
  const heroSub   = document.getElementById('vp-hero-sub');

  function getVideoCards() {
    return Array.from(vpGrid.querySelectorAll('.vc'));
  }

  function cardMatches(c) {
    const type = c.dataset.type;
    const filterMatch = currentFilter === 'all' || type === currentFilter;
    if (!filterMatch) return false;
    if (!searchQuery) return true;
    return (c.dataset.title || '').includes(searchQuery) || (c.dataset.author || '').includes(searchQuery);
  }

  function applyVideoFilter() {
    shown = BATCH;
    const cards = getVideoCards();
    let visible = 0;
    cards.forEach(c => {
      const match = cardMatches(c);
      c.style.display = match && visible < shown ? '' : 'none';
      if (match) visible++;
    });
    const total = cards.filter(c => cardMatches(c)).length;
    loadWrap.style.display = total > shown ? '' : 'none';
  }

  function switchToReels() {
    reelMode = true;
    vpGrid.style.display = 'none';
    loadWrap.style.display = 'none';
    searchWrap.style.display = 'none';
    vrGrid.classList.add('visible');
    heroTitle.textContent = 'Roots & Reels';
    heroSub.textContent = 'Short permaculture ideas, field visits, and quick tips';
    // show load more if needed
    const rcCards = Array.from(vrGrid.querySelectorAll('.rc'));
    vrLoadWrap.style.display = rcCards.length > 8 ? '' : 'none';
  }

  function switchToVideos(filter) {
    reelMode = false;
    vrGrid.classList.remove('visible');
    vrLoadWrap.style.display = 'none';
    vpGrid.style.display = '';
    searchWrap.style.display = '';
    heroTitle.textContent = 'Learn Through Permaculture Videos';
    heroSub.textContent = 'Explore practical tips, techniques, and inspiration for your permaculture journey';
    currentFilter = filter;
    applyVideoFilter();
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const f = btn.dataset.filter;
      if (f === 'reels') {
        switchToReels();
      } else {
        switchToVideos(f);
      }
    });
  });

  searchInput.addEventListener('input', () => {
    searchQuery = searchInput.value.trim().toLowerCase();
    applyVideoFilter();
  });

  loadMore.addEventListener('click', () => {
    const cards = getVideoCards();
    const matching = cards.filter(c => cardMatches(c));
    matching.slice(shown, shown + BATCH).forEach(c => c.style.display = '');
    shown += BATCH;
    if (shown >= matching.length) loadWrap.style.display = 'none';
  });

  // reels load more
  let reelShown = 8;
  vrLoadMore?.addEventListener('click', () => {
    const cards = Array.from(vrGrid.querySelectorAll('.rc'));
    cards.slice(reelShown, reelShown + 8).forEach(c => c.style.display = '');
    reelShown += 8;
    if (reelShown >= cards.length) vrLoadWrap.style.display = 'none';
  });

  applyVideoFilter();

  // ─── reel modal ──────────────────────────────────────────
  let current = 0;
  const modal    = document.getElementById('reel-modal');
  const video    = document.getElementById('reel-video');
  const playBtn  = document.getElementById('reel-play-btn');
  const playIcon = document.getElementById('reel-play-icon');
  const progFill = document.getElementById('reel-progress-fill');
  const capText  = document.getElementById('reel-caption-text');
  const capDate  = document.getElementById('reel-caption-date');
  const igLink   = document.getElementById('reel-ig-link');

  vrGrid.addEventListener('click', e => {
    const card = e.target.closest('.rc');
    if (!card) return;
    openReel(parseInt(card.dataset.index, 10));
  });

  function openReel(index) {
    current = index;
    loadReel();
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeReel() {
    video.pause();
    video.src = '';
    modal.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.getElementById('reel-back').addEventListener('click', closeReel);
  modal.addEventListener('click', e => { if (e.target === modal) closeReel(); });

  function loadReel() {
    const r = reelData[current];
    video.src = r.videoUrl;
    video.load();
    video.play().catch(() => {});
    capText.textContent = r.caption;
    capDate.textContent = r.date;
    igLink.href = r.permalink || '#';
    progFill.style.width = '0%';
    setPlayIcon(true);
  }

  playBtn.addEventListener('click', () => {
    if (video.paused) { video.play(); setPlayIcon(true); }
    else              { video.pause(); setPlayIcon(false); }
  });
  video.addEventListener('click', () => playBtn.click());

  function setPlayIcon(playing) {
    playIcon.innerHTML = playing
      ? '<rect x="5" y="3" width="5" height="18" rx="1.5" fill="white"/><rect x="14" y="3" width="5" height="18" rx="1.5" fill="white"/>'
      : '<polygon points="7,3 23,13 7,23" fill="white"/>';
  }

  video.addEventListener('timeupdate', () => {
    if (!video.duration) return;
    progFill.style.width = (video.currentTime / video.duration * 100) + '%';
  });

  function navigate(dir) {
    current = (current + dir + reelData.length) % reelData.length;
    loadReel();
  }

  document.getElementById('reel-prev').addEventListener('click', () => navigate(-1));
  document.getElementById('reel-next').addEventListener('click', () => navigate(1));

  document.addEventListener('keydown', e => {
    if (!modal.classList.contains('open')) return;
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') navigate(1);
    if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')   navigate(-1);
    if (e.key === 'Escape') closeReel();
    if (e.key === ' ') { e.preventDefault(); playBtn.click(); }
  });

  document.getElementById('reel-share-btn').addEventListener('click', () => {
    const r = reelData[current];
    if (navigator.share) navigator.share({ url: r.permalink });
    else navigator.clipboard?.writeText(r.permalink);
  });

  // activate reels tab if URL hash is #reels
  if (window.location.hash === '#reels') {
    const reelsTab = document.getElementById('reels-tab');
    filterBtns.forEach(b => b.classList.remove('active'));
    reelsTab.classList.add('active');
    switchToReels();
  }
</script>

<style>
/* ─── hero ────────────────────────────────────────────── */
.vp-hero { background: #F7F7F5; padding: 80px 40px 64px; }
.vp-inner { max-width: 1180px; margin: 0 auto; }
.vp-title { font-family: var(--font-outfit); font-size: clamp(2.2rem, 4vw, 3.75rem); font-weight: 700; color: #242424; letter-spacing: -0.01em; line-height: 1.2; margin-bottom: 16px; text-align: center; }
.vp-sub { font-family: var(--font-outfit); font-size: 1.5rem; color: #666; line-height: 1.5; text-align: center; }

/* ─── grid section ────────────────────────────────────── */
.vp-grid-section { background: #f9f9f7; padding: 40px 40px 80px; }

/* search */
.vp-search-wrap { position: relative; margin-bottom: 20px; }
.vp-search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); pointer-events: none; }
.vp-search { width: 100%; box-sizing: border-box; font-family: var(--font-outfit); font-size: 0.95rem; color: #333; padding: 11px 16px 11px 42px; border: 1px solid #ddd; border-radius: 8px; background: #fff; outline: none; transition: border-color 0.15s; }
.vp-search:focus { border-color: #2F4F2F; }
.vp-search::placeholder { color: #aaa; }

/* filter tabs */
.vp-filters { display: flex; gap: 8px; margin-bottom: 32px; justify-content: center; }
.vp-filter { font-family: var(--font-inter); font-size: 0.8rem; font-weight: 600; padding: 6px 18px; border-radius: 50px; border: 1px solid #ddd; background: #fff; color: #555; cursor: pointer; transition: all 0.15s; }
.vp-filter.active { background: #2F4F2F; color: #fff; border-color: #2F4F2F; }
.vp-filter:hover:not(.active) { border-color: #2F4F2F; color: #2F4F2F; }
.vp-filter-reels { border-color: rgba(47,79,47,0.35); color: #2F4F2F; }

/* ─── video grid ──────────────────────────────────────── */
.vp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
.vc { border-radius: 10px; overflow: hidden; background: #fff; border: 1px solid #e8e8e8; transition: box-shadow 0.2s, transform 0.15s; display: flex; flex-direction: column; cursor: pointer; }
.vc:hover { box-shadow: 0 4px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
.vc-thumb-link { display: block; text-decoration: none; flex-shrink: 0; }
.vc-thumb { position: relative; aspect-ratio: 16/9; overflow: hidden; background: #1a1a1a; }
.vc-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
.vc:hover .vc-thumb img { transform: scale(1.04); }
.vc-play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
.vc-badge { position: absolute; top: 8px; left: 8px; background: #5A3A1C; color: #fff; font-family: var(--font-inter); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.1em; padding: 3px 7px; border-radius: 3px; text-transform: uppercase; }
.vc-body { padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 5px; }
.vc-title { font-family: var(--font-inter); font-size: 0.85rem; font-weight: 600; color: #242424; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.vc-author { font-family: var(--font-inter); font-size: 0.75rem; color: #888; }
.vc-hover-actions { display: flex; gap: 8px; margin-top: 10px; opacity: 0; transform: translateY(4px); transition: opacity 0.2s, transform 0.2s; }
.vc:hover .vc-hover-actions { opacity: 1; transform: translateY(0); }
.vc-btn-outline { flex: 1; font-family: var(--font-inter); font-size: 0.82rem; font-weight: 500; padding: 8px 10px; border: 0.8px solid #242424; border-radius: 6px; background: transparent; color: #242424; text-decoration: none; text-align: center; transition: background 0.15s, color 0.15s; }
.vc-btn-outline:hover { background: #242424; color: #fff; }
.vc-btn-solid { flex: 1; font-family: var(--font-inter); font-size: 0.82rem; font-weight: 500; padding: 8px 10px; border-radius: 6px; background: #2F4F2F; color: #fff; text-decoration: none; text-align: center; border: 1px solid #2F4F2F; transition: background 0.15s; }
.vc-btn-solid:hover { background: #3d6b3d; }

/* load more */
.vp-load-wrap { text-align: center; margin-top: 40px; }
.vp-load-more { font-family: var(--font-inter); font-size: 0.875rem; font-weight: 500; background: #5A3A1C; color: #fff; padding: 10px 32px; border-radius: 50px; border: none; cursor: pointer; transition: background 0.2s; }
.vp-load-more:hover { background: #947153; }

/* ─── reels grid ──────────────────────────────────────── */
.vr-grid { display: none; grid-template-columns: repeat(4, 1fr); gap: 12px; }
.vr-grid.visible { display: grid; }
.vr-empty { font-family: var(--font-inter); font-size: 1rem; color: #888; text-align: center; padding: 80px 0; grid-column: 1/-1; }

.rc { display: flex; flex-direction: column; border-radius: 10px; overflow: hidden; background: #fff; border: 1px solid #e8e8e8; cursor: pointer; text-align: left; padding: 0; transition: box-shadow 0.2s, transform 0.15s; }
.rc:hover { box-shadow: 0 4px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
.rc-thumb { position: relative; aspect-ratio: 9/16; overflow: hidden; background: #1a1a1a; flex-shrink: 0; }
.rc-thumb img, .rc-thumb video { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; pointer-events: none; }
.rc:hover .rc-thumb img, .rc:hover .rc-thumb video { transform: scale(1.04); }
.rc-thumb-placeholder { width: 100%; height: 100%; background: linear-gradient(135deg, #2F4F2F 0%, #1a2e1a 100%); }
.rc-play-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(0,0,0,0); transition: background 0.2s; }
.rc:hover .rc-play-overlay { background: rgba(0,0,0,0.22); }
.rc-play-icon { opacity: 0; transform: scale(0.8); transition: opacity 0.2s, transform 0.2s; }
.rc:hover .rc-play-icon { opacity: 1; transform: scale(1); }
.rc-info { padding: 14px 14px 16px; display: flex; flex-direction: column; gap: 5px; }
.rc-title { font-family: var(--font-inter); font-size: 0.83rem; font-weight: 600; color: #242424; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.rc-meta { font-family: var(--font-inter); font-size: 0.73rem; color: #888; }

/* ─── reel modal ──────────────────────────────────────── */
.reel-modal { display: none; position: fixed; inset: 0; z-index: 99999; background: rgba(5,5,3,0.96); align-items: center; justify-content: center; }
.reel-modal.open { display: flex; }
.reel-back { position: fixed; top: 20px; left: 24px; display: flex; align-items: center; gap: 8px; font-family: var(--font-inter); font-size: 0.82rem; font-weight: 600; color: rgba(255,255,255,0.65); background: rgba(255,255,255,0.08); border: none; border-radius: 50px; padding: 8px 16px; cursor: pointer; transition: color 0.15s, background 0.15s; z-index: 1; }
.reel-back:hover { color: #fff; background: rgba(255,255,255,0.14); }
.reel-layout { display: flex; align-items: center; gap: 16px; }
.reel-arrow { width: 44px; height: 44px; border-radius: 50%; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15); display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; transition: background 0.15s; }
.reel-arrow:hover { background: rgba(255,255,255,0.2); }
.reel-arrow svg { width: 20px; height: 20px; }
.reel-player-wrap { display: flex; align-items: center; }
.reel-player { width: 360px; height: 640px; border-radius: 16px; overflow: hidden; position: relative; background: #000; box-shadow: 0 20px 80px rgba(0,0,0,0.7); flex-shrink: 0; }
