---
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { baganihanEssays } from '../../../data/baganihan-essays.js';

export function getStaticPaths() {
  return baganihanEssays.map((p) => ({ params: { slug: p.slug }, props: { piece: p } }));
}

const { piece } = Astro.props;
---

<ArticleLayout route={`resources/baganihan-reports/${Astro.params.slug}`}>


  <article class="psp">
    <div class="psp-topbar">
      <a href="/resources" class="psp-back">&larr; Back to Resources</a>
      <div class="psp-brand">
        <img src="/images/baganihan-logo.jpg" alt="Baganihan Collective" />
        <span>Baganihan Reports</span>
      </div>
    </div>

    <header class="psp-header">
      <span class="psp-eyebrow">The Baganihan Collective &middot; {piece.seriesLabel}</span>
      <h1 class="psp-title">{piece.title}</h1>
      <p class="psp-sub">{piece.subtitle}</p>
      <div class="psp-byline">
        <div>
          <span class="psp-author">{piece.author}</span>
          <span class="psp-role">{piece.authorRole}</span>
        </div>
        <span class="psp-date">{piece.date}</span>
      </div>
    </header>

    <figure class="psp-hero">
      <img src={piece.hero} alt="" />
      <figcaption>{piece.heroCaption}</figcaption>
    </figure>

    <div class="psp-body">
      {piece.blocks.map((b) => (
        <>
          {b.t === 'lead' && (
            <div class="blk-lead">
              {b.label && <span class="blk-eyebrow">{b.label}</span>}
              <p>{b.text}</p>
            </div>
          )}

          {b.t === 'prose' && (
            <section class="blk">
              {b.label && <h2 class="blk-h">{b.label}</h2>}
              {b.paras.map((p) => <p class="blk-p">{p}</p>)}
            </section>
          )}

          {b.t === 'numbered' && (
            <section class="blk">
              <h2 class="blk-h">{b.label}</h2>
              <ol class="num-list">
                {b.items.map((it) => (
                  <li class="num-item">
                    <h3 class="num-title">{it.title}</h3>
                    <p class="num-text">{it.text}</p>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {b.t === 'pullquote' && (
            <blockquote class="blk-pull">{b.text}</blockquote>
          )}

          {b.t === 'image' && (
            <figure class="blk-fig">
              <img src={b.src} alt="" loading="lazy" />
              <figcaption>
                {b.caption}
                {b.credit && <span class="blk-credit">{b.credit}</span>}
              </figcaption>
            </figure>
          )}

          {b.t === 'callout' && (
            <section class="blk-callout">
              <span class="blk-eyebrow">{b.label}</span>
              <p>{b.text}</p>
            </section>
          )}
        </>
      ))}

      <div class="psp-tags">
        {piece.tags.map((t) => <span class="psp-tag">{t}</span>)}
      </div>
    </div>

    <!-- Placed after the piece, not in front of it. Framing, not a verdict. -->
    <aside class="psp-closing">
      <h2 class="psp-closing-h">{piece.closing.label}</h2>
      {piece.closing.paras.map((p) => <p class="psp-closing-p">{p}</p>)}
      <a class="psp-cg" href="/common-ground">Take it to Common Ground &rarr;</a>
    </aside>
  </article>


</ArticleLayout>
