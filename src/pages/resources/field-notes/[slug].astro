---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteNav from '../../../components/SiteNav.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { baganihanFieldNotes } from '../../../data/baganihan-field-notes.js';

export function getStaticPaths() {
  return baganihanFieldNotes.map((p) => ({ params: { slug: p.slug }, props: { piece: p } }));
}

const { piece } = Astro.props;

const lvlLabel = {
  supported: 'Well supported',
  partly: 'Partly supported',
  opinion: "Author's reading",
};
---

<BaseLayout title={`${piece.title} — Baganihan Field Notes`}>
  <SiteNav />

  <article class="psp">
    <div class="psp-topbar">
      <a href="/resources" class="psp-back">&larr; Back to Resources</a>
      <div class="psp-brand">
        <img src="/images/baganihan-logo.jpg" alt="Baganihan Collective" />
        <span>Baganihan Field Notes</span>
      </div>
    </div>

    <header class="psp-header">
      <span class="psp-eyebrow">Field Notes &middot; {piece.seriesLabel}</span>
      <h1 class="psp-title">{piece.title}</h1>
      <p class="psp-sub">{piece.subtitle}</p>
      <div class="psp-byline">
        <div>
          <span class="psp-author">{piece.author}</span>
          <span class="psp-role">{piece.authorRole}</span>
        </div>
        <span class="psp-date">{piece.date}</span>
      </div>
    </header>

    <figure class="psp-hero">
      <img src={piece.hero} alt="" />
      <figcaption>{piece.heroCaption}</figcaption>
    </figure>

    <div class="psp-body">
      {piece.blocks.map((b) => (
        <>
          {b.t === 'lead' && (
            <div class="blk-lead">
              {b.label && <span class="blk-eyebrow">{b.label}</span>}
              <p>{b.text}</p>
            </div>
          )}

          {b.t === 'prose' && (
            <section class="blk">
              {b.label && <h2 class="blk-h">{b.label}</h2>}
              {b.paras.map((p) => <p class="blk-p">{p}</p>)}
            </section>
          )}

          {b.t === 'numbered' && (
            <section class="blk">
              <h2 class="blk-h">{b.label}</h2>
              <ol class="num-list">
                {b.items.map((it) => (
                  <li class="num-item">
                    <h3 class="num-title">{it.title}</h3>
                    <p class="num-text">{it.text}</p>
                  </li>
                ))}
              </ol>
            </section>
          )}

          {b.t === 'pullquote' && (
            <blockquote class="blk-pull">{b.text}</blockquote>
          )}

          {b.t === 'image' && (
            <figure class="blk-fig">
              <img src={b.src} alt="" loading="lazy" />
              <figcaption>
                {b.caption}
                {b.credit && <span class="blk-credit">{b.credit}</span>}
              </figcaption>
            </figure>
          )}

          {b.t === 'callout' && (
            <section class="blk-callout">
              <span class="blk-eyebrow">{b.label}</span>
              <p>{b.text}</p>
            </section>
          )}
        </>
      ))}

      <div class="psp-tags">
        {piece.tags.map((t) => <span class="psp-tag">{t}</span>)}
      </div>
    </div>

    <!-- Mycelium's own assessment, after the argument rather than in front of it. -->
    <aside class="psp-closing">
      <h2 class="psp-closing-h">{piece.closing.label}</h2>
      {piece.closing.paras.map((p) => <p class="psp-closing-p">{p}</p>)}

      <div class="ev-wrap">
        <p class="ev-intro">{piece.closing.evidenceIntro}</p>
        <div class="ev-list">
          {piece.closing.evidence.map((it) => (
            <div class={`ev-row ev-${it.lvl}`}>
              <span class="ev-flag">{lvlLabel[it.lvl]}</span>
              <div class="ev-copy">
                <h3 class="ev-title">{it.title}</h3>
                <p class="ev-text">{it.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <p class="psp-closing-foot">
        Disagree with any of this? That is rather the point. Take it to the floor at
        <a href="/common-ground">Common Ground</a>.
      </p>
    </aside>
  </article>

  <SiteFooter />
</BaseLayout>

<style>
  .psp {
    max-width: 780px;
    margin: 0 auto;
    padding: 36px 24px 72px;
    font-family: var(--font-inter);
    color: #2b2b28;
  }

  /* topbar */
  .psp-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid #e6e2d8;
    flex-wrap: wrap;
  }
  .psp-back {
    font-size: 0.875rem;
    font-weight: 500;
    color: #5a3a1c;
    text-decoration: none;
  }
  .psp-back:hover { color: #c8a01a; }
  .psp-brand { display: flex; align-items: center; gap: 10px; }
  .psp-brand img { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; }
  .psp-brand span {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a8477;
  }

  /* header */
  .psp-header { padding: 40px 0 28px; }
  .psp-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a8762a;
    margin-bottom: 18px;
  }
  .psp-title {
    font-family: var(--font-playfair, Georgia, serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #1d1c17;
    text-wrap: balance;
    margin-bottom: 18px;
  }
  .psp-sub {
    font-size: 1.125rem;
    line-height: 1.6;
    color: #5f5b51;
    text-wrap: pretty;
    margin-bottom: 26px;
  }
  .psp-byline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 20px;
    border-top: 1px solid #e6e2d8;
  }
  .psp-author { display: block; font-size: 0.95rem; font-weight: 600; color: #2b2b28; }
  .psp-role { display: block; font-size: 0.85rem; color: #8a8477; margin-top: 3px; text-wrap: pretty; }
  .psp-date { font-size: 0.85rem; color: #8a8477; white-space: nowrap; }

  /* hero */
  .psp-hero { margin: 8px 0 44px; }
  .psp-hero img { width: 100%; border-radius: 12px; display: block; }
  .psp-hero figcaption {
    font-size: 0.85rem;
    color: #8a8477;
    line-height: 1.55;
    margin-top: 12px;
    text-wrap: pretty;
  }

  /* body blocks */
  .blk { margin-bottom: 42px; }
  .blk-h {
    font-family: var(--font-playfair, Georgia, serif);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
    color: #1d1c17;
    text-wrap: balance;
    margin-bottom: 16px;
  }
  .blk-p {
    font-size: 1.0625rem;
    line-height: 1.78;
    color: #3a3833;
    text-wrap: pretty;
    margin-bottom: 18px;
  }
  .blk-p:last-child { margin-bottom: 0; }

  .blk-lead {
    padding: 0 0 36px;
    margin-bottom: 36px;
    border-bottom: 1px solid #e6e2d8;
  }
  .blk-eyebrow {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a8762a;
    margin-bottom: 12px;
  }
  .blk-lead p {
    font-size: 1.2rem;
    line-height: 1.7;
    color: #2b2b28;
    text-wrap: pretty;
  }

  /* numbered vulnerabilities */
  .num-list { list-style: none; counter-reset: num; display: flex; flex-direction: column; gap: 26px; }
  .num-item { counter-increment: num; padding-left: 52px; position: relative; }
  .num-item::before {
    content: counter(num);
    position: absolute;
    left: 0;
    top: 1px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #1d1c17;
    color: #e8c766;
    font-size: 0.95rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    font-variant-numeric: tabular-nums;
  }
  .num-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1d1c17;
    text-wrap: balance;
    margin-bottom: 8px;
  }
  .num-text { font-size: 1.0625rem; line-height: 1.75; color: #3a3833; text-wrap: pretty; }

  .blk-pull {
    font-family: var(--font-playfair, Georgia, serif);
    font-size: 1.5rem;
    font-style: italic;
    line-height: 1.45;
    color: #5a3a1c;
    border-left: 4px solid #c8a01a;
    padding: 6px 0 6px 26px;
    margin: 0 0 42px;
    text-wrap: balance;
  }

  .blk-fig { margin-bottom: 42px; }
  .blk-fig img {
    width: 100%;
    border-radius: 12px;
    display: block;
    background: #fff;
    border: 1px solid #e6e2d8;
  }
  .blk-fig figcaption {
    font-size: 0.875rem;
    line-height: 1.6;
    color: #6e6a60;
    margin-top: 12px;
    text-wrap: pretty;
  }
  .blk-credit { display: block; font-style: italic; color: #9a958a; margin-top: 5px; }

  .blk-callout {
    background: #1d1c17;
    border-radius: 12px;
    padding: 24px 26px;
    margin-bottom: 36px;
  }
  .blk-callout .blk-eyebrow { color: #e8c766; }
  .blk-callout p { font-size: 1rem; line-height: 1.68; color: #d8d4c8; text-wrap: pretty; }

  .psp-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .psp-tag {
    font-size: 0.78rem;
    font-weight: 500;
    color: #6e6a60;
    background: #f1efe8;
    border-radius: 50px;
    padding: 6px 14px;
  }

  /* closing note — quieter than the essay, clearly a different voice */
  .psp-closing {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 2px solid #e6e2d8;
  }
  .psp-closing-h {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8a8477;
    margin-bottom: 16px;
  }
  .psp-closing-p {
    font-size: 0.97rem;
    line-height: 1.72;
    color: #5f5b51;
    text-wrap: pretty;
    margin-bottom: 14px;
  }

  .ev-wrap {
    background: #faf9f5;
    border: 1px solid #e6e2d8;
    border-radius: 12px;
    padding: 24px 26px;
    margin-top: 24px;
  }
  .ev-intro {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #8a8477;
    margin-bottom: 20px;
  }
  .ev-list { display: flex; flex-direction: column; gap: 20px; }
  .ev-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 18px;
    align-items: start;
    padding-top: 20px;
    border-top: 1px solid #e6e2d8;
  }
  .ev-row:first-child { padding-top: 0; border-top: none; }
  .ev-flag {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 50px;
    text-align: center;
    white-space: nowrap;
  }
  .ev-supported .ev-flag { background: #e3f0dd; color: #3c6b2c; }
  .ev-partly .ev-flag { background: #fdf0d8; color: #8a6a12; }
  .ev-opinion .ev-flag { background: #f3e2de; color: #8d4030; }
  .ev-title { font-size: 1rem; font-weight: 700; color: #1d1c17; margin-bottom: 6px; text-wrap: balance; }
  .ev-text { font-size: 0.97rem; line-height: 1.68; color: #4a4840; text-wrap: pretty; }

  .psp-closing-foot {
    font-size: 0.9rem;
    line-height: 1.7;
    color: #8a8477;
    margin-top: 24px;
    text-wrap: pretty;
  }
  .psp-closing-foot a { color: #a8762a; font-weight: 600; }
  .psp-closing-foot a:hover { color: #c8a01a; }

  @media (max-width: 600px) {
    .psp { padding: 24px 18px 56px; }
    .ev-row { grid-template-columns: 1fr; gap: 10px; }
    .ev-flag { justify-self: start; }
    .num-item { padding-left: 44px; }
  }
</style>
