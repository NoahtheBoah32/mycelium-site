---
const {
  title = "Mycelium — Free Permaculture Education",
  description = "Connecting scattered permaculture knowledge into clear learning pathways. Free, verified, and built for beginners ready to grow.",
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="theme-color" content="#43330B">
  <link rel="icon" href="https://mycelium-learn.com/wp-content/uploads/2025/09/mycelium-favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <title>{title}</title>
</head>
<body>
  <slot />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; font-size: 16px; }
    body {
      -webkit-font-smoothing: antialiased;
      font-family: 'Lora', serif;
      background: #ffffff;
      color: #242424;
    }
    a { text-decoration: none; color: inherit; }
    img { max-width: 100%; height: auto; display: block; }

    /* Global design tokens matching WP kit */
    :root {
      --color-primary: #2F4F2F;
      --color-accent: #61CE70;
      --color-brown: #5A3A1C;
      --color-brown-hover: #947153;
      --color-hero-bg: #43330B;
      --color-stats-bg: #2B2F31;
      --color-dark-section: #2F2A1F;
      --color-light-section: #F7F7F5;
      --color-text-cream: #D2CEC8;
      --color-text-muted: #D2CEC8;
      --color-white: #FFFFFF;
      --color-text-dark: #242424;
      --color-subheading: #666666;
      --font-serif: 'Cormorant Garamond', serif;
      --font-lora: 'Lora', serif;
      --font-outfit: 'Outfit', sans-serif;
      --font-inter: 'Inter', sans-serif;
      --max-width: 1260px;
    }

    /* Scroll reveal */
    .scroll-reveal {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity 0.65s ease, transform 0.65s ease;
    }
    .scroll-reveal.in-view {
      opacity: 1;
      transform: none;
    }
    .scroll-reveal-delay-1 { transition-delay: 0.1s; }
    .scroll-reveal-delay-2 { transition-delay: 0.2s; }
    .scroll-reveal-delay-3 { transition-delay: 0.3s; }
  </style>

  <script>
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -48px 0px' });

    function initReveal() {
      const vh = window.innerHeight;
      // Auto-reveal all sections and major card containers that start below the fold
      const targets = document.querySelectorAll(
        'section, .operate-col, .hvc, .hcc, .hrc, .vc, .stat-item, .founder-inner'
      );
      targets.forEach((el, i) => {
        const rect = el.getBoundingClientRect();
        if (rect.top > vh * 0.85) {
          el.classList.add('scroll-reveal');
          io.observe(el);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initReveal);
    } else {
      initReveal();
    }
  </script>
</body>
</html>
